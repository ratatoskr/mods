// Unity's main thread, where its engine calls work, for plugins in any language. Depend on `unity`
// and get the `unity` service. Engine calls come from the `managed` area's `icall`, or `[Icall]` in
// your own schemas.

error UnityError { Failed = 1 }

// On Unity's main thread, once a frame.
fn void!UnityError UnityFrame();

trait UnitySubscription {
    // No more calls, from the next frame. Fine to call twice.
    void cancel();
}

[Service] trait Unity {
    // Calls `handler` on Unity's main thread once a frame, as the main camera's about to render,
    // before Camera Tools moves it. Till it's cancelled or its plugin goes. Nothing's called till
    // the game's C# is running.
    UnitySubscription onFrame(keep UnityFrame handler);
    // The main camera, a `UnityEngine.Camera` object, or 0 if there's none. Main thread only.
    usize mainCamera();
    // Like Unity's `FindObjectsOfType`, every component of `class_name`, like `UnityEngine.Light`
    // or one of the game's own. Finding them means Unity looks through everything it has, so each
    // type's answer is kept for about a second and asked again on Unity's main thread while anyone's
    // asking. What's been destroyed since is left out. The first ask for a type starts it, so it may
    // come back empty. Any thread.
    []UnityObject findObjectsOfType(string class_name);
}

struct UnityObject {
    // The component's C# object, for Unity's engine calls and the game's runtime, on Unity's main
    // thread. On a later frame, check it's still there first: its `m_CachedPtr` field is `native`
    // till Unity destroys it.
    usize object;
    // Unity's own object for it, which stays the same while it's around
    usize native;
    // Its Transform's, the same way
    usize transform;
    usize transform_native;
    // Its GameObject's
    string name;
    // Where it was when Unity was last asked
    Vec3 position;
}