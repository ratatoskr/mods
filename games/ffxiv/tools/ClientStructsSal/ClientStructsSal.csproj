<Project Sdk="Microsoft.NET.Sdk">
  <!-- Writes .sal schemas from FFXIVClientStructs. `zig build client-structs` runs it, with
       ClientStructsDir set to the zon dependency's folder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Zig gives it from where dotnet started, which isn't where this file is -->
    <ClientStructsRoot>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine($(MSBuildStartupDirectory), $(ClientStructsDir)))))</ClientStructsRoot>
  </PropertyGroup>
  <ItemGroup>
    <!-- It builds into its own folder otherwise, which is inside the dependency -->
    <ProjectReference Include="$(ClientStructsRoot)/FFXIVClientStructs/FFXIVClientStructs.csproj" AdditionalProperties="OutputPath=$(OutputPath)" />
  </ItemGroup>
</Project>
