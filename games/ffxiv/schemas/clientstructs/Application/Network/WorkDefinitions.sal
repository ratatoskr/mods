// Made from FFXIVClientStructs by tools/ClientStructsSal. Change that and run `zig build client-structs`,
// since this is written again.

namespace Application.Network.WorkDefinitions;

[Size(0x8)]
struct Base {
}

[Size(0x10)]
struct BeastReputationWork : Base {
    [0x8] u8 rank;
    [0xA] u16 value;
}

[Size(0x140)]
struct ClientSelectData : Base {
    [0x8] utf8[32] display_name;
    [0x28] u8 current_class;
    [0x2A] u16[33] class_lv;
    [0x6C] u8 race;
    [0x6D] u8 tribe;
    [0x6E] u8 sex;
    [0x6F] u8 birth_month;
    [0x70] u8 birthday;
    [0x71] u8 guardian_deity;
    [0x72] u8 first_class;
    [0x74] u16 zone_id;
    [0x76] u16 territory_type;
    [0x78] u16 content_finder_condition;
    [0x7A] Client.Game.Character.CustomizeData customize_data;
    [0xB8] u64 model_main_weapon;
    [0xC0] u64 model_sub_weapon;
    [0xC8] u32[10] model_equip;
    [0xF0] u8[10] equip_stain1;
    [0xFA] u16[2] glasses;
    [0x100] u32 additional_time_end_remake;
    [0x104] u32 remake_flag;
    [0x108] ClientSelectDataConfigFlags config_flags;
    [0x10A] u8 voice_id;
    [0x10B] bool is_new_game;
    [0x10C] utf8[32] world_name;
    [0x130] u64 login_status;
    [0x138] bool is_out_territory;
}

bitfield ClientSelectDataConfigFlags : u16 {
    [Bit(0)] bool hide_head;
    [Bit(1)] bool hide_weapon;
    [Bit(2)] bool hide_legacy_mark;
    [Bit(4)] bool store_new_items_in_armoury_chest;
    [Bit(5)] bool store_crafted_items_in_inventory;
    [Bit(6)] bool close_visor;
    [Bit(7)] bool hide_viera_ears;
    // none is none of them
}

[Size(0x10)]
struct DailyQuestWork : Base {
    [0x8] u16 quest_id;
    [0xA] u8 flags { [Bit(0)] bool is_completed; }
}

[Size(0x18)]
struct LeveWork : Base {
    [0x8] u16 leve_id;
    [0xA] u8 sequence;
    [0xC] u16 flags { [Bit(14)] bool is_hidden; [Bit(15)] bool is_priority; }
    [0xE] u16 leve_seed;
    [0x10] u8 clear_class;
}

[Size(0x18)]
struct QuestWork : Base {
    [0x8] u16 quest_id;
    [0xA] u8 sequence;
    [0xB] u8 flags { [Bit(0)] bool is_priority; [Bit(1)] u8 reward_item_array_index : 2; [Bit(3)] bool is_hidden; }
    [0xC] u8[6] variables;
    [0x12] u8 accept_class_job;
}

[Size(0x10)]
struct TrackingWork : Base {
    [0x8] u8 quest_type;
    [0x9] u8 index;
}
