[Size(0xC)]
struct OperationGuide {
    [0x0] u8 index;
    [0x1] u8 position_flags { [Bit(0)] OperationGuidePoint relative_point : 4; [Bit(4)] OperationGuidePoint point : 4; }
    [0x2] i16 offset_x;
    [0x4] i16 offset_y;
    [0x8] u32 addon_transient_id;
}

