    top_left = 0,
    top = 1,
    top_right = 2,
    left = 3,
    center = 4,
    right = 5,
    bottom_left = 6,
    bottom = 7,
    bottom_right = 8,
}

[Size(0x20)]
struct SimpleTweenAnimation {
    [0x0] SimpleTweenAnimation* next;
    [0x8] SimpleTweenAnimation* previous;
    [0x10] SimpleTweenValueType type;
    [0x14] f32 start_value;
    [0x18] f32 delta;
}

enum SimpleTweenState : u32 {
    none = 0,
    tweening = 1,
    complete = 2,
}

[Size(0x8)]
struct SimpleTweenValue {
    [0x0] SimpleTweenValueType type;
    [0x4] f32 value;
}

enum SimpleTweenValueType : u32 {
    x = 0,
    y = 1,
    scale_x = 2,
    scale_y = 3,
    // Will be converted into two separate SimpleTweenAnimations, ScaleX and ScaleY, with the same value.
    // Can not be used with GetNodeValue or SetNodeValue.
    scale = 4,
    // When the alpha value reaches 0, it will automatically make the node invisible (same as calling
    // `toggleVisibility` with `false`). In order to make the transition from 0 work, it is necessary to
    // call `toggleVisibility` with `true` first.
    alpha = 5,
    width = 6,
    height = 7,
    // When using this, the node must be a `AtkTextNode`, so it can read/write `node_text`. Internally, the
    // value is cast from float to int and then converted to an Utf8String.
    node_text = 8,
}

