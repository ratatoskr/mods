bitfield NodeFlags : u16 {
    [Bit(0)] bool anchor_top;
    [Bit(1)] bool anchor_left;
    [Bit(2)] bool anchor_bottom;
    [Bit(3)] bool anchor_right;
    [Bit(4)] bool visible;
    [Bit(5)] bool enabled;
    [Bit(6)] bool clip;
    [Bit(7)] bool fill;
    [Bit(8)] bool has_collision;
    [Bit(9)] bool respond_to_mouse;
    [Bit(10)] bool focusable;
    [Bit(11)] bool droppable;
    [Bit(12)] bool is_top_node;
    [Bit(13)] bool emits_events;
    [Bit(14)] bool use_depth_based_priority;
    [Bit(15)] bool unk_flag2;
}

