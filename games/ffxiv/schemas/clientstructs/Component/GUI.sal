// Specifies the action to take after an input callback has been invoked.
enum InputCallbackResult : i32 {
    // No action.
    none = 0,
    // Clears the current input text. Does not update the character count.
    clear_text = 1,
    // Inserts a line break (\r) to the text.
    insert_line_break = 2,
}

// Specifies the type of user interaction that triggered an input callback.
enum InputCallbackType : i32 {
    // The user pressed the `Enter` key.
    enter = 0,
    // The user pressed the `Escape` key.
    escape = 1,
    // The user clicked outside the input area, causing it to lose focus.
    focus_lost = 2,
    // The user modified the input text.
    text_changed = 3,
    // The user pressed the `Tab` key.
    tab = 4,
}

enum InputState : u8 {
    down = 0,
    up = 1,
    held = 2,
    // For `input_navigation`.
    repeat = 3,
}

[Size(0x38)]
struct LinkData {
    [0x0] i32 min_x;
    [0x4] i32 min_y;
    [0x8] i32 max_x;
    [0xC] i32 max_y;
    // To be read until link terminator.
    [0x10] u8* payload;
    // Length from the start of the text in the AtkTextNode.
    [0x18] u16 payload_end;
    // The type of the Link payload. See LinkMacroPayloadType in Lumina.
    [0x1B] u8 link_type;
    [0x1C] u16 link_id;
    [0x1E] u16 link_index;
    [0x20] u32 link_group_id;
    // One of int_value1, u_int_value1
    [0x24] LinkData.Value1Union Value1;
    // One of int_value2, u_int_value2
    [0x28] LinkData.Value2Union Value2;
    // One of int_value3, u_int_value3
    [0x2C] LinkData.Value3Union Value3;
    [0x30] u32 link_color;
}

[Size(0x8)]
struct ListComponentCallBackInterface {
    [0x0] void* virtual_table;
    [Virtual(0)] ListComponentCallBackInterface* dtor(u8 free_flags);
}

[Size(0x88)]
struct MapMarkerNodeContainer {
    [0x80] u8 unk80;
}

