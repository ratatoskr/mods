    // Set a value at the specified index of the StringArray if it differs from the current value.
    [Sig("E8 ?? ?? ?? ?? 8D 56 5D", FirstMatch, Offset(1), Rel32)] void setValueIfDifferent(i32 index, u8* value);
    // Set a value at the specified index of the StringArray if it differs from the current value.
    [Sig("E8 ?? ?? ?? ?? FF C5 89 6C 24 70", FirstMatch, Offset(1), Rel32)] void setValueIfDifferentUtf8(i32 index, Client.System.String.Utf8String* value);
    // Force set a value at the specified index of the StringArray.
    [Sig("3B 51 08 7D 29", FirstMatch)] void setValueForced(i32 index, u8* value, bool read_before_write);
    // Force set a value at the specified index of the StringArray.
    [Sig("48 89 5C 24 ?? 48 89 74 24 ?? 57 48 83 EC ?? 48 8B D9 48 63 FA 49 8B C8", FirstMatch)] void setValueForcedUtf8(i32 index, Client.System.String.Utf8String* value, bool read_before_write);
    // Set a value at the specified index of the StringArray. This calls `setValue` internally with
