        [0x1A] AtkTooltipType type;
    }
}

namespace AtkTooltipManager.AtkTooltipArgs {
    union ArgsUnion {
        // Args for `text` / AddonTooltip.
        AtkTooltipTextArgs text_args;
        // Args for `item` / AddonItemDetail.
        AtkTooltipItemArgs item_args;
        // Args for `action` / AddonActionDetail.
        AtkTooltipActionArgs action_args;
        // Args for `lovm_action` / AddonLovmActionDetail.
        AtkTooltipLovmActionArgs lovm_action_args;
        // Args for `mirage_prism_prism_item` / AddonMiragePrismPrismItemDetail.
        AtkTooltipMiragePrismPrismItemArgs mirage_prism_prism_item_args;
    }

    [Size(0x18)]
    struct AtkTooltipActionArgs {
        // Set to `action_id`/`original_id`.
        [0x8] i32 id;
        // 1 = Adjust ActionId
        [0x14] i16 flags;
        [0x16] Client.Enums.DetailKind kind;
    }

    [Size(0x18)]
    struct AtkTooltipItemArgs {
        // One of item_id, inventory_type
        [0x8] AtkTooltipItemArgs.IdUnion Id;
        // Set to `flag1`.
        [0xC] u32 flag1;
        // Set to `buy_quantity`.
        [0x10] i32 buy_quantity;
        // Used when `kind` is `inventory_item`. Set to `index`.
        [0x14] i16 slot;
        [0x16] Client.Enums.DetailKind kind;
    }

    [Size(0x18)]
    struct AtkTooltipLovmActionArgs {
        [0x8] i32 id;
        // 1 = Adjust ActionId
        [0x14] i16 flags;
        [0x16] Client.Enums.DetailKind kind;
    }

    [Size(0x18)]
    struct AtkTooltipMiragePrismPrismItemArgs {
        // Used for `mirage_prism_plate_item` as ItemId. When this is a MirageStoreSetItem RowId (ItemId of the
        // Set), then specify `set_item_slot` for the slot.
        [0x8] i32 id;
        // Used for `mirage_prism_box_item`.
        [0x10] i32 set_item_slot;
        // Used for `mirage_prism_plate_item`, but unsure what for. Used for `mirage_prism_box_item` as Index
        // in `PrismBoxItemIds`/`PrismBoxStain0Ids`/`PrismBoxStain1Ids`.
        [0x14] i16 index;
        // Either `mirage_prism_plate_item` or `mirage_prism_box_item`.
        [0x16] Client.Enums.DetailKind kind;
    }

    [Size(0x18)]
    struct AtkTooltipTextArgs {
        [0x0] cstring text;
        // Used in AddonTooltip's ManagedInterface vf0. Value: 0 = Nothing 1 = Subscribe to NumberArray
        // Inventory 2 = Subscribe to NumberArray Character
        [0xC] u32 atk_array_type;
    }
}

namespace AtkTooltipManager.AtkTooltipArgs.AtkTooltipItemArgs {
    union IdUnion {
        // Used when `kind` is not `inventory_item`. Set to `type_or_id`.
        i32 item_id;
        // Used when `kind` is `inventory_item`. Set to `type_or_id`.
        Client.Game.InventoryType inventory_type;
    }
}

