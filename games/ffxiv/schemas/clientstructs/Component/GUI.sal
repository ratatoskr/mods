enum AtkUnitBaseLoadState : u8 {
    // `loadUldResourceHandle` will be called, which loads the uld file, and optionally scds.
    loading_uld_resource = 0,
    // AtkUldManager.LoadResourceAndTextures will be called, which creates nodes and loads textures. Refer
    // to `loaded_state`.
    loading_resources = 1,
    // `isFullyLoaded` returned `true`.
    fully_loaded = 2,
}

bitfield AtkUnitBaseVisibilityState : u8 {
    // Set when the addon is no longer in an open or close transition.
    [Bit(0)] bool transition_complete;
    // Set when the addon is in any state of being shown (during open transition, or shown).
    [Bit(1)] bool show;
    // Set when the addon is in any state of being hidden (during close transition, or hidden).
    [Bit(2)] bool hide;
    // none is none of them
}

[Size(0x810)]
struct AtkUnitList {
    [0x8] AtkUnitBase*[256] entries;
    [0x808] u16 count;
}

