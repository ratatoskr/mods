namespace AtkFontManager {
    bitfield DrawFlags : u32 {
        [Bit(27)] bool italic;
    }

    [Size(0xF8)]
    struct Font {
        [0x0] Client.System.Resource.Handle.TextureResourceHandle*[10] texture_resource_handles;
        [0x50] Client.System.Resource.Handle.ResourceHandle* fontdata_resource_handle;
        [0x58] Client.Graphics.Kernel.Texture*[10] textures;
        [0xA8] u32 glyph_count;
        [0xAC] u32 kerning_count;
        [0xB4] u16 texture_width;
        [0xB6] u16 texture_height;
        [0xB8] f32 size;
        [0xBC] i32 line_height;
        [0xC0] i32 ascent;
        [0xC8] Glyph* glyphs;
        [0xD0] STD.StdUnorderedMap<u32, Glyph*>* glyph_map;
        [0xD8] KerningEntry* kerning;
        [0xE0] Font* secondary;
        [0xE8] f32 secondary_ratio;
        [0xF0] u16 texture_count;
        [0xF2] FontFlags flags;
        // The first codepoint of the glyphs looked up by index rather than in `glyph_map`, up to 0xFF, when
        // `direct_index` is set.
        [0xF3] u8 direct_index_first;
        // How far the glyph after italic text moves right, for the overhang of the sheared glyphs before it.
        [0xF4] i8 italic_correction;
        // Extra spacing between consecutive CJK glyphs.
        [0xF5] i8 cjk_spacing;
    }

    bitfield FontFlags : u8 {
        [Bit(0)] bool built;
        [Bit(1)] bool ready;
        [Bit(2)] bool direct_index;
    }

    // The fonts of one `FontType`, and the state of the text being drawn with them.
    [Size(0x278)]
    struct FontSet {
        [0x12C] f32 scaled_size_y;
        [0x130] f32 node_scale_x;
        [0x134] f32 node_scale_y;
        [0x158] DrawFlags draw_flags;
        [0x250] Font* current_font;
        [0x258] f32 current_font_size;
        // Picks the font of the set for the requested size.
        [Sig("83 B9 58 01 00 00 00 4C 8B C1 F3 0F 10 91 2C 01 00 00", FirstMatch)] Font* pickFont(bool use_cache);
        // Looks a glyph up in a font of the set.
        [Sig("89 54 24 10 48 83 EC 38 41 F6 80 F2 00 00 00 04", FirstMatch)] Glyph* getGlyph(u32 utf8_value, Font* font);
    }

    [Size(0x18)]
    struct FontTableEntry {
        [0x0] u64 texture_count;
        [0x8] cstring texture_name_format;
        [0x10] cstring fdt_name;
    }

    [Size(0x30)]
    struct GfdFont {
        [0x0] Client.System.Resource.Handle.TextureResourceHandle* texture_resource_handle;
        [0x8] Client.System.Resource.Handle.ResourceHandle* gfd_resource_handle;
        [0x10] Client.Graphics.Kernel.Texture* texture;
    }

    [Size(0xC)]
    struct Glyph {
        [0x0] u32 utf8_value;
        [0x4] u32 packed { [Bit(0)] u16 x : 12; [Bit(12)] u16 y : 12; [Bit(24)] u8 channel : 2; [Bit(26)] u8 texture_index : 6; }
        [0x8] u8 width;
        [0x9] u8 height;
        [0xA] i8 offset_x;
        [0xB] i8 offset_y;
    }

    [Size(0x8)]
    struct Icon2RemapEntry {
        // The ID passed to the icon2 macro.
        [0x0] u32 icon_id;
        // The GFD Icon ID that should be displayed.
        [0x4] u32 remapped_icon_id;
    }

    [Size(0xC)]
    struct KerningEntry {
        [0x0] u32 left;
        [0x4] u32 right;
        [0x8] i32 adjustment;
    }
}

