namespace AtkAddonControl {
    [Size(0x48)]
    struct ChildAddonInfo {
        [0x0] cstring unk0;
        [0x8] AtkUnitBase* atk_unit_base;
        [0x20] AtkCollisionNode* collision_node;
        [0x30] i32 tab_index;
        [0x3C] i16 position_x;
        [0x3E] i16 position_y;
        [0x40] u8 flags1;
        [0x41] u8 flags2;
    }
}

namespace AtkComponentGaugeBar {
    // A set of three NineGrid nodes for the bar's fill level; one main fill node, and two nodes layered
    // beneath in alternate colors.
    [Size(0x18)]
    struct GaugeFill {
        [0x0] AtkNineGridNode* main_fill_node;
        [0x8] AtkNineGridNode* increase_fill_node;
        [0x10] AtkNineGridNode* decrease_fill_node;
    }

    // The gauge's current value, represented a few different ways. Float values are used as reference for
    // animating the bar.
    [Size(0x10)]
    struct GaugeValue {
        [0x0] i32 value_int;
        [0x4] f32 value_float_increasing;
        [0x8] f32 value_float;
        [0xC] f32 value_float_decreasing;
    }

    // Data describing a value transition. Informs the fields in `GaugeValue`. These fields aren't
    // overwritten until the next transition of the same type occurs.
    [Size(0x10)]
    struct GaugeValueTransition {
        [0x0] i32 start_value;
        [0x4] i32 end_value;
        [0x8] f32 progress;
        [0xC] f32 transition_length;
    }

    // The most recent increase and most recent decrease of a gauge's value.
    [Size(0x20)]
    struct GaugeValueTransitionData {
        [0x0] GaugeValueTransition increase;
        [0x10] GaugeValueTransition decrease;
    }
}

namespace AtkComponentHoldButton {
    [Size(0x10)]
    struct ProgressState {
        [0x0] f32 start_value;
        [0x4] f32 target_value;
        [0x8] f32 current_value;
        [0xC] f32 end_value;
        [Sig("F3 0F 10 05 ?? ?? ?? ?? 0F 2F C1 F3 0F 11 51", FirstMatch)] void startProgress(f32 current_value, f32 target_value, f32 end_value);
    }
}

