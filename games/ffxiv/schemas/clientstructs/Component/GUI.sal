    [Size(0x10)]
    struct FilterStruct {
        [0x0] AtkStage* atk_stage;
        // Number of active users of `addon_filter_system`.
        [0x8] i16 num_active_system_filters;
        // Number of active users of `addon_filter`.
        [0xA] i16 num_active_filters;
        // Number of active users of `managed_screen_frame`.
        [0xC] i16 num_active_screen_frames;
        // An additional addon included in modal-filter draw-order checks. A non-zero ID also enables
        // input-filter checks during addon collision testing.
        [0xE] u16 additional_filter_addon_id;
        // Activates `addon_filter` for the specified addon.
        [Sig("E8 ?? ?? ?? ?? EB ?? E8 ?? ?? ?? ?? 48 8B D3 48 8D 88", FirstMatch, Offset(1), Rel32)] void acquireFilter(AtkUnitBase* addon);
        // Deactivates `addon_filter` for the specified addon.
        [Sig("E8 ?? ?? ?? ?? 0F BA E5 ?? 48 8B 6C 24 ?? 73 ?? 48 8D 4F", FirstMatch, Offset(1), Rel32)] void releaseFilter(AtkUnitBase* addon);
        // Activates `addon_filter_system`.
        [Sig("E8 ?? ?? ?? ?? 40 84 ED 79 ?? 48 8B CF", FirstMatch, Offset(1), Rel32)] void acquireSystemFilter();
        // Deactivates `addon_filter_system`.
        [Sig("E8 ?? ?? ?? ?? 0F BA E5 ?? 73 ?? 48 8B 8F ?? ?? ?? ?? 33 D2", FirstMatch, Offset(1), Rel32)] void releaseSystemFilter();
        // Activates `managed_screen_frame`.
        [Sig("48 8B 01 48 85 C0 74 ?? 48 8B 40 ?? 4C 8B 90 ?? ?? ?? ?? 4D 85 D2 74 ?? 66 FF 41 ?? 45 33 C9", FirstMatch)] void acquireScreenFrame();
        // Deactivates `managed_screen_frame`.
        [Sig("48 8B 01 48 85 C0 74 ?? 48 8B 40 ?? 4C 8B 90 ?? ?? ?? ?? 4D 85 D2 74 ?? 66 FF 49 ?? 66 83 79 ?? 00", FirstMatch)] void releaseScreenFrame();
        // Returns whether the specified addon can receive input while filters are active.
        [Sig("E8 ?? ?? ?? ?? 84 C0 75 ?? 41 81 8E", FirstMatch, Offset(1), Rel32)] bool canAddonReceiveInput(AtkUnitBase* addon);
        // Sets the additional addon used in input-filter draw-order checks and enables filtering during addon
        // collision testing.
        [Sig("48 85 D2 74 ?? 0F B7 82 ?? ?? ?? ?? 66 89 41", FirstMatch)] void setAdditionalFilterAddon(AtkUnitBase* addon);
        // Clears the additional addon if it matches the specified addon.
        [Sig("48 85 D2 74 ?? 0F B7 82 ?? ?? ?? ?? 66 39 41", FirstMatch)] void clearAdditionalFilterAddon(AtkUnitBase* addon);
    }

    [Size(0x30)]
    struct OperationGuideStruct {
        [0x0] AtkStage* atk_stage;
