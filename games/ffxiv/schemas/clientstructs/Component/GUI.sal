enum AtkUldManagerBaseType : u8 {
    none = 0,
    component = 1,
    widget = 2,
}

bitfield AtkUldManagerResourceFlag : u8 {
    // A flag to indicate UldManager itself is Initialized (Initialize from AtkUnitBase or AtkComponentBase
    // was called).
    [Bit(0)] bool initialized;
    // Keeps the UldResourceHandle after loading data from it, so duplicate nodes can read data later on.
    [Bit(1)] bool keep_uld_resource_handle;
    // Objects and NodeList were allocated.
    [Bit(2)] bool arrays_allocated;
    // Set with `(*(_DWORD *)&RootNode->Priority & 0x400000) != 0` and is read for calling
    // DrawUldFromDataClipped instead of DrawUldFromData.
    [Bit(3)] bool clipped_draw;
    // Enables to check the ThemeSupportBitmask of a TextureEntry when loading assets.
    [Bit(4)] bool assets_have_theme_support;
    [Bit(5)] bool contains_clipping_mask_node;
    // none is none of them
}

