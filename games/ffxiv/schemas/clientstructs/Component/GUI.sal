    [Bit(7)] bool unk80;
    // none is none of them
}

// Values used for other Atk systems sent on the stack. Only `type` == `managed` has the value pointer
// located in the heap.
[Size(0x10)]
struct AtkValue {
    [0x0] AtkValueType type;
    // One of bool, byte, int, int64, u_int, u_int64, float, string, wide_string, vector, pointer, atk_values
    [0x8] AtkValue.ValueUnion Value;
    [Sig("E8 ?? ?? ?? ?? EB ?? 83 CB ?? C7 45", FirstMatch, Offset(1), Rel32)] AtkValue* ctorCopy(AtkValue* other);
    [Sig("E8 ?? ?? ?? ?? 83 FF FE", FirstMatch, Offset(1), Rel32)] void dtor();
    [Sig("44 8B 02 4C 8B C9 8B 01", FirstMatch)] bool equalTo(AtkValue* other);
    [Sig("E8 ?? ?? ?? ?? 41 8D 55 2A", FirstMatch, Offset(1), Rel32)] void copy(AtkValue* other);
    [Sig("E8 ?? ?? ?? ?? 41 80 F6", FirstMatch, Offset(1), Rel32)] void changeType(AtkValueType type);
    // Set this AtkValue to reference the specified pointer to a cstring. The pointer *must* remain valid
    // for the lifetime of this AtkValue! Type is set to ValueType.String.
    [Sig("E8 ?? ?? ?? ?? 41 83 4D", FirstMatch, Offset(1), Rel32)] void setString(u8* string_ptr);
    // Set this AtkValue to hold the specified string. The string value is copied and stored locally for
    // this object. Type is set to ValueType.ManagedString.
    [Sig("E8 ?? ?? ?? ?? 41 03 ED", FirstMatch, Offset(1), Rel32)] void setManagedString(cstring value);
    [Sig("E8 ?? ?? ?? ?? 33 FF 89 7C 24", FirstMatch, Offset(1), Rel32)] void createVector(u32 size);
    [Sig("E8 ?? ?? ?? ?? 3B D8 73 17", FirstMatch, Offset(1), Rel32)] u32 getVectorSize();
    [Sig("48 83 EC 28 48 8B 49 08 48 85 C9 74 0C", FirstMatch)] void setVectorSize(u32 size);
    [Sig("E8 ?? ?? ?? ?? 8B 08 80 E1 0F", FirstMatch, Offset(1), Rel32)] AtkValue* getVectorValue(u32 index);
    [Sig("E8 ?? ?? ?? ?? 48 8D 4C 24 ?? EB 5C", FirstMatch, Offset(1), Rel32)] bool setVectorValue(u32 index, AtkValue* value);
    [Sig("E8 ?? ?? ?? ?? 49 8B 4E ?? FF C7", FirstMatch, Offset(1), Rel32)] bool setVectorString(u32 index, cstring value);
    [Sig("E8 ?? ?? ?? ?? 48 8D 4C 24 ?? E8 ?? ?? ?? ?? 8B 8E", FirstMatch, Offset(1), Rel32)] bool copyVectorValue(u32 index, AtkValue* out_value);
    [Sig("E8 ?? ?? ?? ?? 8B F8 83 C0 ?? 83 F8 ?? 77 ?? 48 63 C8", FirstMatch, Offset(1), Rel32)] i32 getInt();
