// since this is written again.

namespace Component.SteamApi;

// This structure represents the game's internal bridge between itself and the Steam API. It contains
// information retrieved from the Steam API, as well as some wrapper methods around certain Steam API
// calls. Because this structure is not a direct representation of the Steam API but instead the game's
// view of the API, not all names will match Steam-provided names perfectly. This struct does not have
// stability guarantees. The Steam API appears to be under active construction by Square Enix, and
// certain things will shift either as we learn more about how the API works or SE makes their own
// changes. If you're using this struct, you are signing up for breakage.
[Size(0x4D0)]
struct SteamApi {
    [0x408] bool steam_api_initialized;
    [0x40C] f32 time_since_last_callback_run;
    [0x410] u32 steam_app_id;
    [0x414] SteamTypes.CSteamId steam_local_user_id;
    [0x420] void* persona_name_ptr;
    [0x428] bool auth_ticket_present;
    [0x42C] SteamTypes.AuthSessionTicketResponse auth_ticket;
    [0x434] bool virtual_keyboard_opened;
    [0x438] Client.System.String.Utf8String virtual_keyboard_entered_text;
    [0x4A0] Callbacks.AuthSessionTicketResponseCallback auth_session_ticket_response_callback;
    [0x4B0] Callbacks.FloatingGamepadTextInputDismissedCallback floating_gamepad_text_input_dismissed_callback;
    [0x4C0] Callbacks.GamepadTextInputDismissedCallback gamepad_text_input_dismissed_callback;
    [Sig("E8 ?? ?? ?? ?? 48 8B D8 48 8B CB 48 89 9F", FirstMatch, Offset(1), Rel32)] SteamApi* ctor();
    [Sig("40 53 48 83 EC ?? 48 8B D9 FF 15 ?? ?? ?? ?? 48 8D 8B", FirstMatch)] void dtor();
    // Ask the Steam API for the current time according to Steam's servers. See the Steam API docs for more
    // information.
    [Sig("48 83 EC 28 48 8D 0D ?? ?? ?? ?? FF 15 ?? ?? ?? ?? 48 8B 08", FirstMatch)] u32 getSteamServerTime();
    // Ask the Steam API if Steam is currently running on a Steam Deck. See the Steam API docs for more
    // information.
    [Sig("E8 ?? ?? ?? ?? 84 C0 74 ?? 48 8D 15 ?? ?? ?? ?? EB", FirstMatch, Offset(1), Rel32)] bool isRunningOnSteamDeck();
    // Request that Steam show a virtual keyboard over the game. The resulting string will be stored in
    // `virtual_keyboard_entered_text`. This method requires Steam to be in Big Picture Mode, and ideally
    // for the Steam Overlay to be enabled. See the Steam API docs for more information.
    [Sig("48 89 5C 24 ?? 48 89 74 24 ?? 57 48 83 EC 30 48 8B F1 8B FA 48 81 C1", FirstMatch)] bool showGamepadTextInput(i32 max_chars);
    // Request that Steam show a floating virtual keyboard over the game, attempting to not obscure the
    // rectangle described in this method's arguments. Keys pressed via this method will be sent directly
    // to the game process. This method requires Steam be in Big Picture Mode and the Steam Overlay to be
    // enabled for the game. See the Steam API docs for more information.
    [Sig("48 89 5C 24 ?? 48 89 6C 24 ?? 48 89 74 24 ?? 57 48 83 EC 30 48 8B E9 41 8B D9 48 8D 0D ?? ?? ?? ?? 41 8B F8", FirstMatch)] bool showFloatingGamepadTextInput(i32 field_x_position, i32 field_y_position, i32 text_field_width, i32 text_field_height);
}

[Size(0x10)]
struct SteamCallbackBase {
    [0x0] void* virtual_table;
    [0x8] SteamCallbackBase.SteamCallbackFlags flags;
    [0xC] i32 callback_id;
    // This method just calls `run` in virtually all cases. Additionally, thanks to some SteamAPI
    // shenanigans, vf0 and vf1 may be swapped on occasion. This shouldn't realistically matter ever, but
    // worth noting. Just use `run`.
    [Virtual(0)] void runExtended(void* out_callback_params, bool b_io_failure, i64 h_steam_api_call);
    [Virtual(1)] void run(void* out_callback_params);
    [Virtual(2)] isize getSize();
    [Virtual(3)] SteamCallbackBase* dtor(u8 free_flags);
}

// A structure that represents a Steam API context. This is used by `SteamInternal_ContextInit` to
// manage and maintain a pointer to an instance of an arbitrary Steam API type.
[Size(0x18)]
struct SteamInterfaceContext {
    [0x0] void* find_or_create_interface_f_ptr;
    [0x8] usize counter;
    [0x10] void* cached_interface_ptr;
}

// Types provided by the Steam API, and are not native to the game itself. Used to provide reasonable
// interop for a few things that would be annoying to process otherwise.
[Size(0x1)]
struct SteamTypes {
}

namespace SteamCallbackBase {
    bitfield SteamCallbackFlags : u8 {
        [Bit(0)] bool registered;
        [Bit(1)] bool game_server;
    }
}

namespace SteamTypes {
    [Size(0x8)]
    struct AuthSessionTicketResponse {
        [0x0] u32 h_auth_ticket;
        [0x4] i32 e_result;
    }

    [Size(0x8)]
    struct CSteamId {
        [0x0] u64 raw_steam_id { [Bit(0)] u32 account_id : 32; [Bit(32)] u32 account_instance : 20; [Bit(52)] u8 account_type : 4; [Bit(56)] u8 universe : 8; }
    }

    [Size(0x12)]
    struct GamepadTextInputDismissedData {
        [0x0] bool submitted;
        [0x4] u32 submitted_text_size;
        [0x8] u32 app_id;
    }
}
