namespace EnvironmentManager {
    [Size(0xC)]
    struct ModeUpdateOp {
        [0x0] ModeUpdateOpType type;
        [0x4] i16 param1;
        [0x6] i16 param2;
        [0x8] i16 param3;
    }

    enum ModeUpdateOpType : i32 {
        delay = 1,
        make_windowed_and_resize = 2,
        make_windowed = 3,
        make_borderless = 4,
        wait_until_device_ready = 5,
        resize = 6,
        make_fullscreen = 7,
    }

    // Each value represents one volume slider in the system configuration, expect master volume.
    enum SoundChannel : u32 {
        bgm = 0,
        sound_effects = 1,
        voice = 2,
        environment = 3,
        system = 4,
        perform = 5,
        all = 6,
    }
}

namespace Framework {
    [Size(0x20)]
    struct ExVersionString {
        [0x0] utf8[32] version;
    }
}

namespace JobListInterface {
    // Type-erased member function call: `invoker` calls `function` on `object` offset by `object_offset`.
    // For job lists the function claims the next task, returning it and its argument, and the number of
    // tasks left (the queue advances when that is 0).
    [Size(0x20)]
    struct JobDescriptor {
        [0x0] void* invoker;
        [0x8] void* object;
        [0x10] void* function;
        // Signed offset added to `object` before the call, the this-adjustment of a member function pointer.
        [0x18] i32 object_offset;
    }
}

namespace JobQueue {
    // An entry whose job has no object is handed out as the task itself. Its Execute calls
    // `direct_function` with `direct_object`, a pointer to the arguments at +0x68 and the context the
    // thread passed (the address of `JobPool + 0x38`), or `context_override` instead when
    // `use_context_override` is set.
    [Size(0x98)]
    struct JobQueueListData : Task {
        [0x38] JobListInterface.JobDescriptor job;
        [0x58] void* direct_function;
        [0x60] void* direct_object;
        [0x80] void* context_override;
        [0x88] isize* completion_event;
        [0x90] bool use_context_override;
    }
}

namespace TaskManager {
    [Size(0x4C)]
    struct JobPool {
        [0x0] bool initialized;
        [0x8] JobPool.InnerThread** threads;
        [0x10] i32 thread_count;
        // Threads pass the address of this field, `JobPool + 0x38`, to every task they run. Nothing reads it.
        [0x38] i32 unk38;
        // Set by a thread that finds the queue empty. The task manager waits on it after submitting a job
        // list.
        [0x40] isize handle;
        // Incremented once per thread by the TaskManager finalizer. Nothing reads it.
        [0x48] i32 unk48;
        // Signals every thread that has fewer than 2 pending wakes.
        [Sig("E8 ?? ?? ?? ?? 48 8B 4C 24 ?? BA ?? ?? ?? ?? FF 15", FirstMatch, Offset(1), Rel32)] void wakeAllThreads();
    }

    [Size(0x78)]
    struct RootTask : Task {
        [0x38] Task unk_task;
    }
}

namespace TaskManager.JobPool {
    [Size(0x48)]
    struct InnerThread : Threading.Thread {
        [0x28] JobPool* pool;
        [0x30] i32 index;
        [0x34] u8 unk34;
        [0x35] u8 unk35;
        // Wake requests not yet consumed. The thread sleeps on `event_handle2` when this drops to 0.
        [0x38] i32 pending_wakes;
        [0x40] isize event_handle2;
    }
}
