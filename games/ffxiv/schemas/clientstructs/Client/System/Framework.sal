// Runs `function` once per task, passing the task index. Every Client::Graphics::JobSystem uses one,
// with `writer_count` - 1 tasks, each calling the system's help function.
[Size(0xA8), VirtualTable("48 8D 05 ?? ?? ?? ?? 49 89 77 18 49 89 77 20 49 89 77 28 49 89 77 30 49 89 77 40", FirstMatch, Offset(3), Rel32)]
struct JobListArgArrayAndIndex : JobListInterface {
    // Inherited parent class accessor for `Task`
    [0x38] Task task;
    [0x70] void* args;
    // Number of tasks, returned by `getTaskCount`.
    [0x78] i32 claim_limit;
    [0x7C] i32 claimed_tasks;
    [0x80] void* function;
    [0x88] void* object;
    // Member function pointer (address, then object offset) that `function` receives the address of.
    [0x90] u8[16] thunk;
    [0xA0] i32 next_index;
}

// A batch of `task_count` tasks run by the `JobPool` threads. Scheduled with `scheduleJobList`, joined
// with `wait`.
[Size(0x38)]
struct JobListInterface {
    [0x0] void* virtual_table;
    [0x8] i32 task_count;
    // Tasks not yet finished. The last one to finish calls `completion_function` and sets `done_event`.
    [0xC] i32 pending_tasks;
    [0x10] isize done_event;
    // Called as (`completion_object`, address of the list + 0x28, address of `task_count`).
    [0x18] void* completion_function;
    [0x20] void* completion_object;
    // Fills in what the queue entry uses to claim this list's tasks.
    [Virtual(1)] JobListInterface.JobDescriptor* getJob(JobListInterface.JobDescriptor* out_job);
    // Waits for the previous run, then resets the claim counter, `pending_tasks` and `done_event`.
    [Virtual(2)] void prepare();
    // Waits until every task of the list has run.
    [Virtual(3)] void wait();
    // How many tasks the list runs, its claim limit. Normally equal to `task_count`: both are set from the
    // same constructor argument. `scheduleJobList` does nothing for 0 and wakes a single thread for 1.
    [Virtual(4)] u32 getTaskCount();
}

// Runs `function` once per task, without arguments.
[Size(0x98), VirtualTable("48 8D 05 ?? ?? ?? ?? 48 89 7B 18 48 89 7B 20 48 89 7B 28 48 89 7B 30 48 89 7B 40 48 89 7B 48 48 89 7B 50 48 89 7B 58 48 89 03 48 8D 05 ?? ?? ?? ?? 48 89 43 38 B8 FF FF FF FF 48 89 7B 60 48 89 7B 68 89 7B 70", FirstMatch, Offset(3), Rel32)]
struct JobListNoArg : JobListInterface {
    // Inherited parent class accessor for `Task`
    [0x38] Task task;
    // Number of tasks, returned by `getTaskCount`.
    [0x70] i32 claim_limit;
    [0x74] i32 claimed_tasks;
    [0x78] void* function;
    [0x80] void* object;
    // Member function pointer (address, then object offset) that `function` receives the address of.
    [0x88] u8[16] thunk;
}

// The ring that every `JobPool` thread takes work from. Threads only claim tasks from the head entry,
// one per lock, and the head advances when its last task is claimed.
[Size(0x4C30)]
struct JobQueue {
    [0x0] u32 write_index;
    [0x4] u32 read_index;
    [0x8] u8[40] lock;
    [0x30] JobQueue.JobQueueListData[128] entries;
    [Sig("48 8D 0D ?? ?? ?? ?? FF 15 ?? ?? ?? ?? 8B 05 ?? ?? ?? ?? 4C 8D 0D ?? ?? ?? ?? 48 8B 0B 0F 57 C9", FirstMatch, Offset(15), Rel32)] static JobQueue instance;
}

