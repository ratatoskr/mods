// The X and Z coordinates of a tile on a terrain grid.
[Size(0x4)]
struct TerrainGridCoordinates {
    [0x0] i16 tile_x;
    [0x2] i16 tile_z;
}

// The flags that can be specified in a terrain resource.
enum TerrainResourceFlag : u32 {
    unk0 = 0,
    unk1 = 1,
    unk2 = 2,
}

// Terrain resources define a grid layout and specify tiles with models assigned to them. Each terrain
// tile has a corresponding model with the path `####.mdl` relative to the terrain resource according
// to their index in it, starting at `0000.mdl`.
[Size(0xC0)]
struct TerrainResourceHandle : DefaultResourceHandle {
    // Gets the version of the terrain resource. The current version is `0x1000003`
    [Sig("48 83 EC 28 48 8B 01 FF 90 ?? ?? ?? ?? 8B 00", FirstMatch)] u32 getFileVersion();
    // Gets the number of tiles in the terrain resource.
    [Sig("E8 ?? ?? ?? ?? 8B D0 81 FF", FirstMatch, Offset(1), Rel32)] u32 getTileCount();
    // Gets the horizontal size of the grid tiles in the terrain resource.
    [Sig("E8 ?? ?? ?? ?? 41 89 85 ?? ?? ?? ?? 44 8B E0", FirstMatch, Offset(1), Rel32)] u32 getTileWidth();
    // Gets the clip distance stored in the terrain resource, or 0.0f for files older than version
    // `0x1000002`.
    [Sig("E8 ?? ?? ?? ?? F3 0F 59 C0 F3 0F 11 87", FirstMatch, Offset(1), Rel32)] f32 getClipDistance();
    [Sig("E8 ?? ?? ?? ?? 48 8B CB F3 0F 11 87", FirstMatch, Offset(1), Rel32)] f32 getUnk10();
    // Returns whether the flag with the given index is enabled in the terrain resource.
    [Sig("E8 ?? ?? ?? ?? 88 87 ?? ?? ?? ?? 48 8B 7C 24", FirstMatch, Offset(1), Rel32)] bool getFlag(TerrainResourceFlag flag_index);
    // Gets the array of grid coordinates for the tiles in the terrain resource.
    [Sig("E8 ?? ?? ?? ?? 4C 8B F8 44 8B D5", FirstMatch, Offset(1), Rel32)] TerrainGridCoordinates* getTileCoordinateArray();
}

