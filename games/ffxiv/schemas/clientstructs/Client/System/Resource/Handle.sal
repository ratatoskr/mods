namespace PapLoadTableResourceHandle {
    // Contains info about an animation.
    [Size(0xC)]
    struct AnimationEntry {
        [0x0] u32 flags { [Bit(3)] bool is_demihuman_resident; [Bit(4)] bool is_monster_resident; [Bit(5)] bool is_human_resident; [Bit(6)] bool is_common_resident_mount; [Bit(7)] bool is_mount; [Bit(8)] bool is_mount01; [Bit(9)] bool is_mount02; [Bit(10)] bool is_wildcard; [Bit(11)] bool is_mount03; [Bit(12)] bool is_mount04; [Bit(13)] bool is_custom_resident_ornament; [Bit(14)] bool is_common_resident_ornament; [Bit(15)] bool is_mount05; [Bit(16)] bool is_mount06; [Bit(17)] bool is_mount07; [Bit(18)] bool is_mount08; }
        // The offset of the folder the pap resource is in relative to the model's animation variant folder.
        // Pass to `getPapFolder` to obtain the string data.
        [0x4] u32 pap_folder_offset;
        // The offset of the name of the pap resource within its folder. Pass to `getPapName` to obtain the
        // string data.
        [0x8] u32 pap_name_offset;
    }

    [Size(0x10)]
    struct FileHeader {
        // The number of animation entries in the pap load table.
        [0x0] u16 animation_entry_count;
        // The number of model entries in the pap load table.
        [0x2] u16 model_entry_count;
        // The number of groups of four animation redirect entries in the pap load table.
        [0x4] u32 redirect_entry_group_count;
        // The offset into the resource data where the pap folder strings start.
        [0x8] u32 pap_folder_strings_offset;
        // The offset into the resource data where the pap name strings start.
        [0xC] u32 pap_name_strings_offset;
    }

    // Specifies which animation entries are overridden for an animation variant of a character model.
    [Size(0xA8)]
    struct ModelEntry {
        // The character type and model ID that this entry affects.
        [0x0] u32 animation_model_id { [Bit(0)] u8 model_id : 2; [Bit(2)] u8 character_type : 2; }
        // The animation variant that this entry affects.
        [0x4] u16 animation_variant;
        // How far into `RedirectEntries` this entry's redirects start at, measured in groups of 4.
        [0x6] u16 redirect_start_offset_groups;
        // Which of the groups of 4 animation entries are overridden for this character
        [0x8] u8[160] animation_groups_overridden_bits;
    }

    // Specifies a pap resource that a character should load rather than having its own.
    [Size(0x8)]
    struct RedirectEntry {
        // The character type and model ID of the animation pack being redirected to.
        [0x0] u32 animation_model_id { [Bit(0)] u8 model_id : 2; [Bit(2)] u8 character_type : 2; }
        // The animation variant of the animation pack being redirected to.
        [0x4] u16 animation_variant;
        // The offset of the name of the subfolder the replacement pap resource is in. Pass to `getPapFolder`
        // to obtain the string data.
        [0x6] u16 pap_folder_offset;
    }
}

