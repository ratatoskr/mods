    [Bit(6)] bool payloads;
    [Bit(7)] bool unknown7;
    [Bit(8)] bool unknown8;
    [Bit(9)] bool unknown9;
    // Hiragana, Katakana, CJK Unified Ideographs
    [Bit(10)] bool cjk;
    [Bit(11)] bool unknown11;
}

