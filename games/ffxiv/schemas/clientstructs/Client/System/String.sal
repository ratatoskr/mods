    // !"#$%&'()*+,-./:;\<=>?@[\]^_`{|}~¡¿ÀÁÂÃÄÅÆÇÈÉÊËÌÍÎÏÐÑÒÓÔÕÖØÙÚÛÜÝÞßàáâãäåæçèéêëìíîïðñòóôõöøùúûüýþÿ
    [Bit(3)] bool special_characters;
