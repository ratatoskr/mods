// since this is written again.

namespace Client.System.Input;

[Size(0xE0), VirtualTable("48 8D 05 ?? ?? ?? ?? 48 8B D9 48 89 01 48 83 C1 08 E8 ?? ?? ?? ?? 48 8D 4B 70 E8 ?? ?? ?? ?? 48 8B C3", FirstMatch, Offset(3), Rel32)]
struct ClipBoard : ClipBoardInterface {
    [0x8] String.Utf8String system_clipboard_text;
    [0x70] String.Utf8String copy_staging_text;
}

[Size(0x8)]
struct ClipBoardInterface {
    [0x0] void* virtual_table;
    // Writes to the system clipboard. Currently, `this` is unused; this might as well be a static
    // function, but all uses of it are indirect.
    [Virtual(1)] void writeToSystemClipboard(String.Utf8String* string_to_copy, String.Utf8String* copied_string_without_payload);
    // Retrieves the current system clipboard text. Currently, `system_clipboard_text` is updated after
    // this call.
    [Virtual(2)] String.Utf8String* getSystemClipboardText();
    // Sets the copy staging text. Currently, this effectively copies `utf8_string` to `copy_staging_text`.
    [Virtual(3)] void setCopyStagingText(String.Utf8String* utf8_string);
    // Sets the copy staging text to the system clipboard. Currently, this effectively calls
    // `writeToSystemClipboard`, using `copy_staging_text` as both parameters.
    [Virtual(4)] void applyCopyStagingText();
}

[Size(0x378)]
struct Cursor {
    [0x9] bool use_software_cursor;
    [0xA] u8 software_cursor_scale;
    [0xB] bool is_cursor_visible;
    [0xC] bool mouse_not_cpatured;
    [0xD] bool is_cursor_outside_view_port;
    [0x10] u32 active_cursor_type;
    [0x1B0] u64[16] cursor_handles;
    [0x238] cstring[16] cursor_names;
    [0x2C0] i32 hardware_cursor_size;
    [0x2C8] Resource.Handle.TextureResourceHandle* software_cursor_texture;
    [0x368] bool show_software_cursor_trajectory;
    [0x370] bool use_os_hardware_cursor;
    [Sig("75 36 48 8B 15 ?? ?? ?? ??", FirstMatch, Offset(5), Rel32)] static Cursor* instance;
}

[Size(0x30)]
struct CursorInputData {
    [0x0] i32 position_x;
    [0x4] i32 position_y;
    [0x8] i32 mouse_wheel;
    [0xC] MouseButtonFlags mouse_button_held_flags;
    [0x10] MouseButtonFlags mouse_button_pressed_flags;
    [0x14] MouseButtonFlags mouse_button_released_flags;
    [0x18] MouseButtonFlags mouse_button_held_throttled_flags;
    [0x20] i32 delta_x;
    [0x24] i32 delta_y;
    // The definition of this field overlaps with whether the cursor device was acquired using
    // IDirectInputDevice8::Acquire/Unacquire.
    [0x2C] bool is_game_window_focused;
    [Sig("84 D2 74 0F 33 C0", FirstMatch)] void clear(bool clear_position_and_wheel, MouseButtonFlags buttons_to_clear);
}

bitfield GamepadButtonsFlags : u16 {
    // Digipad up.
    [Bit(0)] bool d_pad_up;
    // Digipad down.
    [Bit(1)] bool d_pad_down;
    // Digipad left.
    [Bit(2)] bool d_pad_left;
    // Digipad right.
    [Bit(3)] bool d_pad_right;
    // North action button. Triangle on PS, Y on Xbox.
    [Bit(4)] bool north;
    // South action button. Cross on PS, A on Xbox.
    [Bit(5)] bool south;
    // West action button. Square on PS, X on Xbos.
    [Bit(6)] bool west;
    // East action button. Circle on PS, B on Xbox.
    [Bit(7)] bool east;
    // First button on left shoulder side.
    [Bit(8)] bool l1;
    // Second button on left shoulder side. Analog input lost in this bitmask.
    [Bit(9)] bool l2;
    // Press on left analogue stick.
    [Bit(10)] bool l3;
    // First button on right shoulder.
    [Bit(11)] bool r1;
    // Second button on right shoulder. Analog input lost in this bitmask.
    [Bit(12)] bool r2;
    // Press on right analogue stick.
    [Bit(13)] bool r3;
    // Button on the left inner side of the controller. ??? on PS, Back on Xbox.
    [Bit(14)] bool select;
    // Button on the right inner side of the controller. Options on PS, Start on Xbox.
    [Bit(15)] bool start;
    // none is none of them
}

[Size(0x24C)]
struct GamepadInputData {
    [0x0] i32 left_stick_x;
    [0x4] i32 left_stick_y;
    [0x8] i32 right_stick_x;
    [0xC] i32 right_stick_y;
    [0x10] GamepadButtonsFlags buttons;
    [0x14] GamepadButtonsFlags buttons_pressed;
    [0x18] GamepadButtonsFlags buttons_released;
    [0x20] GamepadButtonsFlags buttons_repeat;
    [0x24] f32 square;
    [0x28] f32 cross;
    [0x2C] f32 circle;
    [0x30] f32 triangle;
    [0x34] f32 l1;
    [0x38] f32 r1;
    [0x3C] f32 l2;
    [0x40] f32 r2;
    [0x48] f32 start;
    [0x4C] f32 l3;
    [0x50] f32 r3;
    [0x54] f32 ps_button;
    [0x58] f32 select;
    [0x5C] f32 mute_button;
    [0xA4] f32 left_stick_left;
    [0xA8] f32 left_stick_right;
    [0xC4] f32 left_stick_up;
    [0xC8] f32 left_stick_down;
    [0xE4] f32 right_stick_left;
    [0xE8] f32 right_stick_right;
    [0x144] f32 right_stick_up;
    [0x148] f32 right_stick_down;
    [0x184] f32 d_pad_left;
    [0x188] f32 d_pad_right;
    [0x18C] f32 d_pad_up;
    [0x190] f32 d_pad_down;
}

enum GamepadInputsFilter : u8 {
    right_stick = 0,
    left_stick = 1,
}

bitfield GamepadModifierFlag : u8 {
    [Bit(0)] bool l1;
    [Bit(1)] bool r1;
    [Bit(2)] bool l2;
    [Bit(3)] bool r2;
    [Bit(6)] bool start;
    [Bit(7)] bool select;
    // none is none of them
}

[Size(0x9D0)]
struct InputData {
    [0x0] void* virtual_table;
    [0x8] GamepadInputData gamepad_inputs;
    [0x254] GamepadInputData gamepad_inputs2;
    [0x4A0] CursorInputData ui_filtered_cursor_inputs;
    [0x4D0] CursorInputData cursor_inputs;
    [0x500] KeyboardInputData keyboard_inputs;
    [0x994] GamepadModifierFlag current_gamepad_modifier;
    [0x995] KeyModifierFlag current_key_modifier;
    // The field contains values of `MouseButtonFlags` (as byte instead of int), saving which buttons are
    // currently used for dragging.
    [0x9AC] u8 current_mouse_drag_buttons;
    [0x9AE] bool gamepad_inputs2_buttons_changed;
    [0x9AF] bool cursor_positions_changed;
    [0x9B0] bool keyboard_inputs_changed;
    [0x9B1] bool ui_filtered_cursor_inputs_buttons_changed;
    [0x9B2] bool gamepad_inputs_buttons_changed;
    [0x9B3] GamepadInputsFilter current_gamepad_inputs_filter;
    [0x9B4] i32 num_keybinds;
    [0x9B8] Keybind* keybinds;
    [0x9C8] InputData.InputCodeModifiedInterface* input_code_modified_callback;
    [Virtual(2)] void setKeybind(InputId input_id, Keybind* keybind);
    [Sig("E9 ?? ?? ?? ?? 83 7F 44 02", FirstMatch, Offset(1), Rel32)] bool isInputIdPressed(InputId input_id);
    [Sig("E8 ?? ?? ?? ?? 4C 8D 76 06", FirstMatch, Offset(1), Rel32)] bool isInputIdDown(InputId input_id);
    [Sig("E8 ?? ?? ?? ?? 84 C0 74 37 EB 06", FirstMatch, Offset(1), Rel32)] bool isInputIdHeld(InputId input_id);
    [Sig("E8 ?? ?? ?? ?? 88 43 0F", FirstMatch, Offset(1), Rel32)] bool isInputIdReleased(InputId input_id);
    // Same as `isInputIdDown`, except `current_gamepad_modifier` doesn't need to match `inputId`
    [Sig("E8 ?? ?? ?? ?? 84 C0 0F 84 ?? ?? ?? ?? BA 29 00 00 00", FirstMatch, Offset(1), Rel32)] bool isInputIdDownIgnoreGamepadModifier(InputId input_id);
    // Same as `isInputIdPressed`, except `current_gamepad_modifier` doesn't need to match `inputId`
    [Sig("E8 ?? ?? ?? ?? 84 C0 0F 84 ?? ?? ?? ?? 48 8B 03 48 8B CB FF 50 68", FirstMatch, Offset(1), Rel32)] bool isInputIdPressedIgnoreGamepadModifier(InputId input_id);
    // Axis 3 and 4 are the movement stick X and Y, scaled to -100..100.
    [Sig("E8 ?? ?? ?? ?? BA 01 00 00 00 49 8B CD 44 8B F8", FirstMatch, Offset(1), Rel32)] i32 getAxisInput(i32 axis);
    [Sig("E8 ?? ?? ?? ?? 33 FF 0F B6 DB", FirstMatch, Offset(1), Rel32)] Keybind* getKeybind(InputId input_id);
}

