bitfield KeyModifierFlag : u8 {
    [Bit(0)] bool shift;
    [Bit(1)] bool ctrl;
    [Bit(2)] bool alt;
    // none is none of them
}

[Size(0x2)]
struct KeySetting {
    [0x0] SeVirtualKey key;
    // One of key_modifier, gamepad_modifier
    [0x1] KeySetting.ModifierUnion Modifier;
}

bitfield KeyStateFlags : u32 {
    [Bit(0)] bool down;
    [Bit(1)] bool pressed;
    [Bit(2)] bool released;
    [Bit(3)] bool held;
    // none is none of them
}

[Size(0xB)]
struct Keybind {
    [0x0] KeySetting[2] key_settings;
    [0x4] KeySetting[2] gamepad_settings;
    [0x8] u16 unk8;
    [0xA] u8 unk_a;
}

[Size(0x40)]
struct KeyboardDevice : KeyboardDeviceInterface {
    // Inherited parent class accessor for `RepeatCounter`
    [0x8] RepeatCounter repeat_counter;
    [0x28] Framework.GameWindow* game_window;
    [0x30] bool is_keyboard_connected;
    [0x38] Threading.Thread* unk_thread;
    [Sig("48 89 5C 24 ?? 55 56 57 41 56 41 57 48 8D 6C 24 ?? 48 81 EC ?? ?? ?? ?? 48 8B 05 ?? ?? ?? ?? 48 33 C4 48 89 45 ?? 4D 8B F9", FirstMatch)] static void processKeyboardInputMessage(isize h_wnd, u32 u_msg, isize w_param, isize l_param);
}

[Size(0x8)]
struct KeyboardDeviceInterface {
    [0x0] void* virtual_table;
    [Virtual(0)] KeyboardDeviceInterface* dtor(u8 free_flags);
    [Virtual(1)] bool initialize();
    [Virtual(2)] void update(f32 dt);
    [Virtual(3)] void deinitialize();
    [Virtual(4)] KeyboardInputData* getData();
    [Virtual(5)] void resetState(bool clear_down);
    [Virtual(6)] void sendKey(SeVirtualKey key);
    [Virtual(7)] bool getIsKeyboardConnected();
}

[Size(0x494)]
struct KeyboardInputData {
    [0x4] KeyStateFlags[159] key_state;
    [0x285] u8 key_held_keycode;
    [0x288] u8 last_key_char_key_code;
    [0x290] u16 last_key_char;
}

bitfield MouseButtonFlags : u32 {
    [Bit(0)] bool lbutton;
    [Bit(1)] bool mbutton;
    [Bit(2)] bool rbutton;
    [Bit(3)] bool xbutton1;
    [Bit(4)] bool xbutton2;
    // none is none of them
}

[Size(0x48)]
struct MouseDevice : MouseDeviceInterface {
    // Inherited parent class accessor for `RepeatCounter`
    [0x8] RepeatCounter repeat_counter;
    [0x30] void* direct_input_device;
    [0x38] bool is_acquired;
    [0x40] Framework.GameWindow* game_window;
    [Sig("48 89 5C 24 ?? 48 89 74 24 ?? 57 48 83 EC ?? 49 8B D8 C6 05", FirstMatch)] static void processMouseInputMessage(isize h_wnd, u32 u_msg, isize w_param);
    // Schedules the cursor to move to the specified coordinates on the next mouse device update.
    [Sig("89 0D ?? ?? ?? ?? 89 15 ?? ?? ?? ?? C6 05 ?? ?? ?? ?? 01 C3", FirstMatch)] static void scheduleCursorMove(i32 x, i32 y);
}

