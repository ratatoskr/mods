// since this is written again.

namespace Client.System.Photo;

[Size(0x288)]
struct ScreenShot : Framework.Task {
    [0x38] ScreenShot.ScreenShotThread* thread_ptr;
    // Controls whether the game will let the player take a screenshot.
    [0x40] bool can_take_screen_shot;
    // Set to true when a screenshot has been enqueued.
    [0x41] bool screen_shot_requested;
    [0x48] void* callback_param;
    [0x50] isize event_handle;
    [0x5C] ScreenShot.ScreenShotResultCode screen_shot_result;
    // The timestamp of the last screenshot.
    [0x60] i64 screen_shot_timestamp;
    // The function to be called when a screenshot is completed. Set to null after being called.
    [0x68] void* screen_shot_callback_func;
    // The file format that screenshots should be taken in. Set by config key ScreenShotImageType on
    // scheduling.
    [0x70] ScreenShot.TargetFileFormat screen_shot_file_format;
    // The location that the last screenshot was written to.
    [0x78] File.FileAccessPath screen_shot_location;
    [Sig("48 8B 1D ?? ?? ?? ?? 48 85 DB 74 ?? 41 B0", FirstMatch, Offset(3), Rel32)] static ScreenShot* instance;
    [Sig("E8 ?? ?? ?? ?? 84 C0 75 15 C6 05", FirstMatch, Offset(1), Rel32)] bool scheduleScreenShot(void* callback, void* callback_param);
}

namespace ScreenShot {
    enum ScreenShotResultCode : i32 {
        success = 0,
        no_disk_space = 1,
    }

    [Size(0x288)]
    struct ScreenShotThread {
        [0x28] TargetFileFormat target_file_format;
        [0x38] ScreenShot* parent;
        [0x50] u8[40] critical_section;
        [0x78] File.FileAccessPath screen_shot_storage_directory;
    }

    enum TargetFileFormat : i32 {
        bmp = 0,
        jpg = 1,
        png = 3,
        dds = 4,
    }
}
