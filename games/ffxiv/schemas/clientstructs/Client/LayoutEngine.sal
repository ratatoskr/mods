    [Sig("E9 ?? ?? ?? ?? 48 89 5C 24 ?? 48 8D 0C AD", FirstMatch, Offset(1), Rel32)] void setFixture(u32 part, u32 fixture, u32 a4);
    [Sig("E8 ?? ?? ?? ?? EB 27 48 81 C3 ?? ?? ?? ??", FirstMatch, Offset(1), Rel32)] void setFixtureStain(u32 part, u8 stain);
}

