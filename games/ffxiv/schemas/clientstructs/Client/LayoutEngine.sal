// An instance of a loaded level. Ultimately describes a set of 'instances' (pieces of static geometry,
// lights, vfx, etc), organized in layers.
[Size(0xC60)]
struct LayoutManager : IManagerBase {
    [0x18] i32 init_state;
    [0x1C] i32 type;
    [0x20] u32 territory_type_id;
    [0x24] u32 cfc_id;
    [0x28] u32 layer_filter_key;
    [0x38] u32 festival_status;
    [0x3D] bool inside_festival_transition_layer_update;
    [0x40] Game.GameMain.Festival[8] active_festivals;
    [0x60] Game.GameMain.Festival[8] new_festivals;
    [0x80] f32 festival_layers_add_timer;
    [0x84] f32 festival_layers_remove_timer;
    [0x88] void* streaming_manager;
    [0x90] void* environment;
    [0x98] void* ob_set_manager;
    [0xA0] OutdoorAreaLayoutData* outdoor_area_data;
    [0xA8] OutdoorExteriorLayoutData* outdoor_exterior_data;
    [0xB0] IndoorAreaLayoutData* indoor_area_data;
    [0xE8] void* pvp_data;
    [0xFC] i32 force_update_all_streaming;
    [0x102] bool skip_adding_terrain_collider;
    [0x104] bool housing_layout_data_update_pending;
    [0x105] bool outdoor_area_data_updated;
    [0x10A] u8 layer_entry_type;
    [0x10C] u32 level_id;
    [0x110] i32 streaming_origin_type;
    [0x120] Vec3 forced_streaming_origin;
    [0x140] Vec3 last_updated_streaming_origin;
    [0x190] i32 housing_type;
    [0x1A4] f32 last_update_dt;
    [0x1A8] i32 last_update_odd;
    [0x1C0] StringTable resource_paths;
    [0x1E0] System.Resource.Handle.ResourceHandle* lvb_resource_handle;
    [0x1E8] STD.StdVector<System.Resource.Handle.ResourceHandle*> layer_group_resource_handles;
    [0x218] STD.StdMap<u32, Terrain.TerrainManager*> terrains;
    [0x228] STD.StdMap<u16, Layer.LayerManager*> layers;
    [0x238] STD.StdVector<Layer.LayerManager*> festival_layers_to_remove;
    [0x250] STD.StdVector<Layer.LayerManager*> festival_layers_to_add;
    [0x268] STD.StdMap<InstanceType, STD.StdMap<u64, ILayoutInstance*>*> instances_by_type;
    [0x278] STD.StdMap<u32, RefCountedString*> crc_to_path;
    [0x288] STD.StdMap<LayoutManager.AnalyticShapeDataKey, AnalyticShapeData> crc_to_analytic_shape_data;
    [0x298] STD.StdMap<u32, LayoutManager.Filter*> filters;
    [0x308] System.Resource.Handle.ResourceHandle* svb_resource_handle;
    [0x310] System.Resource.Handle.ResourceHandle* lcb_resource_handle;
    [0x318] System.Resource.Handle.ResourceHandle* uwb_resource_handle;
    [Sig("48 89 5C 24 ?? 48 89 6C 24 ?? 48 89 74 24 ?? 57 48 83 EC ?? 4C 8B 91 ?? ?? ?? ?? 49 8B F9", FirstMatch)] void setOutdoorPlotExterior(i32 plot_index, OutdoorPlotExteriorData* data, void* loaded_callback);
    [Sig("40 53 45 33 D2 4C 8D 41 40", FirstMatch)] void setActiveFestivals(Game.GameMain.Festival* festivals);
}

// Root level manager for 'layouts' (loaded levels with static geometry).
[Size(0x240)]
struct LayoutWorld : IManagerBase {
    [0x18] LayoutManager* global_layout;
    [0x20] LayoutManager* active_layout;
    [0x30] LayoutManager* prefetch_layout;
    [0x38] void* cutscene_prefetch_resource;
    [0x68] i64 milliseconds_since_last_update;
    [0x80] STD.StdMap<u64, LayoutManager*> loaded_layouts;
    [0xA0] f32[94] streaming_radius_per_type;
    [0x228] STD.StdMap<System.String.Utf8String, cstring>* rsv_map;
    [0x230] STD.StdMap<u64, u8*>* rsf_map;
    [Sig("48 8B D1 48 8B 0D ?? ?? ?? ?? 48 85 C9 74 0A", FirstMatch, Offset(6), Rel32)] static LayoutWorld* instance;
    [Sig("E8 ?? ?? ?? ?? 48 89 47 ?? 0F 57 C0", FirstMatch, Offset(1), Rel32)] static ILayoutInstance* getLayoutInstanceStatic(InstanceType instance_type, u32 instance_id, u32 sub_id);
    [Sig("E8 ?? ?? ?? ?? 48 8B F0 48 85 C0 74 ?? 8B 90", FirstMatch, Offset(1), Rel32)] static ILayoutInstance* getColliderLayoutInstance(InstanceType instance_type, Common.Component.BGCollision.Collider* collider);
    [Sig("E8 ?? ?? ?? ?? 45 33 F6 44 89 B7", FirstMatch, Offset(1), Rel32)] static void unloadPrefetchLayout();
    // Tries to get it from `active_layout` first, then from `global_layout`.
    [Sig("E8 ?? ?? ?? ?? 48 85 C0 0F 84 ?? ?? ?? ?? 48 8B 10 48 8B C8 FF 92 ?? ?? ?? ?? 8B 4E 04", FirstMatch, Offset(1), Rel32)] ILayoutInstance* getLayoutInstance(InstanceType instance_type, u32 instance_id, u32 sub_id);
    // `festivals` is a pointer to an array of 4 `Festival`s.
    [Sig("48 89 5C 24 ?? 48 89 6C 24 ?? 56 57 41 56 48 81 EC ?? ?? ?? ?? 48 8B 05 ?? ?? ?? ?? 48 33 C4 48 89 84 24 ?? ?? ?? ?? 48 8B 41 20", FirstMatch)] void loadPrefetchLayout(i32 type, cstring bg_name, u8 layer_entry_type, u32 level_id, u32 territory_type_id, Game.GameMain.Festival* festivals, u32 cfc_id);
    [Sig("48 89 5C 24 ?? 48 89 74 24 ?? 57 48 81 EC ?? ?? ?? ?? 48 8B 05 ?? ?? ?? ?? 48 33 C4 48 89 84 24 ?? ?? ?? ?? 48 83 B9 ?? ?? ?? ?? ?? 48 8B F1", FirstMatch)] cstring resolveRsvString(cstring rsv_string);
    [Sig("40 53 55 56 57 41 54 41 55 41 56 41 57 48 81 EC ?? ?? ?? ?? 48 8B 05 ?? ?? ?? ?? 48 33 C4 48 89 84 24 ?? ?? ?? ?? 4D 8B E0", FirstMatch)] bool addRsvString(cstring rsv_string, u8* resolved_string, usize resolved_string_size);
    [Sig("4C 8B 81 ?? ?? ?? ?? 4D 85 C0 74 45", FirstMatch)] u8* resolveRsfEntry(u64 index_hash);
    [Sig("48 89 5C 24 ?? 48 89 6C 24 ?? 48 89 74 24 ?? 48 89 7C 24 ?? 41 56 48 83 EC 50 48 8B 99", FirstMatch)] bool addRsfEntry(u64 index_hash, u8* rsf_data);
    // Used for previewing fixtures in the 'Remodel Interior' interface.
    [Sig("48 89 5C 24 ?? 48 89 6C 24 ?? 48 89 74 24 ?? 57 41 56 41 57 48 83 EC ?? 48 8B 05 ?? ?? ?? ?? 41 8B F1", FirstMatch)] static i32 setInteriorFixture(u32 floor, u32 part, i16 a3, i32 fixture_id, i8 stain);
}

[Size(0x7080)]
struct OutdoorAreaLayoutData {
