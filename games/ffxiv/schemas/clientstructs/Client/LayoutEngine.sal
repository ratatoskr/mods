    [Virtual(6)] i32 getSizeOf();
    [Virtual(7)] cstring getPrimaryPath();
    [Virtual(13)] Common.Math.SphereBounds* getSphereBounds(Common.Math.SphereBounds* out_sphere_bounds);
    [Virtual(14)] Vec3* getTranslation(Vec3* result);
    [Virtual(15)] Quat* getRotation(Quat* result);
    [Virtual(16)] Vec3* getScale(Vec3* result);
    [Virtual(17)] Transform* getTransform(Transform* result);
    [Virtual(18)] void setTransform(Transform* transform);
    [Virtual(21)] bool havePrimary();
    // If the primary object has been loaded.
    [Virtual(22)] bool isPrimaryLoaded();
    [Virtual(23)] Graphics.Scene.Object* getGraphics();
    [Virtual(24)] Graphics.Scene.Object* getGraphics2();
    [Virtual(25)] void setGraphics(Graphics.Scene.Object* obj, Transform* transform);
    [Virtual(27)] void createPrimary(Transform* transform, void* path_or_type);
    [Virtual(28)] void destroyPrimary();
    [Virtual(29)] bool haveSecondary();
    [Virtual(30)] bool isColliderLoaded();
    [Virtual(31)] cstring getSecondaryPath();
    [Virtual(32)] void createSecondary();
    [Virtual(33)] void destroySecondary();
    [Virtual(34)] Common.Component.BGCollision.Collider* getCollider();
    [Virtual(35)] Common.Component.BGCollision.Collider* getCollider2();
    [Virtual(36)] bool isColliderActive();
    [Virtual(37)] void setColliderActive(bool active);
    [Virtual(38)] void updateCollider();
    [Virtual(45)] void getColor(Vec4* color);
    [Virtual(46)] void setColor(Vec4* color);
    [Virtual(55)] bool wantToBeActive();
    [Virtual(58)] void applyStain(Graphics.ByteColor* stain_color_srgb);
    [Virtual(63)] void setActive(bool active);
    [Virtual(64)] Vec3* getTranslationImpl();
    [Virtual(65)] void setTranslationImpl(Vec3* value);
    [Virtual(66)] Quat* getRotationImpl();
    [Virtual(67)] void setRotationImpl(Quat* value);
    [Virtual(68)] Vec3* getScaleImpl();
    [Virtual(69)] void setScaleImpl(Vec3* value);
    [Virtual(70)] Transform* getTransformImpl();
    [Virtual(71)] void setTransformImpl(Transform* value);
    [Virtual(72)] Vec4* getBoundingSphereImpl(Vec4* result);
    [Virtual(73)] Common.Math.AxisAlignedBounds* getAxisAlignedBoundsImpl(Common.Math.AxisAlignedBounds* out_aligned_bounds);
    [Virtual(74)] Common.Math.OrientedBounds* getOrientedBoundsImpl(Common.Math.OrientedBounds* out_oriented_bounds);
    // If we have a primary object and its been loaded. Basically HavePrimary() and IsPrimaryLoaded() in
    // one call.
    [Sig("E8 ?? ?? ?? ?? 3C ?? 75 ?? 8B D5", FirstMatch, Offset(1), Rel32)] bool isPrimaryReady();
}

