[Size(0x1)]
struct HouseUnit {
    // Masked data: - `0b1000_0000` (`0x80`) = Apartment Flag - `0b0111_1111` (`0x7F`) = Apartment Division
    // (only if Apartment Flag is `true`) - `0b0111_1111` (`0x7F`) = PlotIndex (only if Apartment Flag is
    // `false`)
    [0x0] u8 value { [Bit(0)] u8 apartment_division : 7; }
}

