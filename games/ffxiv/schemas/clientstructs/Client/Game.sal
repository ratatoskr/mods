[Size(0x88)]
struct NpcYellBalloon {
    // The text that this balloon will display. Empty when balloon is `inactive`.
    [0x0] System.String.Utf8String text;
    // Pointer to the `Character` that contains this balloon.
    [0x68] Character.Character* character;
    // How much longer (in seconds) the balloon should remain open. Starting value set by OpenBalloon.
    // Starts counting down once in `active` state. If this is set to zero before the balloon is activated,
    // the balloon will remain open indefinitely, subject to the value of `close_type`.
    [0x70] f32 play_timer;
    // How much longer (in seconds) before the balloon should actually be opened with AgentScreenLog.
    // Starting value is set by OpenBalloon. Resets to one second when balloon exits `waiting` state.
    [0x74] f32 delay_time;
    // The balloon's current state.
    [0x78] NpcYellBalloonState state;
    // Controls how the balloon determines when to close. If OpenBalloon's reducedCloseChecks parameter is
    // true, this is `reduced_close_checks`, else if playTime is zero this is `hold_open`, else this is
    // `normal`.
    [0x7C] NpcYellBalloonCloseType close_type;
    // The bone index to which the balloon is attached on the character.
    [0x80] u8 parent_bone;
    // Miscellaneous balloon behaviors.
    [0x81] NpcYellBalloonFlags flags;
    // Prepares the balloon to be opened during the next applicable Update.
    [Sig("E8 ?? ?? ?? ?? 0F 28 B4 24 ?? ?? ?? ?? 48 8D 4D", FirstMatch, Offset(1), Rel32)] void openBalloon(cstring str, f32 play_time, bool soft_open, f32 open_delay, bool print_to_log, bool reduced_close_checks, bool ignore_range_check, u8 parent_bone);
    // Closes and resets the balloon. Only required if balloon is set to hold open (or needs to be closed
    // early).
    [Sig("E8 ?? ?? ?? ?? 66 3B BB ?? ?? ?? ?? 75", FirstMatch, Offset(1), Rel32)] void closeBalloon();
}

enum NpcYellBalloonCloseType : i32 {
    // Performs normal timer checks every active update cycle.
    normal = 0,
    // Ignore `play_timer` and hold open indefinitely until `closeBalloon` is called.
    hold_open = 1,
    // Similar to `normal`, but skips some non-`play_timer` checks.
    reduced_close_checks = 2,
}

bitfield NpcYellBalloonFlags : u8 {
    // All balloons will have this flag while in use. If this is not set, the balloon will not be opened
    // (or will be immediately closed).
    [Bit(0)] bool valid;
    // The balloon fades in instead of opening with a "pop". Is passed as the bool third parameter to
    // AgentScreenLog::OpenBalloon, and probably has the same effect as the Balloon EXD's boolean "Slowly"
    // column.
    [Bit(1)] bool soft_open;
    // Call AgentScreenLog::OpenBalloon regardless of character range test result.
    [Bit(2)] bool ignore_range_check;
    // Also call RaptureLogModule::PrintMessage with balloon text when the balloon is opened.
    [Bit(3)] bool print_to_log;
    // none is none of them
}

enum NpcYellBalloonState : i32 {
    // Balloon is inactive and in the default state.
    inactive = 0,
    // Balloon is waiting to open (until `delay_time` expires).
    waiting = 1,
    // Balloon is open.
    active = 2,
    // Balloon is attempting to open.
    activating = 3,
}

