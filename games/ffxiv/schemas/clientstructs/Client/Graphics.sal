// Parallel-for over items appended by any thread through its `Writer`. Items go into blocks (u32 item
// count, then the items from +0x10), 32 blocks per chunk, item size depending on Job. Running it
// schedules `job_list`, helps on the calling thread, then waits for the list.
[Size(0xC0)]
struct JobSystem {
    [0x8] JobSystem.Writer* writers;
    [0x10] u32 writer_count;
    [0x14] u32 next_writer;
    // `writer_count` - 1 tasks, each a help call.
    [0x18] System.Framework.JobListArgArrayAndIndex* job_list;
    [0x20] void* callback_this_arg;
    [0x28] void* callback_function;
    [0x30] u32*[16] block_chunks;
    [0xB0] u32 block_count;
    [0xB4] u32 next_block;
    [0xB8] u32 next_item;
    // Helpers claim single items instead of whole blocks.
    [0xBC] bool claim_per_item;
}

