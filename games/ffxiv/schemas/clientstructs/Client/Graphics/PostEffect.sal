// NGX state and the render sizes of the DLSS quality modes.
[Size(0x188)]
struct Dlss {
    // Indexed by NGX PerfQualityValue: Performance, Balanced, Quality, Ultra Performance, Ultra Quality,
    // DLAA.
    [0x0] Dlss.QualityMode[6] quality_modes;
    // Render sizes by `value` for the output size of the last query.
    [0x90] STD.StdMap<i32, Dlss.RenderSettings> render_settings_by_mode;
    // Settings for the next evaluation.
    [0xA0] Dlss.Settings requested;
    // Settings the feature was created with. It is released when `requested` differs.
    [0xCC] Dlss.Settings applied;
    // Output size of the last query. Both are 0xFFFFFFFF when there is none.
    [0x150] u32 queried_output_width;
    [0x154] u32 queried_output_height;
    [0x158] void* ngx_parameters;
    [0x160] void* ngx_feature;
    [0x181] DlssFlags flags;
    [Sig("E8 ?? ?? ?? ?? EB 03 49 8B C7 48 89 87 ?? ?? ?? ?? 48 8D 0D ?? ?? ?? ??", FirstMatch, Offset(1), Rel32)] void ctor();
    // Releases the NGX feature and parameters and shuts NGX down.
    [Sig("E8 ?? ?? ?? ?? 32 C0 48 83 C4 38 41 5E 5F", FirstMatch, Offset(1), Rel32)] void shutdown();
    // Fills `requested` for `output_size` (width, height) from `dlss_quality`.
    [Sig("40 57 41 56 48 83 EC 38 F6 81 ?? ?? ?? ?? ??", FirstMatch)] bool updateSettings(u32* output_size, bool unk);
    // Queries NGX for the render sizes of every mode at `output_size` (width, height).
    [Sig("E8 ?? ?? ?? ?? 4C 8B 05 ?? ?? ?? ?? 45 33 E4", FirstMatch, Offset(1), Rel32)] void queryRenderSettings(u32* output_size);
    // Releases the NGX feature. The next evaluation creates it again.
    [Sig("E8 ?? ?? ?? ?? 0F B6 87 ?? ?? ?? ?? 0F 10 06", FirstMatch, Offset(1), Rel32)] void releaseFeature();
}

bitfield DlssFlags : u8 {
    [Bit(0)] bool ngx_initialized;
    [Bit(1)] bool feature_created;
    // none is none of them
}

