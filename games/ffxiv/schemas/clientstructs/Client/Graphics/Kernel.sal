// Contains blending configuration for the renderer. Rather than manage a bunch of pointers to blend
// state objects, render commands accept a description of the desired blend state packed into 32 bits,
// which is copied around by value and eventually a real D3D blend state object is created within the
// `ImmediateContext` as needed.
[Size(0x4)]
struct PackedBlendStateDesc {
    [0x0] u32 value { [Bit(0)] bool blend_enable; [Bit(1)] u8 blend_op_minus_one : 3; [Bit(4)] u8 src_blend_minus_one : 4; [Bit(8)] u8 dest_blend_minus_one : 4; [Bit(12)] u8 blend_op_alpha_minus_one : 3; [Bit(15)] u8 src_blend_alpha_minus_one : 4; [Bit(19)] u8 dest_blend_alpha_minus_one : 4; [Bit(23)] u8 render_target_write_mask : 4; }
}

// Contains depth stencil configuration for the renderer. Rather than manage a bunch of pointers to
// depth stencil objects, render commands accept a description of the desired depth stencil state
// packed into 64 bits, which is copied around by value and eventually a real D3D depth stencil object
// is created within the `ImmediateContext` as needed.
[Size(0x8)]
struct PackedDepthStencilDesc {
    [0x0] u32 first_part { [Bit(0)] bool depth_enable; [Bit(1)] bool depth_write_mask; [Bit(2)] u8 depth_func_minus_one : 3; [Bit(13)] u8 back_face_stencil_func_minus_one : 3; [Bit(16)] u8 back_face_stencil_fail_op_minus_one : 3; [Bit(19)] u8 back_face_stencil_depth_fail_op_minus_one : 3; [Bit(22)] u8 back_face_stencil_pass_op_minus_one : 3; [Bit(25)] bool stencil_enable; [Bit(26)] u8 front_face_stencil_func_minus_one : 3; [Bit(29)] u8 front_face_stencil_fail_op_minus_one : 3; }
    [0x4] u8 second_part { [Bit(1)] bool back_face_stencil_independent; [Bit(2)] u8 front_face_stencil_depth_fail_op_minus_one : 3; [Bit(5)] u8 front_face_stencil_pass_op_minus_one : 3; }
    [0x5] u8 stencil_ref;
    [0x6] u8 stencil_read_mask;
    [0x7] u8 stencil_write_mask;
}

// Contains rasterization configuration for the renderer. Rather than manage a bunch of pointers to
// rasterizer state objects, render commands accept a description of the desired rasterizer state
// packed into 32 bits, which is copied around by value and eventually a real D3D rasterizer state
// object is created within the `ImmediateContext` as needed.
[Size(0x4)]
struct PackedRasterizerStateDesc {
    [0x0] u32 value { [Bit(0)] u8 fill_mode : 2; [Bit(2)] bool has_cull_mode; [Bit(3)] u8 cull_mode_bit : 1; [Bit(4)] bool scissor_enable; [Bit(5)] u16 depth_bias_half : 16; [Bit(21)] u16 slope_scaled_depth_bias_quantized : 10; }
}

