// Kernel resources link themselves into one global list, walked twice per frame by
// DeviceDX11.PostTick: `endFrame` on every notifier before Present, `beginFrame` after the buffer
// index advances.
[Size(0x18)]
struct Notifier : NotifierBase {
    [0x8] Notifier* next;
    [0x10] Notifier* prev;
    // Newest notifier, the walks follow `prev` from here.
    [Sig("48 8D 0D ?? ?? ?? ?? FF 15 ?? ?? ?? ?? 48 8B 1D ?? ?? ?? ?? 48 85 DB 74 ?? 48 8B 03 48 8B CB FF 50 10", FirstMatch, Offset(16), Rel32)] static Notifier* list_head;
    // Dynamic buffers map their slot for the new buffer index (0-2).
    [Virtual(1)] void beginFrame();
    // Dynamic buffers unmap, constant buffers upload their staged data.
    [Virtual(2)] void endFrame();
    // Inserts at the head of the list.
    [Sig("E8 ?? ?? ?? ?? 41 0F B6 C5 E9", FirstMatch, Offset(1), Rel32)] void link();
    [Sig("E8 ?? ?? ?? ?? 45 33 F6 48 8D 5E", FirstMatch, Offset(1), Rel32)] void unlink();
}

