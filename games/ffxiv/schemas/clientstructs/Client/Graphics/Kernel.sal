    [Sig("E8 ?? ?? ?? ?? 8B 6E 6C", FirstMatch, Offset(1), Rel32)] void pushBackCommand(void* command);
    [Sig("E8 ?? ?? ?? ?? 8B D6 41 B8", FirstMatch, Offset(1), Rel32)] void setRenderTargets(i32 render_target_count, Texture** render_target_textures, Texture* depth_stencil_texture, i16 a4, i16 a5, i16 a6, i16 a7);
}

