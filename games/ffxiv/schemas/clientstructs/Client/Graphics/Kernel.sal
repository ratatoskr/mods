bitfield TextureFlags : u32 {
    [Bit(0)] bool discard_per_frame;
    [Bit(1)] bool discard_per_map;
    [Bit(2)] bool managed;
    [Bit(3)] bool user_managed;
    [Bit(4)] bool cpu_read;
    [Bit(5)] bool location_main;
    [Bit(6)] bool no_gpu_read;
    [Bit(7)] bool aligned_size;
    [Bit(8)] bool edge_culling;
    [Bit(9)] bool location_onion;
    [Bit(10)] bool read_write;
    [Bit(11)] bool immutable;
    [Bit(12)] bool keep_cpu_copy;
    [Bit(20)] bool texture_render_target;
    [Bit(21)] bool texture_depth_stencil;
    [Bit(22)] bool texture_type1_d;
    [Bit(23)] bool texture_type2_d;
    [Bit(24)] bool texture_type3_d;
    [Bit(28)] bool texture_type2_d_array;
    [Bit(25)] bool texture_type_cube;
    [Bit(26)] bool texture_swizzle;
    [Bit(27)] bool texture_no_tiled;
    [Bit(31)] bool texture_no_swizzle;
    // texture_type_cube_array is 0x12000000, texture_type_cube and texture_type2_d_array
    // texture_type_mask is 0x13C00000, texture_type1_d and texture_type2_d and texture_type3_d and texture_type_cube and texture_type2_d_array
}

enum TextureFormat : u32 {
    l8_unorm = 4400,
    a8_unorm = 4401,
    r8_unorm = 4402,
    r8_uint = 4403,
    r16_uint = 4416,
    r32_uint = 4432,
    r8_g8_unorm = 4672,
    b4_g4_r4_a4_unorm = 5184,
    b5_g5_r5_a1_unorm = 5185,
    b8_g8_r8_a8_unorm = 5200,
    b8_g8_r8_x8_unorm = 5201,
    r16_float = 8512,
    r32_float = 8528,
    r16_g16_float = 8784,
    r32_g32_float = 8800,
    r11_g11_b10_float = 9040,
    r16_g16_b16_a16_float = 9312,
    r32_g32_b32_a32_float = 9328,
    bc1_unorm = 13344,
    bc2_unorm = 13360,
    bc3_unorm = 13361,
    // Can also be R16_TYPELESS or R16_UNORM depending on context.
    d16_unorm = 16704,
    // Can also be R24G8_TYPELESS or R24_UNORM_X8_TYPELESS depending on context.
    d24_unorm_s8_uint = 16976,
    // Can also be R16_TYPELESS or R16_UNORM depending on context.
    d16_unorm_2 = 20800,
    // Can also be R24G8_TYPELESS or R24_UNORM_X8_TYPELESS depending on context.
    d24_unorm_s8_uint_2 = 20816,
    bc4_unorm = 24864,
    bc5_unorm = 25136,
    bc6_h_sf16 = 25392,
    bc7_unorm = 25650,
    r16_unorm = 28992,
    r16_g16_unorm = 29264,
    r10_g10_b10_a2_unorm_2 = 29520,
    r10_g10_b10_a2_unorm = 29776,
    // Can also be R24G8_TYPELESS or R24_UNORM_X8_TYPELESS depending on context.
    d24_unorm_s8_uint_3 = 33360,
}

[Size(0x10)]
struct TextureMapResult {
    [0x0] u32 row_pitch;
    [0x4] u32 depth_pitch;
    [0x8] void* data;
}

[Size(0x40)]
struct TextureMipRenderTarget {
    [0x0] void* d3_d11_render_target_view_or_depth_stencil_view;
}

[Size(0x78)]
struct VertexShader : PVShader {
    [0x60] VertexShader.Input declared_inputs;
    [0x64] VertexShader.Input used_inputs;
    [0x68] u8* dxbc_blob;
    [0x70] void* direct_x_object;
}

namespace Device {
    [Size(0x40)]
    struct CallbackManager {
        [0x8] void* lock;
        [0x30] CallbackManager.Entry* entries;
        [0x38] u32 capacity;
        [0x3C] u32 count;
        [Sig("48 89 5C 24 ?? 48 89 6C 24 ?? 48 89 74 24 ?? 48 89 7C 24 ?? 41 56 48 83 EC ?? 48 8B F1 49 8B E8 48 83 C1", FirstMatch)] i32 addCallback(void* func, void* context);
        [Sig("48 89 5C 24 ?? 48 89 74 24 ?? 57 48 83 EC ?? 48 8B F1 8B FA 48 83 C1 ?? FF 15", FirstMatch)] void removeCallback(i32 index);
        [Sig("E8 ?? ?? ?? ?? 48 8B 5B ?? 48 8B 4B", FirstMatch, Offset(1), Rel32)] bool executeCallbacks();
    }
}

namespace Device.CallbackManager {
    [Size(0x10)]
    struct Entry {
        [0x0] void* function;
        [0x8] void* context;
    }
}

namespace PVShader {
    [Size(0x8)]
    struct ResourceEntry {
        [0x0] u16 slot;
        // For constants : size, in 4-float registers. For others : seems unused.
        [0x2] u16 size;
        // Cross-reference this with `id`.
        [0x4] u32 id;
    }
}

namespace RenderCommandBufferGroup {
    union RenderCommandUnion {
        RenderCommand* command;
        RenderCommandSetTarget* set_target_command;
        RenderCommandViewport* viewport_command;
        RenderCommandScissorsRect* scissors_rect_command;
        RenderCommandClear* clear_command;
        RenderCommandSetSaveTextureFilePath* set_save_texture_file_path_command;
    }
}

namespace ShaderNode {
    [Size(0x8)]
    struct ShaderPass {
        [0x0] u32 vertex_shader;
        [0x4] u32 pixel_shader;
    }
}

namespace ShaderPackage {
    [Size(0xC)]
    struct ConstantSamplerUnknown {
        [0x0] u32 crc;
        // Cross-reference this with `id` and `id`.
        [0x4] u32 id;
        // For constants : size, in 4-float registers. For others : seems unused.
        [0x8] u16 size;
        [0xA] u16 slot;
    }

    [Size(0x8)]
    struct MaterialElement {
        [0x0] u32 crc;
        [0x4] u16 offset;
        [0x6] u16 size;
    }
}

namespace VertexShader {
    bitfield Input : u32 {
        [Bit(0)] bool position;
        [Bit(1)] bool blend_weight;
        [Bit(2)] bool normal;
        [Bit(3)] bool color0;
        [Bit(4)] bool color1;
        [Bit(5)] bool fog;
        [Bit(6)] bool p_size;
        [Bit(7)] bool blend_indices;
        [Bit(8)] bool tex_coord0;
        [Bit(9)] bool tex_coord1;
        [Bit(10)] bool tex_coord2;
        [Bit(11)] bool tex_coord3;
        [Bit(12)] bool tex_coord4;
        [Bit(13)] bool tex_coord5;
        [Bit(14)] bool tangent;
        [Bit(15)] bool binormal;
        [Bit(16)] bool depth;
    }
}
