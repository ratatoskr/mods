// Value of `dlss_quality`. 1 to 6 select an NGX quality mode, other values make `updateSettings` fail.
enum DlssQualityPreset : u8 {
    // Picks a mode from the output pixel count: DLAA below 2,073,600 (1920x1080), Quality up to 3,686,400
    // (2560x1440), Performance up to 8,294,400 (3840x2160), Ultra Performance above.
    automatic = 0,
    dlaa = 1,
    ultra_quality = 2,
    quality = 3,
    balanced = 4,
    performance = 5,
    ultra_performance = 6,
}

