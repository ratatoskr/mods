    [Sig("40 53 55 41 54 48 83 EC 20 8B 0D ?? ?? ?? ?? 4C 8B E2 65 48 8B 04 25 ?? ?? ?? ?? BD 98 02 00 00", FirstMatch)] void appendSkeleton(Skeleton* skeleton);
