// The unpacked board is initially allocated and written to with `writeToUnpackedBoard` and then
// compressed via zlib. Useful Information:
// https://github.com/xivdev/file-formats/blob/main/imhex/stgy.hexpat
[Size(0x410)]
struct TofuPackedBoard {
    [0x0] u16 unpacked_size;
    [0x2] SharingType sharing_type;
    [0x3] u8[1037] data;
}

[Size(0x450)]
struct TofuPackedBoardShare {
    [0x0] TofuPackedBoard packed_board;
    [0x410] utf8[60] board_name;
    [0x44C] u32 unk44_c;
}

[Size(0x3238)]
struct TofuShareData {
    [0x0] u32[10] board_index;
    [0x28] u64 sender_content_id;
    [0x30] u32 folder_index;
    [0x34] u8 total_boards_in_shared_folder;
    [0x38] bool is_last_board_in_shared_folder;
    [0x40] TofuShareSession share_session;
}

[Size(0x31F8)]
struct TofuShareSession {
    [0x0] TofuBoardOverview[10] board_overviews;
    [0x550] TofuPackedBoardShare[10] boards;
    [0x3070] utf8[60] folder_name;
    [0x30AC] f32 send_cooldown_seconds;
    [0x30B0] SendState send_state;
    [0x30B4] u32 current_board_index;
    [0x30B8] u32 total_boards_in_shared_folder;
    [0x30C8] u64 current_share_content_id;
    [0x31B8] bool is_not_sending;
    [0x31C0] TofuHelper.TofuHelperData* data;
    [0x31D0] TofuHelper* tofu_helper;
    [0x31D8] UIModule* ui_module;
}

[Size(0x38)]
struct TofuShortObject {
    [0x0] utf8[32] text;
    // `A` is transparency, not alpha. It goes from `0` to `100` with `0` being visible.
    [0x20] Graphics.ByteColor rgba;
    [0x24] u16 pos_x;
    [0x26] u16 pos_y;
    [0x28] TofuObjectType object_type;
    [0x2A] TofuObjectFlags flags;
    [0x2C] u16 angle;
    [0x2E] u16 args_a;
    [0x30] u16 args_b;
    [0x32] u16 args_c;
    [0x34] u8 scale;
}

enum TofuType : u32 {
    saved = 1,
    shared = 2,
}

[Size(0x820)]
struct TofuUnpackedBoard {
    [0x0] u8 background;
    [0x1] u8 number_of_objects;
    [0x2] u8 number_of_text_objects;
    [Sig("E8 ?? ?? ?? ?? 85 C0 75 ?? 39 6C 24", FirstMatch, Offset(1), Rel32)] i32 readPackedBoard(i32* out_packet_size, u8* packed_data, i32 packed_data_length);
}

[Size(0x11)]
struct TofuUnpackedObject {
    [0x0] u16 bit_field0 { [Bit(0)] u16 pos_x : 13; [Bit(14)] bool has_text; [Bit(15)] bool is_negative_angle; }
    [0x2] u16 pos_y;
    [0x4] TofuObjectType object_type;
    [0x6] u16 arg_extra1;
    [0x8] u16 arg_extra2;
    [0xA] u16 arg_extra3;
    [0xC] u8 color_palette_index;
    [0xD] u8 transparency;
    [0xE] u8 scale;
    [0xF] u8 angle_raw;
    [0x10] bool is_visible;
}

