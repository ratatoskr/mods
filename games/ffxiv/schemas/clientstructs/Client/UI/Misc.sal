bitfield CrossHotbarFlags : u16 {
    [Bit(0)] bool change_set_active;
    [Bit(1)] bool active;
    [Bit(2)] bool left_side_toggle_focus;
    [Bit(3)] bool right_side_toggle_focus;
    [Bit(4)] bool left_side_hold_focus;
