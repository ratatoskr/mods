        [Bit(1)] bool unknown02;
        // Shows a red exclamation mark with message "The specified main arm was missing from your Armoury
        // Chest."
        [Bit(2)] bool main_hand_missing;
        // Is set when "Display Headgear" is ticked.
        [Bit(3)] bool headgear_visible;
        // Is set when "Display Sheathed Arms" is ticked.
        [Bit(4)] bool weapons_visible;
        // Is set when "Manually adjust visor (select gear only)." is ticked.
        [Bit(5)] bool visor_enabled;
        [Bit(6)] bool unknown40;
        [Bit(7)] bool unknown80;
