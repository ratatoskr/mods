namespace RaptureTextModule {
    enum FormatAddonTextApplyMode : i32 {
        // Returns the Addon text as is.
        raw = 0,
        // Formats the Addon text with the given LocalParameters.
        formatted = 1,
        // Formats the Addon text with the given LocalParameters and decodes the following macro (for example
        // for CounterNode, which uses a special font texture): - Wait macros are removed (an internal counter
        // goes up). - NonBreakingSpace macros are replaced with a normal space (0x20: ' '). - Hyphen macros
        // are replaced with a normal hyphen-minus (0x2D: '-').
        normalized = 2,
    }

