        [0x14] u8[5] materia_grades;
        [0x19] GearsetItemFlag flags;
    }

    bitfield GearsetItemFlag : u8 {
        // Shows a yellow exclamation mark with message "One or more items were missing from your Armoury
        // Chest."
        [Bit(0)] bool item_missing;
        [Bit(1)] bool unknown02;
        // Shows a gray exclamation mark with message "One or more items were not the specified color."
        [Bit(2)] bool color_differs;
        // Shows a gray exclamation mark with message "One or more items were not melded with the specified
        // materia."
        [Bit(3)] bool materia_differs;
        // Shows a gray exclamation mark with message "One or more items did not have the specified
        // appearance."
        [Bit(4)] bool appearance_differs;
        [Bit(5)] bool unknown20;
        [Bit(6)] bool unknown40;
        [Bit(7)] bool unknown80;
        // none is none of them
    }

    // A helper enum for easier access of GearsetItems in the ItemsSpan.
    enum GearsetItemIndex : i32 {
