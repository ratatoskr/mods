    [Size(0xE80)]
    struct Hotbar {
        [0x0] HotbarSlot[16] slots2;
    }

    [Size(0xE8)]
    struct HotbarSlot {
        [0x0] System.String.Utf8String pop_up_help;
        // The cost text to display on the slot when `cost_display_mode` is 2 or 4. This is generally used for
        // actions with a flexible MP cost (e.g. "All" for Flare), or "x 123" for items.
        [0x68] utf8[32] cost_text;
        [0x88] utf8[32] pop_up_keybind_hint;
        [0xA8] utf8[16] keybind_hint;
        [0xB8] u32 command_id;
        // This field is used to track the "base" action ID used for display purposes. Unlike
        // `apparent_action_id`, this value will not update with refreshes/combos. As such, it is used when an
        // action has been "upgraded", or for systems like PvP combos where the original action name is still
        // necessary. Curiously, this value does not apply to macros as their substitution happens much earlier
        // in the process.
        [0xBC] u32 original_apparent_action_id;
        // The action ID that is used to determine this hotbar slot's icon (and usually display text). This
        // field (and its related `apparent_slot_type`) allows a hotbar slot to have the appearance of one
        // action, but in reality trigger a different action. See also `original_apparent_action_id` for cases
        // where this field would be used.
        [0xC0] u32 apparent_action_id;
        // Mode-specific state used while resolving the current apparent action. For
        // `general_action_duty_or_phantom`, this is the GeneralAction row ID minus 26. For
        // `general_action_phantom`, this is the GeneralAction row ID minus 31. For `pv_p_combo`, this is the
        // current combo step. For `lost_finds_item`, this indicates that the action has been resolved.
        [0xC4] u16 apparent_action_mode_param;
        [0xC7] HotbarSlotType command_type;
        // The `HotbarSlotType` initially assigned to this hotbar slot for display purposes.
        [0xC8] HotbarSlotType original_apparent_slot_type;
        // The `HotbarSlotType` assigned to this hotbar slot for display purposes.
        [0xC9] HotbarSlotType apparent_slot_type;
        // Uses general drag-and-drop types for `type` instead of action-bar types. Set for Quick Panel slots.
        // For example, Action uses 7 instead of 48.
        [0xCA] bool uses_general_drag_drop_type;
        [0xCB] u8 cost_type;
        [0xCC] u8 cost_display_mode;
        // The current Icon ID (usually used in form `ui/icon/{ID}.tex`) that this hotbar slot should display.
        // Loaded with `loadIconId` based on information in `apparent_action_id`.
        [0xD0] u32 icon_id;
        // The "cost" of an action, usually in MP/TP/CP/GP or similar. The specific display type depends on the
        // value in `cost_type`. This value is normally shown in the bottom left of the hotbar slot. For items,
        // this contains the quantity currently present in the player's inventory.
        [0xD4] u32 cost_value;
        // The ID of the item that this hotbar slot contains a recipe for. This field may be used for other
        // purposes, but they have not been found yet.
        [0xD8] u32 recipe_item_id;
        // The CraftType of the recipe currently in this hotbar slot. This field may be used for other
        // purposes, but they have not been found yet.
        [0xDC] u32 recipe_craft_type;
        // A boolean representing if the recipe in this hotbar slot is valid or not. Set to 1 when the recipe
        // would result in a nonzero number of items. If not set, the game will indicate that the referenced
        // recipe has been deleted. This field may be used for other purposes, but they have not been found
        // yet.
        [0xE0] u8 recipe_valid;
        [0xE1] bool recipe_data_loaded;
        [0xE2] HotbarSlotApparentActionMode apparent_action_mode;
        // A boolean representing if this specific hotbar slot has been fully loaded. False for empty slots and
        // slots that have yet to be loaded in the UI. This appears to initialize as 0 and is set to 1 when the
        // hotbar slot appears on a visible hotbar. It will not reset if the slot is hidden (and subsequently
        // outdated).
        [0xE3] bool is_loaded;
        // Initialize the slot (specifically the utf8string, then clearing).
        [Sig("E8 ?? ?? ?? ?? 48 81 C6 E8 00 00 00 48 83 ED 01 75 ?? 49 8D B6", FirstMatch, Offset(1), Rel32)] HotbarSlot* initialize();
        // Update the `command_type` and `command_id` of this hotbar slot. This method will only affect the
        // current working hotbar slot and will not be persisted unless the user takes additional action that
        // would trigger a save, such as swapping this slot for a different one. Use `setAndSaveSlot` to update
        // a hotbar slot with persistence.
        [Sig("E8 ?? ?? ?? ?? EB 07 44 88 2F", FirstMatch, Offset(1), Rel32)] void set(UIModule* ui_module, HotbarSlotType type, u32 id);
        // Reset data in this hotbar slot.
        [Sig("E8 ?? ?? ?? ?? 44 8B 0B 48 8B CD", FirstMatch, Offset(1), Rel32)] void clear();
        // Populates `icon_id` with the apparent information in `apparent_action_id` and `apparent_slot_type`.
        [Sig("40 53 48 83 EC 20 44 8B 81 ?? ?? ?? ?? 48 8B D9 0F B6 91 ?? ?? ?? ?? E8 ?? ?? ?? ?? 85 C0", FirstMatch)] bool loadIconId();
        // Loads cost data to `CostText` or `cost_value` for this hotbar slot.
        [Sig("E8 ?? ?? ?? ?? 40 0A F0 C6 47", FirstMatch, Offset(1), Rel32)] bool loadCostDataForSlot(bool is_loaded);
        // Get an icon ID for a hotbar slot, with specified appearance slot type and action ID. This method
        // appears to exist to allow certain action types (specifically macros it seems?) to have a different
        // appearance than the actual CommandType/CommandId called by this hotbar slot.
        [Sig("E8 ?? ?? ?? ?? 85 C0 89 83 ?? ?? ?? ?? 0F 94 C0", FirstMatch, Offset(1), Rel32)] i32 getIconIdForSlot(HotbarSlotType slot_type, u32 action_id);
        // Get the final name for a hotbar slot, taking into account the specified appearance slot type and
        // action ID. This method is virtually almost always called using the parameters from
        // `apparent_slot_type` and `apparent_action_id`. When `apparent_action_mode` is set to `pv_p_combo`,
        // this method will instead override the passed in slotType and actionId with the values present in
        // `original_apparent_slot_type` and `original_apparent_action_id`.
        [Sig("48 89 5C 24 ?? 57 48 83 EC ?? 41 8B D8 48 89 74 24", FirstMatch)] cstring getDisplayNameForSlot(HotbarSlotType slot_type, u32 action_id);
        // Gets the `cost_value` for a specific hotbar slot, taking account the specified appearance slot type
        // and action ID. This method is always called using the parameters from `apparent_slot_type` and
        // `apparent_action_id`.
        [Sig("48 89 5C 24 ?? 57 48 83 EC 30 0F B6 C2 41 8B D8", FirstMatch)] u32 getCostValueForSlot(HotbarSlotType slot_type, u32 action_id);
        // Gets the `CostText` for a specific hotbar slot, taking account the specified appearance slot type
        // and action ID. May be empty if unused. This method is always called using the parameters from
        // `apparent_slot_type` and `apparent_action_id`.
        [Sig("E8 ?? ?? ?? ?? 48 85 C0 74 29 80 38 00", FirstMatch, Offset(1), Rel32)] cstring getCostTextForSlot(HotbarSlotType slot_type, u32 action_id);
        // Gets the `SlotCostType` for a hotbar slot, taking account the specified appearance slot type and
        // action ID. Note that the `this` is not used in the call, so... yeah. This method is no longer
        // called, but may still be usable.
        [Sig("48 83 EC 28 0F B6 CA 83 E9 01", FirstMatch)] SlotCostType getCostTypeForSlot(HotbarSlotType slot_type, u32 action_id);
        // Retrieves a `ActionType` for the specified hotbar slot type. This method doesn't actually read any
        // data from the HotbarSlot it's a member of.
        [Sig("FF CA 83 FA 1E", FirstMatch)] Game.ActionType getActionTypeForSlotType(HotbarSlotType type);
        // Gets the number of charges currently available for the specified hotbar slot (based on the icon
        // present in `apparent_action_id`). If this hotbar slot references an action that does not use
        // charges, this will return either 0 or 1.
        [Sig("40 53 48 83 EC 40 8B 99", FirstMatch)] u32 getApparentIconRecastCharges();
        // Check whether the action contained in this slot is considered usable or not. When set to false, the
        // respective slot in the UI is greyed out (though is still interactable).
        [Sig("E8 ?? ?? ?? ?? 88 47 ?? EB ?? 80 BB", FirstMatch, Offset(1), Rel32)] bool isSlotUsable(HotbarSlotType slot_type, u32 action_id);
        // Check if the hotbar slot's action's target is currently in range. When set to false, the UI will
        // show an X on the hotbar slot.
        [Sig("40 53 48 83 EC 20 44 0F B6 81 ?? ?? ?? ?? 48 8B D9 41 8B D0", FirstMatch)] bool isSlotActionTargetInRange();
        // Check if an arbitrary slot type/action ID's target is currently in range. Overload to allow for any
        // slot type or action ID to be checked. Use `isSlotActionTargetInRange` to target the current slot.
        // This method can realistically be static, I'm unsure why it's not...
        [Sig("40 53 48 83 EC ?? 44 0F B6 CA 41 8B D8 41 8B D1 83 EA ?? 74 ?? 83 EA", FirstMatch)] bool isSlotActionTargetInRange2(HotbarSlotType slot_type, u32 action_id);
        // Gets the action's cooldown percentage. This value is displayed as a white circle overlaid on the
        // hotbar slot. An action that is not currently in cooldown will be 0. Actions that do not have a
        // cooldown will also return 0.
        [Sig("E8 ?? ?? ?? ?? 89 47 ?? E9 ?? ?? ?? ?? 80 BB", FirstMatch, Offset(1), Rel32)] i32 getSlotActionCooldownPercentage(i32* out_cooldown_seconds_left, i32 a3);
        // Gets whether the specified action should be highlighted with ants in the UI. Internally calls
        // `isActionHighlighted`. This method does not appear in any code paths.
        [Sig("40 53 48 83 EC 20 44 0F B6 CA 41 8B D8 41 8B D1 83 EA 01 74 0D", FirstMatch)] bool isActionHighlighted(HotbarSlotType command_type, u32 command_id);
    }

    enum HotbarSlotType : u8 {
        empty = 0,
        action = 1,
        item = 2,
        // Special type for DragDrop situations. The id contains the InventoryType and slot index. When setting
        // this to a HotbarSlot, the correct id is resolved and the type is changed to `item`.
        inventory_item = 3,
        event_item = 4,
        // Special type for DragDrop situations. The id is the slot index in the KeyItems inventory container.
        // When setting this to a HotbarSlot, the correct id is resolved and the type is changed to
        // `event_item`.
        key_item = 5,
        emote = 6,
        macro = 7,
        marker = 8,
        craft_action = 9,
        general_action = 10,
        buddy_action = 11,
        main_command = 12,
        companion = 13,
        // Special type for DragDrop situations. The id is the slot index in the Crystals inventory container.
        // When setting this to a HotbarSlot, the correct id is resolved and the type is changed to `item`.
        crystal = 14,
        gear_set = 15,
        pet_action = 16,
        mount = 17,
        field_marker = 18,
        class_job = 19,
        recipe = 20,
        chocobo_race_ability = 21,
        chocobo_race_item = 22,
        // Seems to be a legacy type, possibly PvP related based on associated icon 000785
        unknown23 = 23,
        extra_command = 24,
        pv_p_quick_chat = 25,
        pv_p_combo = 26,
        bgc_army_action = 27,
        // Seems to be a legacy type, possibly performance instrument related based on associated icon 000782
        unknown28 = 28,
        performance_instrument = 29,
        mc_guffin = 30,
        ornament = 31,
        lost_finds_item = 32,
        glasses = 33,
        phantom_action = 34,
        quick_panel = 35,
    }

    // An intermediate struct used to translate from a `HotbarSlot` to the UI String/NumberArrays.
    [Size(0x43)]
    struct HotbarUIIntermediate {
        [0x0] cstring pop_up_help_text;
        [0x8] cstring cost_text;
        [0x10] HotbarUIIntermediate.SlotType type;
        [0x14] u32 action_id;
        [0x18] u32 icon_id;
        [0x1C] u32 cooldown_mode;
        [0x20] u32 cooldown_seconds;
        [0x24] u32 cooldown_percent;
        [0x28] u32 last_cooldown_percent;
        [0x2C] u32 charge_percent;
        [0x30] u32 last_charge_percent;
        [0x34] i32 current_charge_count;
        [0x38] u32 cost_value;
        [0x3C] u8 cost_type;
        [0x3D] u8 cost_display_mode;
        [0x3E] bool action_available1;
        [0x3F] bool action_available2;
        [0x40] bool action_target_satisfied;
        [0x41] bool draw_ants;
        [0x42] bool is_transformation_action_usable;
        [Sig("E8 ?? ?? ?? ?? 48 8B 45 ?? 4C 8D 44 24", FirstMatch, Offset(1), Rel32)] HotbarUIIntermediate* ctor();
    }

