namespace InfoProxyDetail {
    // Packet for InfoProxyDetail.AddData
    [Size(0x1AC)]
    struct AddDataPacket {
        [0x0] u64 content_id;
        [0x10] u64 looking_for_party_class_job_id_mask;
        [0x18] Agent.CrestData crest;
        [0x22] u16 world_id;
        [0x24] utf8[193] search_comment;
        [0xE5] utf8[22] fc_name;
        // Index is Town RowId
        [0xFB] u8[4] gc_ranks;
        [0x100] AddDataPacket.ClassJobEntry[43] class_job_entries;
    }

    [Size(0xD8)]
    struct DetailUpdateData {
        [0x0] InfoProxyCommonList.CharacterData.OnlineStatus online_status_mask;
        [0x8] u64 looking_for_party_class_job_id_mask;
        [0x10] u8 class_job_id;
        [0x11] InfoProxyCommonList.CharacterData.LanguageMask language_mask;
        [0x12] utf8[193] search_comment;
    }
}

namespace InfoProxyDetail.AddDataPacket {
    [Size(0x4)]
    struct ClassJobEntry {
        [0x0] u8 class_job_id;
        [0x2] u16 level;
    }
}

