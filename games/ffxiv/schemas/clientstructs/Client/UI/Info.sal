    // The index of the retainer's inventory slot in the RetainerMarket inventory.
    [0x98] u16 container_index;
    [0x9A] u16 durability;
    [0x9C] u16 spiritbond;
    // List of materias associated with this item. Only valid up to the count specified in MateriaCount.
    [0x9E] u16[5] materia;
    [0xA8] bool is_hq_item;
    [0xA9] u8 materia_count;
    [0xAA] bool is_mannequin;
    [0xAC] u32 flags { [Bit(0)] bool is_selling_as_set; }
    // The Town (from EXD) that this marketboard entry is from.
    [0xB0] u8 town_id;
    [0xB1] u8 stain0_id;
    [0xB2] u8 stain1_id;
}

[Size(0x78)]
struct PlayerRetainerInfo {
    [0x0] u64 retainer_id;
    [0x8] u8 town_id;
    [0x9] bool selling_items;
    [0x10] System.String.Utf8String name;
}

namespace InfoProxyBlacklist {
    [Size(0x14)]
    struct BlockResult {
        [0x0] BlockResultType type;
        [0x8] BlockedCharacter* blocked_character_ptr;
        [0x10] i32 blocked_character_index;
    }

    enum BlockResultType : i32 {
        not_blocked = 1,
        blocked_by_account_id = 2,
        blocked_by_content_id = 3,
    }

    [Size(0x20)]
    struct BlockedCharacter {
        [0x0] cstring name;
        [0x10] u64 id;
        [0x18] u8 flag;
    }
}

namespace InfoProxyCatalogSearch {
    [Size(0x8)]
    struct Entry {
        [0x0] u32 item_id;
        [0x4] u32 count;
    }
}

namespace InfoProxyCommonList {
    [Size(0x70)]
    struct CharacterData {
        [0x0] u64 content_id;
        [0x8] CharacterData.OnlineStatus state;
        [0x18] u64 account_id;
        // Extra flags for status: 0x10 = ? always set when accepted friend request 0x20 =
        // WaitingForFriendListApproval 0x10000->0x70000 = DisplayGroup.Star -> DisplayGroup.Club 0x1000000 =
        // OtherServer (FCTag not available)
        [0x20] u32 extra_flags { [Bit(6)] bool waiting_for_friend_list_approval; [Bit(16)] u8 group : 8; [Bit(24)] bool is_other_server; }
        [0x24] u8 sort;
        [0x26] u16 current_world;
        [0x28] u16 home_world;
        [0x2A] u16 location;
        [0x2C] Agent.GrandCompany grand_company;
        [0x2D] CharacterData.Language client_language;
        [0x2E] CharacterData.LanguageMask languages;
        [0x30] u8 sex;
        [0x31] u8 job;
        [0x32] utf8[32] name;
        [0x52] utf8[6] fc_tag;
        [0x60] CharacterIndex* index;
    }

    [Size(0x20)]
    struct CharacterIndex {
        [0x0] u64 content_id;
        [0xA] u16 home_world;
    }

    enum DisplayGroup : i8 {
        all = -1,
        none = 0,
        star = 1,
        circle = 2,
        triangle = 3,
        diamond = 4,
        heart = 5,
        spade = 6,
        club = 7,
    }

    enum Sorting : u8 {
        friend_number = 0,
        oldest = 1,
        newest = 2,
        alphabetical = 3,
        home_world = 4,
    }
}

namespace InfoProxyCommonList.CharacterData {
    enum Language : u8 {
        jp = 0,
        en = 1,
        de = 2,
        fr = 3,
        none = 255,
    }

    bitfield LanguageMask : u8 {
        [Bit(0)] bool jp;
        [Bit(1)] bool en;
        [Bit(2)] bool de;
        [Bit(3)] bool fr;
        // none is none of them
    }

    bitfield OnlineStatus : u64 {
        [Bit(1)] bool game_qa;
        [Bit(2)] bool game_master;
        [Bit(3)] bool game_master_blue;
        [Bit(4)] bool event_participant;
        [Bit(5)] bool disconnected;
        [Bit(6)] bool waiting_for_friend_list_approval;
        [Bit(7)] bool waiting_for_linkshell_approval;
        [Bit(8)] bool waiting_for_free_company_approval;
        [Bit(9)] bool not_found;
        [Bit(10)] bool offline_exd;
        [Bit(11)] bool battle_mentor;
        [Bit(12)] bool busy;
        [Bit(13)] bool pv_p;
        [Bit(14)] bool playing_triple_triad;
        [Bit(15)] bool viewing_cutscene;
        [Bit(16)] bool using_a_chocobo_porter;
        [Bit(17)] bool away_from_keyboard;
        [Bit(18)] bool camera_mode;
        [Bit(19)] bool looking_for_repairs;
        [Bit(20)] bool looking_to_repair;
        [Bit(21)] bool looking_to_meld_materia;
        [Bit(22)] bool role_playing;
        [Bit(23)] bool looking_for_party;
        [Bit(24)] bool sword_for_hire;
        [Bit(25)] bool waiting_for_duty_finder;
        [Bit(26)] bool recruiting_party_members;
        [Bit(27)] bool mentor;
        [Bit(28)] bool pv_e_mentor;
        [Bit(29)] bool trade_mentor;
        [Bit(30)] bool pv_p_mentor;
        [Bit(31)] bool returner;
        [Bit(32)] bool new_adventurer;
        [Bit(33)] bool alliance_leader;
        [Bit(34)] bool alliance_party_leader;
        [Bit(35)] bool alliance_party_member;
        [Bit(36)] bool party_leader;
        [Bit(37)] bool party_member;
        [Bit(38)] bool party_leader_cross_world;
        [Bit(39)] bool party_member_cross_world;
        [Bit(40)] bool another_world;
        [Bit(41)] bool sharing_duty;
        [Bit(42)] bool similar_duty;
        [Bit(43)] bool in_duty;
        [Bit(44)] bool trial_adventurer;
        [Bit(45)] bool free_company;
        [Bit(46)] bool grand_company;
        [Bit(47)] bool online;
        // offline is none of them
    }
}

