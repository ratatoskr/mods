namespace AgentInclusionShop {
    [Size(0x1290)]
    struct AgentData : Common.Component.Excel.ExcelSheetWaiter {
        [0x90] AgentInclusionShop* agent;
        [0x98] u32 sheet_id;
        [0xA4] i32 sheet_load_state;
        [0xB0] Common.Component.Excel.ExcelSheet* inclusion_shop_series_sheet;
        [0x188] u32 inclusion_shop_id;
        [0x190] Category[30] categories;
        // maps `selected_category_index` to `categories`
        [0x1180] u8[30] category_index_map;
        [0x119F] u8 category_count;
        [0x11A1] u8 selected_item_index;
        [0x11A2] u8 selected_currency_count;
        [0x11A3] u8 selected_special_currency_count;
        [0x11A4] SelectedCurrency[3] selected_currencies;
        [0x11C8] u32 purchase_quantity;
        [0x11D0] u8 selected_category_index;
        [0x11D1] u8 selected_sub_category_index;
        [0x11D2] u8 unk11_d2;
        // maps ui item index to `items`
        [0x11D3] u8[60] item_index_map;
        [0x124B] u8 visible_sub_category_count;
        [0x124C] u8 selected_sub_category_tab;
        // maps `selected_sub_category_tab` to `sub_categories`
        [0x124D] u8[60] sub_category_index_map;
        [0x128E] u8 flags { [Bit(0)] bool needs_addon_refresh; [Bit(1)] bool is_shop_ready; [Bit(2)] bool filter_enabled; }
    }

    [Size(0x88)]
    struct Category {
        [0x0] u64 unk00;
        [0x8] u16 inclusion_shop_row_id;
        [0xA] u16 inclusion_shop_series_id;
        [0xC] u8 unk0_c;
        [0xD] u8 sub_category_count;
