namespace AgentContentsFinderInterface {
    [Size(0x7C8)]
    struct RewardsContainer {
        [0x0] RewardsData content_rewards;
        [0x220] Game.InventoryItem[5] items;
        [0x388] RewardsData content_roulette_role_bonus_rewards;
        [0x5A8] RewardsData unk_items3;
    }

    [Size(0x220)]
    struct RewardsData {
        [0x0] Game.InventoryItem[7] items;
        // Formula: `ContentRouletteRoleBonus.BaseExperience * ParamGrow.ScaledQuestXP *
        // ParamGrow.QuestExpModifier / 1000`
        [0x1F8] i32 experience;
        // Formula: `InstanceContent.InstanceClearGil * ContentRouletteRoleBonus.GilMultiplier / 1000`
        [0x1FC] i32 gil;
        // Formula: `CurrentLevel * ContentRouletteRoleBonus.GCSealsMultiplier / 1000`
        [0x200] i32 grand_company_seals;
        // Count for TomestonesItem where Tomestones == 1
        [0x204] i32 currency_a;
        // Count for TomestonesItem where Tomestones == 2
        [0x208] i32 currency_b;
        // Count for TomestonesItem where Tomestones == 3
        [0x20C] i32 currency_c;
        [0x210] i32 pv_p_exp;
        [0x214] i32 series_exp;
        [0x218] i32 wolf_marks;
        [0x21C] bool limited_time_bonus;
    }
}

