        [0x80] Common.Component.Excel.ExcelSheetWaiter* series_sheet_waiter;
    }

    [Size(0x80)]
    struct Item {
        [0x4] u32[2] give_item_owned_count;
        [0xC] u32[3] cost_owned_count;
        [0x18] u32[2] give_amount;
        [0x20] u32[3] cost_amount;
        [0x2C] u32[2] give_item_id;
        // Meaning depends on `cost_type`: 0/1 = item id, 2 = tomestone index (resolve via GetTomestonesItem),
        // 3 = special currency id (resolve via CurrencyManager).
        [0x3C] u32[3] cost_item_id;
        // 0 = item, 1 = HQ item, 2 = tomestone, 3 = special currency
        [0x6C] u8[3] cost_type;
        [0x75] u8[2] give_item_hq;
    }

    [Size(0xC)]
    struct SelectedCurrency {
        [0x0] u32 item_id;
        // `invalid` when unset
        [0x4] u32 inventory_slot;
        [0x8] u32 unk08;
    }

    [Size(0x1E80)]
    struct SubCategory {
        [0x0] System.String.Utf8String name;
        [0x70] Item[60] items;
        [0x1E78] u8 item_count;
    }
}

