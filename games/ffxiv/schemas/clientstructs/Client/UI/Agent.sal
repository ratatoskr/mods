        [Sig("48 89 5C 24 ?? 48 89 7C 24 ?? 44 0F B6 51 ?? 32 C0", FirstMatch)] bool addMember(u8 member_index, DawnMemberEntry* member);
        [Sig("32 C0 0F 1F 40 00 66 66 0F 1F 84 ?? 00 00 00 00 44 0F B6 C0 42 38 54", FirstMatch)] void removeMember(u8 member_index);
        [Sig("48 8D 41 ?? B9 07 00 00 00 0F 1F 80 00 00 00 00 C6 00 FF", FirstMatch)] void clearParty();
        [Sig("E8 ?? ?? ?? ?? 0F B6 F8 BA ?? ?? ?? ?? 48 8D 8E", FirstMatch, Offset(1), Rel32)] bool canAddMember(u8 member_index, DawnMemberEntry* member);
        [Sig("44 0F B6 41 ?? 32 C0 45 84 C0 74 ?? 0F 1F 40 00", FirstMatch)] bool isFull();
    }

