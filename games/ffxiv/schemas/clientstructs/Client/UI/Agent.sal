        [0x10] i32 cosmo_credits_icon;
        [0x14] i32 zone_credits;
        [0x18] i32 zone_credits_max;
        [0x1C] i32 zone_credits_item_id;
        [0x20] i32 zone_credits_icon;
        [0x568] System.String.Utf8String cosmo_credits_text;
        [0x5D0] System.String.Utf8String zone_credits_text;
    }
}

namespace AgentWKSMission {
    [Size(0x120)]
    struct MissionData {
        [0x1] u8 selected_job_index;
        [0x2] u8 selected_tab_index;
        [0x3] u8 selected_filter_index;
        [0x4] u8 start_step;
        [0x5] bool is_mission_log;
        [0x8] u32 selected_mission_unit_id;
        [0xC] MissionFlags selected_mission_flags;
        [0x10] i32 selected_mission_index;
        [0x14] u32 confirm_mission_id;
        [0x18] u32 confirm_addon_id;
        [0x1C] u32 map_mission_id;
        [0x20] i32 map_player_pos_x;
        [0x24] i32 map_player_pos_y;
        [0x28] System.String.Utf8String selected_mission_title;
        [0x90] System.String.Utf8String item_level_warning_text;
        [0xF8] STD.StdVector<MissionEntry> mission_list;
        [0x115] u8 mission_log_tab_index;
        [0x118] u8 update_flags;
        [0x119] u8 control_flags;
    }

    [Size(0x20)]
    struct MissionEntry {
        [0x0] u32 mission_unit_id;
        [0x4] u32 icon_id;
        [0x14] MissionFlags flags;
        // 1,2,3,4 = D,C,B,A (LevelGroup) 12 = Weather-restricted 13 = Time-restricted 14 = Sequential
        // (LockedBehind) 15 = Critical (IsSpecialQuest) 16 = Master
        [0x18] u8 mission_group;
        // ClassJob index derived from WKSMissionUnit.ClassJobCategory.
        [0x19] u8 class_job_index;
    }

    bitfield MissionFlags : u32 {
        [Bit(0)] bool time_restricted;
        // Sequential or Critical
        [Bit(1)] bool triggered;
        [Bit(2)] bool silver;
        [Bit(3)] bool gold;
        [Bit(4)] bool weather_restricted;
        [Bit(5)] bool locked;
        [Bit(7)] bool condition_locked;
        [Bit(11)] bool currently_active;
    }
}

