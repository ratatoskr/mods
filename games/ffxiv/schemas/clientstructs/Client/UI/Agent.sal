namespace AgentScenarioTree {
    [Size(0x30)]
    struct AgentScenarioTreeData {
        // [0] Main Scenario Quest Path 1 [1] Main Scenario Quest Path 2 [2] Main Scenario Quest Path 3 [3]
        // Last completed Main Scenario Quest (Only populated if no MSQ is accepted and the MSQ wasn't finished
        // yet)
        [0x0] u16[4] main_scenario_quest_ids;
        // [0] Primary Job Quest [1] Secondary Job Quest
        [0x8] u16[2] job_quest_ids;
        [0xC] u32 unk_c;
        [0x10] u8 scenario_tree_tips_id;
        [0x11] i8 grand_company;
        // Used as index for the `JobQuestIds` array.
        [0x12] u8 job_quest_index;
        [0x13] bool unk13;
        [0x14] bool unk14;
        [0x15] bool unk15;
        [0x18] cstring unk18;
        // 0 = Normal 1 = In Duty/Duty Recorder 2 = ScenarioTreeCompleteDisp != 0
        [0x20] u32 display_mode;
        // 0 = Nothing 1 = Update/Next Quest?! 2 = Open ScenarioTreeDetail (Main Scenario Quest Tree) for
        // MainScenarioQuestIds 0-2 3 = Open MSQ on Map 4 = Open Job Quest on Map
        [0x24] u32 command_type;
        [0x28] u32 scenario_tree_detail_addon_id;
        // The currently selected MSQ path. Used as index for the `MainScenarioQuestIds` array.
        [0x2C] u8 msq_path_index;
        [0x2D] bool unk2_d;
    }
}

