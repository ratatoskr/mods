        [0xC] u32 id;
        [0x10] u32 glamour_id;
        [0x14] u32 icon_id;
        [0x18] u32 unk_equip_slot_category_flags;
    }

    [Size(0x328)]
    struct TryonCharaView : Misc.CharaView {
        [0x318] bool do_update;
        [0x319] bool hide_other_equipment;
        [0x31A] bool headgear_hidden;
        [0x31B] bool weapon_hidden;
        [0x31C] bool visor_closed;
        [0x31D] bool viera_ears_hidden;
        [0x31E] bool draw_weapon;
    }
}

namespace AgentVVDFinder {
    [Size(0x4218)]
    struct VVDFinderData {
        [0x22D0] AgentContentsFinderInterface interface_sub;
    }
}

namespace AgentWKSAnnounce {
    [Size(0xA8)]
    struct AnnounceData {
        [0x4] u8 emergency_info_row_id;
        [0x5] u8 emergency_info_sub_row_id;
        [0xC] u32[2] emergency_progress;
        [0x18] System.String.Utf8String formatted_string;
        [0x80] u32[2] emergency_progress_required;
        [0x88] f32 unk_float88;
        // This is the end time in unix seconds
        [0x8C] u32 end_time;
        // ClassJobTypeFlags >> 16 is the class job type flags for mission area 0 ClassJobTypeFlags & 0xFFFF is
        // the class job type flags for mission area 1 Remark maps the bitfields to class jobs 0x1 = CRP 0x2 =
        // BSM 0x4 = ARM 0x8 = GSM 0x10 = LTW 0x20 = WVR 0x40 = ACH 0x80 = CUL 0x100 = MIN 0x200 = BTN 0x400 =
        // FSH
        [0x90] u32 class_job_type_flags;
        // State == 8 => StateProgress / 125 = StateBars State == 2 => StateProgress / 25700 = Emergency
        // Completion Total State
        [0x94] u32 state_progress;
        [0x98] u32 unk98;
        [0x9C] u32 dev_grade;
        // 0 = MechOps commenced 1 = Red Alert Incoming 2 = Red Alert Progressing 3 = ??? 4 = ??? 5 = MechOps
        // issued 6 = MechOps deploying 7 = ??? 8 = Waiting for dev stage progress
        [0xA0] u8 state;
        // 1 = Created 2 = Addon Ready
        [0xA1] u8 addon_state;
        [0xA2] bool has_update;
    }
}

namespace AgentWKSHud {
    [Size(0x798)]
    struct HudInfo {
        [0x0] u8 state;
        [0x8] i32 cosmo_credits;
