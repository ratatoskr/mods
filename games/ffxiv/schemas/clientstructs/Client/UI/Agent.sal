namespace AgentInventoryContext {
    [Size(0x20)]
    struct ContextCallbackInfo {
        // RowId in the Addon sheet
        [0x0] u32 label_id;
        [0x8] InventoryContextEvent* handler;
        [0x10] u64 callback_param;
        // If this is `true`, the AtkModule handler `HandleOpenItemContextMenu` will call `handleCallback`
        // instead of `openForItemSlot`.
        [0x18] bool is_custom_item_context_menu;
    }

    [Size(0x8)]
    struct InventoryContextEvent {
        [0x0] void* virtual_table;
        // This callback function is invoked when the related context menu item was clicked on.
        [Virtual(0)] void handleCallback(u32 slot, Game.InventoryType inventory_type, InventoryContextFlag flags, u64 callback_param);
        [Virtual(1)] bool handleClose();
    }
}

namespace AgentItemComp {
    [Size(0x1650)]
    struct ComparedItemData {
        // These items are, in order: the selected item, the alternate quality (HQ/NQ) of the selected item,
        // the currently equipped item, and the left ring slot (if the SelectedItem is a ring) Any item that
        // doesn't exist is retained as an empty item in the array
        [0x0] ComparedItemData.ComparedInventoryItem[4] items;
        // This array has the same layout as the one for Items
        [0x140] ComparedItemData.ComparedInventoryItemData[4] item_data;
        // This is set on any frame that the Agent will be updating the addon's UI 0 = No update needed 1 =
        // Open 2 = Refresh
        [0x1640] i32 update_state;
        // Counts up across frames as the agent loads the necessary data
        [0x1644] i32 load_state;
        [0x1648] i32 parent_addon_id;
        [0x164C] bool show_alternate_quality;
    }
}

namespace AgentItemComp.ComparedItemData {
    [Size(0x50)]
    struct ComparedInventoryItem {
        [0x0] Game.InventoryItem item;
        [0x48] u8 current_synced_job_level;
        [0x49] u8 current_job_level;
        [0x4A] u8 current_class_job_id;
    }

    [Size(0x540)]
    struct ComparedInventoryItemData {
        [0x0] System.String.Utf8String glamoured_item_name;
        [0x68] System.String.Utf8String crafter_name;
        [0xD0] System.String.Utf8String dye_names;
        [0x138] System.String.Utf8String[5] materia_names;
        [0x340] System.String.Utf8String repair_item_name;
        [0x3A8] System.String.Utf8String marketability;
        [0x410] System.String.Utf8String unk410;
        // One of weapon, shield, gear
        [0x51C] ComparedInventoryItemData.DeltaUnion Delta;
        [0x53C] u16 item_level_row_id;
        // 0- Error 1- OK 2- Different Job can equip, but generally only for weapons? 3- Level Restricted 4-
        // Class/Race/Gender/GC Restricted
        [0x53E] u8 equippable_state;
        [0x53F] u8 dye_count;
    }

    [Size(0x20)]
    struct GearDataDelta {
        [0x0] i32 physical_defense;
        [0x4] i32 magic_defense;
        [0x8] i32 physical_defense_delta;
        [0xC] i32 magic_defense_delta;
        // This is always the same as PhysicalDefense, but the game sets it separately
        [0x10] i32 left_ring_slot_physical_defense;
        // This is always the same as MagicDefense, but the game sets it separately
        [0x14] i32 left_ring_slot_magic_defense;
        [0x18] i32 left_ring_slot_physical_defense_delta;
        [0x1C] i32 left_ring_slot_magic_defense_delta;
    }

    [Size(0x8)]
    struct ShieldDataDelta {
        [0x0] i32 block;
        [0x4] i32 block_delta;
    }

    [Size(0x14)]
    struct WeaponDataDelta {
        [0x0] i32 physical_damage;
        [0x4] i32 magic_damage;
        [0x8] i32 delay;
        [0xC] i32 physical_damage_delta;
        [0x10] i32 magic_damage_delta;
    }
}

namespace AgentItemComp.ComparedItemData.ComparedInventoryItemData {
    union DeltaUnion {
        WeaponDataDelta weapon;
        ShieldDataDelta shield;
        GearDataDelta gear;
    }
}

