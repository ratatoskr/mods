        fraction = 2,
        // See `bar`.
        bar = 3,
        // See `fraction_bar`.
        fraction_bar = 4,
        // See `time_remaining`.
        time_remaining = 5,
        // See `large_gray_text`.
        large_gray_text = 6,
        // See `large_gray_number`.
        large_gray_number = 7,
        // See `large_gray_fraction`.
        large_gray_fraction = 8,
        // See `large_bar`.
        progress_bar = 9,
        // See `colorable_bar`.
        colorable_bar = 10,
        // See `quest_title`.
        quest_title = 11,
        // See `large_blue_text`.
        large_blue_text = 12,
        // See `large_time_remaining`.
        large_time_remaining = 13,
        // See `join_button`.
        join_button = 14,
        // See `long_bar`.
        long_bar = 15,
    }
}

namespace TradeNumberArray {
    [Size(0x18)]
    struct TradeItem {
        [0x0] i32 icon_id;
        [0x4] u32 quantity;
        [0x8] i32 equip_slot_category;
        // 0 = None 1 = Equipment 2 = CanExtractMateria 4 = NoCondition 16 = MaxStackQuantity 32 =
        // IsCollectable 64 = CanStackWithSomeOtherStackInInventory
        [0xC] i32 item_flags;
        // 0x000000FF = Flags mask 0xFFFFFF00 = Color mask Flags: 0 = None 1 = ContainsData 2 =
        // HasUnlockedStainSlot 4 = IsGlamoured 2nd stain only has flag component 0 and 1
        [0x10] i32[2] stain_flags_and_color;
    }
}
