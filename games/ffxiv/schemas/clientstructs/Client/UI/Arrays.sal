namespace NamePlateNumberArray {
    [Size(0x54)]
    struct NamePlateObjectIntArrayData {
        [0x0] UIObjectKind name_plate_kind;
        [0x4] i32 hp_label_state;
        // & 0x1 - Update & 0x2 - Update Colors
        [0x8] i32 update_flags;
        [0xC] i32 x;
        [0x10] i32 y;
        [0x14] f32 depth;
        [0x18] i32 scale;
        [0x1C] i32 gauge_fill_percentage;
        [0x20] u32 name_text_color;
        [0x24] u32 name_edge_color;
        [0x28] u32 gauge_fill_color;
        [0x2C] u32 gauge_container_color;
        [0x30] i32 marker_icon_id;
        [0x34] i32 name_icon_id;
        [0x38] bool use_large_name_icon;
        [0x3C] i32 name_plate_object_index;
        // & 0x1 - Is prefix title & 0x4 - PvP enemy & 0x8 - Use Depth-based Priority (terrain obstruction) &
        // 0x20 - Enable gauge & 0x40 - Use attack cursor & 0x80 - Hide title & 0x100 - Disable Alternate Part
        // Id
        [0x44] i32 draw_flags;
        // & 0x1 - Draw name text & 0x2 - Draw gauge & 0x4 - Nameplate already exists with unchanged data. Uses
        // the timeline.
        [0x4C] i32 visibility_flags;
        [0x50] u32 entity_id;
    }
}

namespace PartyListNumberArray {
    [Size(0xAC)]
    struct PartyListMemberNumberArray {
        [0x8] i32 level;
        [0xC] i32 class_icon_id;
        [0x18] i32 current_health;
        [0x1C] i32 max_health;
        // Goes from 0 to 200%
        [0x20] i32 shields_percentage;
        [0x24] i32 current_mana;
        [0x28] i32 max_mana;
        // Goes from 0 to 100%
        [0x30] i32 enmity_percent;
        // Starts at 1 [A] [2] [3] ... [8]
        [0x34] i32 enmity_level;
        // Amount of Statuses applied to the player. Max is 10.
        [0x40] i32 status_count;
        [0x44] i32[10] status_icon_ids;
        [0x6C] bool[10] status_is_dispellable;
        // -1 if not active
        [0x94] i32 cast_time;
        [0x98] i32 cast_id;
        [0xA0] u32 entity_id;
        [0xA4] bool targetable;
        [0xA8] i32 display_row;
    }
}

