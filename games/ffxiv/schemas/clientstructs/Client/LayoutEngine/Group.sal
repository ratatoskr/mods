    [Sig("E8 ?? ?? ?? ?? 80 7F 42 00", FirstMatch, Offset(1), Rel32)] void setRotation(ILayoutInstance* instance, Quat* rotation);
    [Sig("48 81 EC ?? ?? ?? ?? 4C 8B CA 48 85 D2 0F 84 ?? ?? ?? ?? 48 8B 51 ?? 48 85 D2 0F 84 ?? ?? ?? ?? 48 8B 82 ?? ?? ?? ?? 41 0F B6 49 ?? 48 89 9C 24 ?? ?? ?? ?? ?? ?? ?? ?? 48 8B CA C7 44 24 ?? 00 00 00 00 C7 44 24 ?? 00 00 00 00 F3 0F 10 43 ?? F3 0F 11 44 24 ?? F3 0F 10 4B ?? F3 0F 11 4C 24 ?? F3 0F 10 43 ?? F3 0F 11 44 24 ?? 0F 10 4B", FirstMatch)] void setScale(ILayoutInstance* instance, Vec3* scale);
    [Sig("48 85 D2 74 5D 57", FirstMatch)] void setTransform(ILayoutInstance* instance, Transform* transform);
    [Virtual(11)] void tick(f32 dt);
}

