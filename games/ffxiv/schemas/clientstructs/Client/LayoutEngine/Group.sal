// A set of instances used together. Can be nested up to 4 levels deep. Each prefab is a scene, however
// it has some limitations (only single embedded layer group with a single layer is supported).
[Size(0x1A0)]
struct SharedGroupLayoutInstance : ILayoutInstance {
    // Inherited parent class accessor for `ResourceEventListener`
    [0x30] System.Resource.ResourceEventListener resource_event_listener;
    [0x38] System.Resource.Handle.ResourceHandle* resource_handle;
    [0x40] System.Scheduler.Instance.LayoutSharedGroupObject* timeline_object;
    [0x50] Transform transform;
    [0x80] Node.ChildNodeContainer instances;
    [0xD0] TimeLineContainer time_line_container;
    // Contains stain state, among other things, for supported shared group layouts. Support for staining
    // is based on a hardcoded path check like so: `strstr(path, "/hou/") || strstr(path, "/ind/") ||
    // strstr(path, "/mji/") || strstr(path, "/pvp_xx/") && strstr(path, "cst")`
    [0xF8] SharedGroupStainInfo* stain_info;
    [0x110] SGActionController* action_controller1;
    [0x118] SGActionController* action_controller2;
    [0x120] u32 prefab_flags1;
    [0x12C] u32 prefab_flags2;
    // Used by EventObjAnimation ActorControl packet, it's some kind of simple lookup table.
    [0x154] u8[16] timeline_indices;
    // Set in PlayAnimation, it's an index into TimelineIndices.
    [0x16D] u8 playing_timeline_index;
    [Sig("E8 ?? ?? ?? ?? 41 FF C7 4D 8D 76 ?? 44 3B 7B", FirstMatch, Offset(1), Rel32)] bool initAnimationHandlers(void* file_data);
    [Sig("E8 ?? ?? ?? ?? 0F BE 8F ?? ?? ?? ?? 83 E9 01", FirstMatch, Offset(1), Rel32)] void initTimelines(void* file_data);
    // Takes the stain selection in `stain_info` and recursively applies it to the child layout instances.
    [Sig("E8 ?? ?? ?? ?? 44 8B 46 0C 48 8B CE", FirstMatch, Offset(1), Rel32)] void reapplyStain();
    // Looks up the sRGB color for the object stain choice at the given index. Index zero is a sentinel
    // representing leaving the default stain, and will return empty black.
    [Sig("33 C0 81 F9 ?? ?? ?? ?? 0F 42 C1", FirstMatch)] static Graphics.ByteColor* getObjectStainColorByIndex(u8 stain_index);
    // Checks if this timeline is currently playing.
    [Sig("E8 ?? ?? ?? ?? 85 EF 74 ?? 84 C0", FirstMatch, Offset(1), Rel32)] bool isTimelinePlaying(u32 index);
    // Stops this timeline's playback.
    [Sig("E8 ?? ?? ?? ?? EB ?? 41 80 F9", FirstMatch, Offset(1), Rel32)] bool stopTimeline(u32 index);
    // Start playing this timeline.
    [Sig("E8 ?? ?? ?? ?? 0F B6 B6", FirstMatch, Offset(1), Rel32)] bool playTimeline(u32 index, u32 a1);
    // Checks if the timeline index is in range, and actually backed by something.
    [Sig("E8 ?? ?? ?? ?? 84 C0 74 ?? 3B FD", FirstMatch, Offset(1), Rel32)] bool isTimelineIndexValid(u32 index);
}

bitfield SharedGroupStainFlags : u32 {
    // If this bit is set, the next call to `reapplyStain` will apply the stain color.
    [Bit(0)] bool stain_modified;
    // none is none of them
}

[Size(0xE0)]
struct SharedGroupStainInfo {
    // The stain to use if `chosen_stain_index` is zero.
    [0x1] u8 default_stain_index;
    // The stain that has been specified to be used for the group, or zero to use the
    // `default_stain_index`. This will take effect the next time `reapplyStain` is called when `flags` has
    // the `stain_modified` flag set.
    [0x2] u8 chosen_stain_index;
    [0x18] Node.ChildNodeContainer child_node_container;
    [0xC4] SharedGroupStainFlags flags;
}

[Size(0x20)]
struct TimeLineContainer {
    [0x8] STD.StdVector<TimeLineLayoutInstance*> instances;
    [Sig("48 8B 41 08 44 8B CA", FirstMatch)] TimeLineLayoutInstance* findInstanceBySubId(u32 sub_id);
}

[Size(0x60)]
struct TimeLineLayoutInstance : ILayoutInstance {
    [0x30] System.Scheduler.SchedulerInstanceObject* scheduler_object;
    [0x38] SharedGroupLayoutInstance* parent;
    [0x40] u32 path_crc;
    [0x48] FileSceneTimeline* data_ptr;
    [0x50] System.Scheduler.Instance.LayoutReferenceObject* timeline_object;
}

namespace SGDoorActionController {
    enum DoorState : i32 {
        opening = 0,
        open = 1,
        closing = 2,
        closed = 3,
    }
}

namespace SGTransformActionController {
    [Size(0x10)]
    struct Object {
        [0x0] ILayoutInstance* instance;
        [0x8] Transform* transform;
    }

    [Size(0x40)]
    struct Timer {
        [0x0] u32 flags1;
        [0x4] u32 flags2;
        [0x8] f32 elapsed;
        [0xC] f32 period1;
        [0x10] f32 period2;
        [0x20] Vec4 start;
        [0x30] Vec4 end;
    }
}
