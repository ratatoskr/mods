namespace AddonJobHud {
    // Base struct for the gauges themselves. The majority of the fields in any given gauge will be
    // pointers to Nodes and Components within its addon, but data values are usually sprinkled in too.
    [Size(0x10)]
    struct AddonJobHudGauge {
        [0x8] AddonJobHud* job_hud;
    }

    // Base struct containing the data that each particular gauge relies on.
    [Size(0x8)]
    struct AddonJobHudGaugeData {
    }
}

