    bitfield AgentUpdateFlags : u8 {
        // Set when an inventory has been updated.
        [Bit(0)] bool inventory_update;
        // Set when a hotbar slot has been executed, or a Gearset or Macro has been changed.
        [Bit(1)] bool action_bar_update;
        // Set when the RetainerMarket inventory has been updated.
        [Bit(2)] bool retainer_market_inventory_update;
        // Unknown use case.
        [Bit(3)] bool nameplate_update;
        // Set when the player unlocked collectibles, contents or systems.
        [Bit(4)] bool unlocks_update;
        // Set when `setMainCommandEnabledState` was called.
        [Bit(5)] bool main_command_enabled_state_update;
        // Set when any housing inventory has been updated.
        [Bit(6)] bool housing_inventory_update;
        // Set when any content inventory has been updated.
        [Bit(7)] bool content_inventory_update;
        // none is none of them
    }

    [Size(0x98)]
    struct CrystalCache : ItemCache {
    }

    [Size(0x90)]
    struct InventoryCache : ItemCache {
    }

    [Size(0x88)]
    struct ItemCache {
        [0x0] void* virtual_table;
        [0x8] System.String.Utf8String name;
        [0x70] u32 id;
        [0x74] u32 icon_id;
        [0x78] u32 stack_size;
        [0x7C] u8 equip_slot_category;
        [0x7D] u8 additional_data_count;
        // Only set if FilterGroup == 15
        [0x7E] u8 additional_data;
        [0x7F] u8 level_equip;
        [0x80] u8 sub_stat_category;
        [0x82] i16 level_item;
        // Only set if item contains a glamour and not FilterGroup == 15
        [0x84] u32 glamour_id;
        [Virtual(0)] ItemCache* dtor(u8 free_flags);
        [Virtual(1)] void clear();
        [Virtual(2)] bool setFromInventoryItem(Game.InventoryItem* item);
        [Virtual(3)] void update(u32 item_id, void* item_ptr, u32 glamour_id, void* glamour_item_ptr);
    }

