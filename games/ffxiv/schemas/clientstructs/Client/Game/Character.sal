namespace ActionEffectHandler {
    // A single effect (damage, heal, status, miss, etc) an action had on a single target.
    [Size(0x8)]
    struct Effect {
        [0x0] u8 type;
        [0x1] u8 param0;
        [0x2] u8 param1;
        [0x3] u8 param2;
        [0x4] u8 param3;
        [0x5] u8 param4;
        [0x6] u16 value;
    }

    [Size(0x78)]
    struct EffectEntry {
        [0x0] u32 global_sequence;
        [0x8] u8 target_index;
        [0x9] u8 action_type;
        [0xC] u32 action_id;
        [0x10] u16 spell_id;
        [0x18] Object.GameObjectId source;
        [0x20] bool source_confirmed;
        [0x28] Object.GameObjectId target;
        [0x30] bool target_confirmed;
        [0x38] TargetEffects effects;
    }

    // Global result of a single action. Used in combination with target data: a list of GameObjectId's and
    // sets of Effect's.
    [Size(0x28)]
    struct Header {
        [0x0] Object.GameObjectId animation_target_id;
        [0x8] u32 action_id;
        [0xC] u32 global_sequence;
        [0x10] f32 animation_lock;
        [0x14] u32 ballista_entity_id;
        [0x18] u16 source_sequence;
        [0x1A] u16 rotation_int;
        [0x1C] u16 spell_id;
        [0x1E] u8 animation_variation;
        [0x1F] u8 action_type;
        [0x20] u8 flags { [Bit(0)] bool show_in_log; [Bit(1)] bool force_animation_lock; }
        [0x21] u8 num_targets;
    }

    // A full set of effects an action had on a single target.
    [Size(0x40)]
    struct TargetEffects {
        [0x0] Effect[8] effects;
    }
}

