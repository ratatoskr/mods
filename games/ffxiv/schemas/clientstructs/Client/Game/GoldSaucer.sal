namespace Client.Game.GoldSaucer;

[Size(0x7B0)]
struct GFateDirector : Event.GoldSaucerDirector {
    [0x620] System.String.Utf8String map_marker_tooltip_text;
    [0x688] u32 map_marker_level_id;
    [0x690] u32 map_marker_icon_id;
    [0x708] u32[32] object_ids;
    [0x788] i32 end_timestamp;
    [0x794] u16 bgm_id;
    [0x798] u16 screen_image_id1;
    [0x79A] u16 screen_image_id2;
    [0x79C] u16 screen_image_id3;
    [0x79E] GateType gate_type;
    [0x79F] GatePositionType gate_position_type;
    [0x7A4] GFateDirectorFlag flags;
}

bitfield GFateDirectorFlag : u32 {
    [Bit(0)] bool is_joined;
    [Bit(1)] bool is_finished;
    [Bit(2)] bool unk2;
    [Bit(3)] bool unk3;
    [Bit(4)] bool unk4;
    [Bit(5)] bool unk5;
}

enum GatePositionType : u8 {
    none = 0,
    wonder_square_east = 1,
    event_square = 2,
    round_square = 3,
    the_cactpot_board = 4,
}

enum GateType : u8 {
    none = 0,
    cliffhanger = 1,
    vase_off = 2,
    skinchange_we_can_believe_in = 3,
    the_time_of_my_life = 4,
    any_way_the_wind_blows = 5,
    leap_of_faith = 6,
    air_force_one = 7,
    slice_is_right = 8,
}

bitfield GoldSaucerFlag : u8 {
    [Bit(0)] bool unk0;
    [Bit(1)] bool chocobo_race_tutorial_clear;
    [Bit(2)] bool unk2;
    [Bit(3)] bool unk3;
    [Bit(4)] bool unk4;
    [Bit(5)] bool chocobo_race_all_open;
    [Bit(6)] bool unk6;
    [Bit(7)] bool unk7;
}

[Size(0x68)]
struct GoldSaucerManager {
    [0x28] GFateDirector* current_g_fate_director;
