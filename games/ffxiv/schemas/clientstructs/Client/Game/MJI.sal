// Made from FFXIVClientStructs by tools/ClientStructsSal. Change that and run `zig build client-structs`,
// since this is written again.

namespace Client.Game.MJI;

enum CraftworkDemandShift : i32 {
    skyrocketing = 0,
    increasing = 1,
    none = 2,
    decreasing = 3,
    plummeting = 4,
}

enum CraftworkSupply : i32 {
    nonexistent = 0,
    insufficient = 1,
    sufficient = 2,
    surplus = 3,
    overflowing = 4,
}

bitfield FarmSlotFlags : u8 {
    [Bit(0)] bool under_care;
    [Bit(1)] bool was_under_care;
    [Bit(2)] bool care_halted;
    [Bit(3)] bool flag8;
}

[Size(0xE8)]
struct IslandState {
    [0x0] bool can_edit_island;
    // The current Sanctuary Rank of the player's island. Controls what buildings/items/recipes are or
    // aren't available to the player, and represented by MJIRank.
    [0x1] u8 current_rank;
    // The XP earned towards the next Island Sanctuary rank. Resets to 0 upon leveling up the Sanctuary.
    [0x4] u32 current_xp;
    // The current progress of the player, as represented by MJIProgress. Appears to be bound to the island
    // sanctuary "tutorial" more than anything.
    [0x8] u8 current_progress;
    // The current development level of the player's village on their island. Controls what building zones
    // are available. Allowed building locations are part of the MJIBuildingPlace (+0x10) and
    // MJILandmarkPlace (+0x10) Lumina sheets.
    [0x9] u8 village_development_level;
    // The glamour ID applied to paths around the Island Sanctuary. Correlates to a subrow in
    // MJIVillageAppearanceUI, row 0.
    [0xA] u8 paths_glamour_id;
    // The glamour ID applied to grounds around the Island Sanctuary. Correlates to a subrow in
    // MJIVillageAppearanceUI, row 2.
    [0xB] u8 grounds_glamour_id;
    // The glamour ID applied to slopes around the Island Sanctuary. Correlates to a subrow in
    // MJIVillageAppeareanceUI, row 1.
    [0xC] u8 slopes_glamour_id;
    // A bitfield representing all unlocked key items (MJIKeyItem) for the player. Backing field for
    // `isKeyItemUnlocked`, which should be used where possible. The index of this field will be (RowID -
    // 1), so "Islekeep's Stone Hatchet" appears at position 0.
    [0xD] u8[3] unlocked_key_items;
    // A bitfield representing if a specific recipe (MJIRecipe) is unlocked. Backing field for
    // `isRecipeUnlocked`, which should be used where possible.
    [0x10] u8[3] unlocked_recipes;
    // An array of booleans representing if a specific item is (un)locked. Locked/unavailable items are set
    // to true, while those that are unlocked are false. This array is indexed by RowID from the
    // MJIItemPouch table. An item appears to be unlocked upon being gathered or crafted for the first
    // time. `isPouchItemLocked`
    [0x14] u8[109] locked_pouch_items;
    // A sub-struct representing the Farm's (Cropland's) current state
    [0x81] MJIFarmPasture farm;
    // A sub-struct representing the Pasture's current state.
    [0x85] MJIFarmPasture pasture;
    // Appears to be set if the pasture in it has any animal currently under care.
    [0x89] bool pasture_under_care;
    // The current daily care fee paid to the Creature Comforter for the pasture.
    [0x8A] u16 pasture_daily_care_fee;
    // The current daily care fee paid to the Produce Producer for the farm.
    [0x8C] u16 farm_daily_care_fee;
    // The current number of hours remaining until a specific Landmark has finished construction. This
    // value may be zero when there is either no construction or if construction is finished and the
    // landmark needs to be "finalized" by the player. This array is indexed by the RowID of an
    // MJILandmarkPlace.
    [0x8E] u8[5] landmark_hours_to_completion;
    // The RowID of the MJILandmark present at a specific MJILandmarkPlace. This array is indexed by the
    // RowID of an MJILandmarkPlace.
    [0x93] u8[5] landmark_ids;
    // The current construction status of a landmark at a specific MJILandmarkPlace. This array is indexed
    // by the RowID of an MJILandmarkPlace.
    [0x98] u8[5] landmark_under_construction;
    // The current rotation of a landmark at a specific MJILandmarkPlace. This array is indexed by the
    // RTowId of an MJILandmarkPlace. Known values: 0 - Default 1 - 90 Degrees Clockwise 2 - 180 Degrees 3
    // - 90 Degrees Counterclockwise
    [0x9D] u8[5] landmark_rotation;
    // A struct representing the current state of workshops present on the island. See the struct
    // documentation for more information on how to access this data. This struct only provides mapping
    // from a workshop ID to other data.
    [0xA8] MJIWorkshops workshops;
    // A struct representing the current state of granaries present on the island. See the struct
    // documentation for more information on how to access this data.
    [0xC8] MJIGranaries granaries;
    // The current level of the Cozy Cabin for the Island Sanctuary. This field is offset by 1 compared to
    // the level present in MJIBuildings. Cabin Level 3 will actually have a value of 3 in this field. This
    // is *probably* because Cabin Level 0 is "nonexistent"..?
    [0xE0] u8 cabin_level;
    // The current glamour cast on the Cozy Cabin (if any). Relates to the appropriate sub-row in
    // MJIBuilding. This field is *not* offset by one like CabinLevel; Cabin Level 3 will report here as 2.
    [0xE1] u8 cabin_glamour;
}

bitfield MJIAllowedVisitors : u8 {
    [Bit(0)] bool friends;
    [Bit(1)] bool free_company;
    [Bit(2)] bool party;
}

[Size(0x34)]
struct MJIAnimal {
    [0x0] u8 slot_id;
    [0x1] utf8[24] nickname;
    [0x1C] u32 bnpc_name_id;
    [0x20] u32 entity_id;
    // Row index in MJIAnimals sheet.
    [0x24] u8 animal_type;
    // Value representing the animal's current food level. Decreases once every hour. Appears to cap at 36.
    [0x25] u8 food_level;
    // The animal's current mood. Ranges from 0 for "very unhappy" (lightning icon) to 4 for "very happy"
    // (sun icon).
    [0x26] u8 mood;
    // True if there are some leavings that you can manually collect.
    [0x27] bool manual_leavings_available;
    // True if this animal is managed by a mammet.
    [0x28] bool under_care;
    // True if mammet was paid for care already - if true, dismissing and re-entrusting won't cost
    // anything.
    [0x29] bool was_under_care;
    // True if not cared for, either because mammet was not assigned, or because it was not paid.
    [0x2A] bool care_halted;
    // 0 if not under care, otherwise Item row id of used food.
    [0x2C] u32 auto_food_item_id;
    // Number of leavings of each type automatically gathered by a mammet that are ready for collection.
    [0x30] u8 auto_available_leavings1;
    [0x31] u8 auto_available_leavings2;
}

// A record of building population information at a specific Site ID.
[Size(0x10)]
struct MJIBuildingPlacement {
    // At load, the location of this specific building. Will update if a building is changed, but the exact
    // mechanism of the update (and why it does such) is not currently known.
    [0x4] u32 place_id;
    // The current SGB ID of this particular building. When a building is fully constructed, this will be
    // the value present at offset +0x0C from MJIBuilding. While a building is under construction, however,
    // the appropriate model (as determined by progress) will be shown from columns +0E, +10, +12, or +14.
    // Can also be zero, if nothing is built in that location yet.
    [0x8] u16 sgb_id;
}

[Size(0x4)]
struct MJIFarmPasture {
    [0x0] u8 level;
    [0x1] u8 hours_to_completion;
    [0x2] bool under_construction;
    [0x3] u8 eligible_for_care;
}

// A record of landmark population information at a specific Site ID.
[Size(0xC)]
struct MJIFarmPasturePlacement {
    // The SGB ID of the model to use for this location
    [0x8] u8 sgb_id;
}

[Size(0x148)]
struct MJIFarmState {
    [0x18] bool layout_initialized;
    [0x1A] u16 reaction_event_object_row_id;
    [0x20] u8[20] seed_type;
    [0x34] u8[20] growth_level;
    [0x48] u8[20] water_level;
    [0x5C] u8[20] gardener_yield;
    [0x70] FarmSlotFlags[20] farm_slot_flags;
    [0x88] u32[20] plot_object_index;
    [0xD8] u32[20] layout_id;
    [0x128] STD.StdVector<u32> seed_item_ids;
    [0x140] i32 expected_total_yield;
    [0x144] bool slot_update_pending;
    [0x145] u8 slot_update_index;
    // Start care for specified slot, planting specified seed.
    [Sig("48 89 5C 24 ?? 57 48 83 EC 30 41 8B D8 8B FA E8 ?? ?? ?? ?? 48 85 C0", FirstMatch)] void entrust(u32 slot, u32 seed_item_id);
    // Stop care for specified slot.
    [Sig("E8 ?? ?? ?? ?? E9 ?? ?? ?? ?? 48 8D 4F 10 E8 ?? ?? ?? ?? 48 8D 4F 20 8B F0 E8 ?? ?? ?? ?? 84 C0", FirstMatch, Offset(1), Rel32)] void dismiss(u32 slot);
    // Collect yield from a single slot.
    [Sig("E8 ?? ?? ?? ?? E9 ?? ?? ?? ?? E8 ?? ?? ?? ?? 48 85 C0 0F 84 ?? ?? ?? ?? E8 ?? ?? ?? ?? 48 8B 88 ?? ?? ?? ??", FirstMatch, Offset(1), Rel32)] void collectSingle(u32 slot);
    // Collect yield from a single slot and stop care.
    [Sig("40 53 48 83 EC 30 8B DA E8 ?? ?? ?? ?? 48 85 C0 74 26", FirstMatch)] void collectSingleAndDismiss(u32 slot);
    // Update expected total yield field - this is checked by the CollectAll function, which errors out if
    // new items were gathered since last update.
    [Sig("E8 ?? ?? ?? ?? E9 ?? ?? ?? ?? 48 8D 4F 20 E8 ?? ?? ?? ?? 0F B6 F8", FirstMatch, Offset(1), Rel32)] void updateExpectedTotalYield();
    // Try to collect yields from all slots.
    [Sig("E8 ?? ?? ?? ?? C7 03 ?? ?? ?? ?? 84 C0 74 1A", FirstMatch, Offset(1), Rel32)] bool collectAll(bool allow_overcap);
}

[Size(0x50)]
struct MJIFavorState {
    [0x0] MJIManager* manager;
    [0x18] u8[9] craft_object_ids;
    [0x21] u8[9] num_delivered;
    [0x2A] u8[9] flags1;
    [0x33] u8[9] flags2;
    [0x3C] u8[9] num_scheduled;
    [0x48] i32 update_state;
}

// A struct representing a list of granaries present in the Island Sanctuary. The struct provides a
// helper method to retrieve information about a single granary (referenced by ID), but will otherwise
// allow querying a specific field by ID directly.
[Size(0x12)]
struct MJIGranaries {
    [0x0] u8[2] place_id;
    [0x2] u8[2] glamour_level;
    [0x4] u8[2] hours_to_completion;
    [0x6] u8[2] building_level;
    [0x8] u8[2] under_construction;
}

[Size(0x98)]
struct MJIGranariesState {
    [0x0] MJIGranaryState[2] granary;
    [Sig("E8 ?? ?? ?? ?? 33 F6 89 B7 ?? ?? ?? ?? E9 ?? ?? ?? ?? 48 8D 55", FirstMatch, Offset(1), Rel32)] void collectResources(u8 granary_index);
    [Sig("E8 ?? ?? ?? ?? 41 FE C6 49 FF C7", FirstMatch, Offset(1), Rel32)] void selectExpeditionCommit(u8 granary_index, u8 expedition_id, u8 num_days);
}

[Size(0x48)]
struct MJIGranaryState {
    [0x0] u8 active_expedition_id;
    [0x1] u8 remaining_days;
    [0x2] u8 rare_resource_pouch_id;
    [0x4] i16 rare_resource_count;
    [0x6] u8[20] normal_resource_pouch_ids;
    [0x1A] u8[20] normal_resource_counts;
    [0x44] i32 finish_time;
}

// A record of landmark population information at a specific Site ID.
[Size(0x10)]
struct MJILandmarkPlacement {
    [0x8] u8 hours_to_completion;
    // The RowID of the landmark currently present at the specified location.
    [0x9] u8 landmark_id;
    [0xA] u16 under_construction;
    [0xC] u16 rotation;
}

// Manager for Island Sanctuary (internally MJI).
[Size(0x440)]
struct MJIManager {
    [0x0] u16 territory_id;
    [0x2] bool unk2;
    [0x3] bool unk3;
    [0x4] bool unk4;
    [0x5] bool unk5;
    // Reports if the player is currently on the Island Sanctuary.
    [0x6] bool is_player_in_sanctuary;
    // Represents the currently allowed visitors to the Island Sanctuary.
    [0x8] MJIAllowedVisitors allowed_visitors;
    // The current mode (as listed in MJIHudMode) that the player is in.
    [0x10] u32 current_mode;
    // The currently-selected item for the player's gathering mode. Will only have a value if the gathering
    // mode in question supports item usage.
    [0x1C] u32 current_mode_item;
    [0x28] IslandState island_state;
    [0x128] MJIPastureHandler* pasture_handler;
    [0x130] MJIFarmState* farm_state;
    [0x140] MJIGranariesState* granaries_state;
    [0x168] MJIFavorState* favor_state;
    // A struct representing landmark placements on the Island Sanctuary. Each index represents a specific
    // landmark slot directly. Refer to `MJILandmarkPlacement` for more information. This field's exact
    // purpose is currently unknown, but seems to be related to either mapping or rendering logic. To that
    // end, this field doesn't actually seem authoritative for determining what's going on - see
    // `LandmarkIds` et al for what seems to be used by system logic.
    [0x1D4] MJILandmarkPlacement[5] landmark_placements;
    // A struct representing building placements on the Island Sanctuary. Each index represents a specific
    // building slot directly. Refer to `MJIBuildingPlacement` for more information. This field's exact
    // purpose is currently unknown, but seems to be related to either mapping or rendering logic. To that
    // end, this field doesn't actually seem authoritative for determining what's going on - see
    // `granaries` and `workshops` for what seems to be used by system logic.
    [0x224] MJIBuildingPlacement[6] building_placements;
    // A struct representing information about the cabin. Like `MJIBuildingPlacements`, the purpose of this
    // field is unknown but it at least appears to behave like any other building placement.
    [0x284] MJIBuildingPlacement cabin_placement;
    // A struct representing farm (garden/cropland) placements on the current Island Sanctuary.
    [0x294] MJIFarmPasturePlacement[3] farm_placements;
    // A struct representing pasture placements on the current Island Sanctuary. Identical in behavior
    // (hopefully) to that of `FarmPlacements`
    [0x2B8] MJIFarmPasturePlacement[3] pasture_placements;
    [0x2E0] u16 request_demand_craft_id;
    [0x2E4] i32 request_demand_type;
    [0x2E8] bool demand_dirty;
    // A reference to the current set of popularity scores given to craftworks on the player's island. The
    // actual popularity scores can be pulled from the MJICraftworksPopularity sheet using this value as a
    // Row ID. Valid only if DemandDirty == false.
    [0x2F0] u8 current_popularity;
    // A reference to the next cycle's popularity scores (called "predicted demand" in-game). Follows the
    // same rules as `current_popularity`. Valid only if DemandDirty == false.
    [0x2F1] u8 next_popularity;
    // An array of bytes representing the current supply and demand shift for each craftwork that the
    // player can create. Information for a specific item can be retrieved by querying the RowID for the
    // item under inspection. Valid only if DemandDirty == false. The current supply value is stored in the
    // upper half of each byte, while the current demand shift is stored in the lower half.
    [0x2F2] u8[91] supply_and_demand_shifts;
    // The current day in the Craftworks cycle, from 0 to 6. 0 represents reset day (Tuesday).
    [0x3A8] u8 current_cycle_day;
    // An array containing the currently-configured rest days for the Isleworks. Contains values 0 - 13,
    // and is always in order. Like CurrentCycleDay, 0 represents Reset Day. 7, likewise, represents the
    // next reset. This field may not be populated until the Craftworks have been opened at least once.
    [0x3A9] u8[4] craftworks_rest_days;
    // The current groove level of the Isleworks. May not be present until the Isleworks is loaded at least
    // once by the player.
    [0x3F6] u32 current_groove;
    [Sig("48 8B 05 ?? ?? ?? ?? 0F B6 44 01", FirstMatch, Offset(3), Rel32)] static MJIManager* instance;
    // Check if a specific MJIRecipe is *unlocked*. Does not care if the item has been crafted.
    [Sig("0F B7 C2 80 E2 07", FirstMatch)] bool isRecipeUnlocked(u16 recipe_id);
    // Check if a specific item in the Island Pouch is (un)locked. See `LockedPouchItems` for more
    // information. This method simply looks a value up from that array.
    [Sig("0F B7 C2 0F B6 44 08", FirstMatch)] bool isPouchItemLocked(u16 item_id);
    // Check if an item (by EXD item ID) is locked in Island Sanctuary. This method performs *no
    // validation* that the Item passed to it is actually an Island Sanctuary item. This method performs an
    // EXD lookup. If the Item is already known, it is better to query `LockedPouchItems` by the
    // AdditionalData field of the Item to avoid the unnecessary call.
    [Sig("E8 ?? ?? ?? ?? 84 C0 74 04 33 ED", FirstMatch, Offset(1), Rel32)] bool isItemLocked(u32 item_id);
    // Checks if a specific MJIFunction is unlocked and able to be used
    [Sig("E8 ?? ?? ?? ?? 40 88 77 30", FirstMatch, Offset(1), Rel32)] bool isFunctionUnlocked(u8 function_id);
    // Get a bitfield representing the currently-displayed minimap icons.
    [Sig("E8 ?? ?? ?? ?? 85 47 40", FirstMatch, Offset(1), Rel32)] MJIMinimapIcons getVisibleMinimapIcons();
    // Gets the total number of slots available in the Island Sanctuary pasture.
    [Sig("E8 ?? ?? ?? ?? 44 0F B6 E0 49 8D BD ?? ?? ?? ??", FirstMatch, Offset(1), Rel32)] u8 getPastureSlotCount();
    // Gets the total number of slots available Island Sanctuary farm.
    [Sig("E8 ?? ?? ?? ?? 45 33 F6 0F B6 D0", FirstMatch, Offset(1), Rel32)] u8 getFarmSlotCount();
    // Request updated popularity and demand data.
    [Sig("48 83 EC 38 80 B9 ?? ?? ?? ?? ?? C7 81 ?? ?? ?? ?? ?? ?? ?? ?? 74 1F", FirstMatch)] void requestDemandFull();
    // Schedule specified item to be crafted in a given workshop at a given time.
    [Sig("E8 ?? ?? ?? ?? 48 8B 47 ?? 8D 4B ?? 48 69 D1", FirstMatch, Offset(1), Rel32)] void scheduleCraft(u16 craft_object_id, u8 starting_hour, u8 cycle, u8 workshop);
    // Request updated favor data.
    [Sig("E8 ?? ?? ?? ?? 49 8B 46 28 C7 00", FirstMatch, Offset(1), Rel32)] void requestFavorData();
}

bitfield MJIMinimapIcons : u8 {
    [Bit(0)] bool trees;
    [Bit(1)] bool vegetation;
    [Bit(2)] bool soils;
    [Bit(3)] bool minerals;
    [Bit(4)] bool aquatic;
}

[Size(0xC)]
struct MJIMinionSlot {
    // An internal ID used to track minion slots. May be set to 40 if the slot is currently empty or
    // uninitialized.
    [0x0] u8 slot_id;
    [0x4] u32 entity_id;
    [0x8] u16 minion_id;
    // The MJIMinionPopAreaId that this minion currently resides in.
    [0xA] u8 pop_area_id;
}

[Size(0xB78)]
struct MJIPastureHandler : Event.EventHandler {
    // Mapping from MJIAnimal row id to Item row ids for both leavings.
    [0x260] STD.StdMap<u32, STD.StdPair<u32, u32>> animal_to_leaving_item_ids;
    // Per-item totals of uncollected leavings. Key is Item sheet row id, value is total amount for all
    // animals.
    [0x280] STD.StdMap<u32, i32> available_mammet_leavings;
    // An array representing all animals currently present in the pastures on the Island.
    [0x290] MJIAnimal[20] mji_animals;
    // An array representing which minions are currently out roaming the Island. This array is indexed by
    // row ID from the Companion EXD sheet. See `MinionSlots` if information about minion locations is
    // required.
    [0x6A0] bool[600] roaming_minions;
    // An array containing information on all the minion slots present on the Island Sanctuary. This array
    // is indexed by an internal ID and does not appear to be grouped by location or similar.
    [0x8F8] MJIMinionSlot[50] minion_slots;
    // Collect all leavings gathered by mammets.
    [Sig("48 83 EC 38 E8 ?? ?? ?? ?? 45 33 C9 C7 44 24 ?? ?? ?? ?? ?? 45 33 C0 8B D0 B9 ?? ?? ?? ?? E8 ?? ?? ?? ?? 48 83 C4 38 C3 CC CC CC CC CC CC CC CC 40 53", FirstMatch)] void collectLeavingsAll();
    // Gets the current number of minions roaming the Island Sanctuary.
    [Sig("32 C0 4C 8D 81 ?? ?? ?? ?? 41 B9 ?? ?? ?? ?? 90 41 81 38 ?? ?? ?? ??", FirstMatch)] u8 getCurrentRoamingMinionCount();
}

// A struct representing a list of workshops present in the Island Sanctuary. The struct provides a
// helper method to retrieve information about a single workshop (referenced by ID), but will otherwise
// allow querying a specific field by ID directly.
[Size(0x1C)]
struct MJIWorkshops {
    // The MJIBuildingPlace in which this particular building resides. If this building is not built, this
    // value will be zero.
    [0x0] u8[4] place_id;
    // The glamour level of a particular building. This value refers to a specific sub-row of MJIBuilding.
    // This level is one less than the building's level; Workshop III will report as 2.
    [0x4] u8[4] glamour_level;
    // Hours remaining in the construction/upgrade of a building. If the building is done or is not under
    // construction, this value will be zero.
    [0x8] u8[4] hours_to_completion;
    // The true level of a particular building. Like GlamourLevel, also refers to a specific sub-row of
    // MJIBuilding. This level is one less than the building's level; Workshop III will report as 2.
    [0xC] u8[4] building_level;
    // Report if a specific building is currently under construction. May report 1 while HoursToCompletion
    // is 0 if the building needs to be "finalized" through user interaction. So far the only observed
    // value for this field is 0 or 1, but more values may exist (?).
    [0x10] u8[4] under_construction;
}
