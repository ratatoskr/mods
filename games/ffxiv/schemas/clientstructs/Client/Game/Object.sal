[Size(0x1C0)]
struct AreaObject {
}

// Enum for `sub_kind` when `object_kind` is `battle_npc`.
enum BattleNpcSubKind : u8 {
    none = 0,
    // Weak Spots
    b_npc_part = 1,
    // Carbuncle, Eos/Selene, Machinists Rook Autoturret/Automaton Queen, Whitemages Lilybell, probably
    // more.
    pet = 2,
    // Chocobo Companion
    buddy = 3,
    // Player
    player = 4,
    // Enemies, Guards
    combatant = 5,
    // Chocobos in Chocobo Racing
    race_chocobo = 6,
    // Minions in Lord of Verminion
    lovm_minion = 7,
    // Squadron, Trust, Duty Support
    npc_party_member = 9,
}

