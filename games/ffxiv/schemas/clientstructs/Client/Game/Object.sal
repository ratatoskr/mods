namespace Treasure {
    bitfield TreasureFlags : u8 {
        [Bit(0)] bool opened;
        // Sometimes set when fading starts, sometimes when fading is complete. It depends upon when
        // TreasureState 3 happens.
        [Bit(1)] bool faded_out;
        [Bit(2)] bool unk4;
        // none is none of them
    }

    enum TreasureKind : u8 {
        unknown = 0,
        levequest = 1,
        dungeon_raid = 2,
        unk3 = 3,
        treasure_hunt = 4,
        personal_loot = 5,
    }

    enum TreasureState : u8 {
        unopened = 0,
        opening = 1,
        opened = 2,
        unk3 = 3,
        fading_out = 4,
        faded_out = 5,
    }
}
