[Size(0x210)]
struct Treasure : GameObject {
    // Has a lot of overlap with `flags`.
    [0x1A0] Treasure.TreasureState state;
    // Starts counting down in seconds from `countdown_start_time` once spawned. Unsure what hitting zero
    // actually does in the unopened state. If the treasure contains rollable items, opening the it resets
    // this to the claim period length and it starts counting down again (except when lootmaster is active,
    // in which case it resets to zero). This value is rounded to nearest whole number and shown as the
    // loot window timer.
    [0x1A4] f32 countdown_time;
    // The starting value of `countdown_time` (in seconds) at initial object spawn.
    [0x1A8] f32 countdown_start_time;
    // The number of seconds available after opening the treasure to be able to roll on or assign drops
    // before auto-disposition of loot.
    [0x1AC] f32 claim_time;
    // The Item sheet row IDs for the contents of this treasure that have been added to the loot window.
    [0x1B0] u32[16] lootable_item_ids;
    // The number of valid item IDs in `LootableItemIds`.
    [0x1F0] u8 item_count;
    [0x1F4] i32 unk1_f4;
    // How many seconds the treasure has been open. Starts from zero when opening. Stops when fadeout
    // begins.
    [0x1F8] f32 treasure_open_time;
    // Has a lot of overlap with `state`.
    [0x1FC] Treasure.TreasureFlags flags;
    // Seems to be -1 for treasures that can spawn in non-fixed locations (i.e., enemies dropping coffers,
    // deep dungeon). Have only otherwise seen zero.
    [0x1FE] i16 unk1_fe;
    [0x200] Treasure.TreasureKind coffer_kind;
    // Non-zero when the base ID does not have an SGB entry in the Treasure sheet. So far only seen for
    // treasure hunt coffers.
    [0x204] i32 exported_sg_row_id;
}

bitfield VisibilityFlags : u64 {
    [Bit(1)] bool model;
    [Bit(11)] bool nameplate;
    // none is none of them
}

