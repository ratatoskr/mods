enum EventHandlerContent : u16 {
    // See Quest sheet.
    quest = 1,
    // See Warp sheet.
    warp = 2,
    gathering_point = 3,
    // See GilShop sheet.
    shop = 4,
    aetheryte = 5,
    // See GuildleveAssignment sheet.
    guild_leve_assignment = 6,
    // See DefaultTalk sheet.
    default_talk = 9,
    craft = 10,
    // See CustomTalk sheet.
    custom_talk = 11,
    company_leve_officer = 12,
    // See ArrayEventHandler sheet.
    array = 13,
    // See CraftLeve sheet.
