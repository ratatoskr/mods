    gimmick_accessor = 15,
    gimmick_bill = 16,
    gimmick_rect = 17,
    // See ChocoboTaxiStand sheet.
    chocobo_taxi_stand = 18,
    // See Opening sheet.
    opening = 19,
    exit_range = 20,
    fishing = 21,
    // See GCShop sheet.
    grand_company_shop = 22,
    // See GuildOrderGuide sheet.
    guild_order_guide = 23,
    // See GuildOrderOfficer sheet.
    guild_order_officer = 24,
    // See ContentNpc sheet.
    content_npc = 25,
    // See Story sheet.
    story = 26,
    // See SpecialShop sheet.
    special_shop = 27,
    deep_dungeon = 28,
    // See InstanceContentGuide sheet.
    instance_content_guide = 29,
    // See HousingAethernet sheet.
    housing_aethernet = 30,
    // See SwitchTalk sheet.
    switch_talk = 31,
    mob_hunt = 32,
    // See Adventure sheet.
    adventure = 33,
    daily_quest_supply = 34,
    // See TripleTriad sheet.
    triple_triad = 35,
    // See GoldSaucerArcadeMachine sheet.
    gold_saucer_arcade_machine = 36,
    // Used in Mini Cactpot.
    lottery_daily = 37,
    // Used in Jumbo Cactpot.
    lottery_weekly = 38,
    race_chocobo_registrar = 39,
    // Q'nabyano (responding with GoldSaucerTalk#162) and Reymanaud (responding with GoldSaucerTalk#161)
    // use this.
    gold_saucer_talk = 41,
    // See FccShop sheet.
    free_company_credit_shop = 42,
    // See AetherCurrent sheet.
    aether_current = 43,
    // See ContentEntry sheet.
    content_entry = 44,
    // Used for Verminion Tables and Tournament Recordkeeper.
    verminion = 45,
    sky_island_entrance = 46,
    // Used for Stone, Sky, Sea. See DpsChallengeOfficer sheet.
    dps_challenge_officer = 47,
    beginner_training_officer = 48,
    retainer_buyback = 49,
    // See TopicSelect sheet.
    topic_select = 50,
    // See LotteryExchangeShop sheet.
    lottery_exchange_shop = 52,
    // See DisposalShop sheet.
    disposal_shop = 53,
    // Checks quest completion before handling something, for example opening the Scrip Exchange. See
