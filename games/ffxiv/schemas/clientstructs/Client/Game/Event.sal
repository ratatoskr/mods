enum TodoBarColor : i32 {
    blue = 0,
    red = 1,
    yellow = 2,
    white = 3,
    green = 4,
}

enum TodoJoinButtonType : u8 {
    joinable = 0,
    joined = 1,
}

// Director only supports types up to 11. FateDirector only supports types 0-6 and 11.
// MassivePcContentDirector supports all 16 types. DynamicEvent supports types 1, 5, 6, 8.
// QuestTodoList supports ??. See also `ObjectiveType` (same thing, different values).
enum TodoType : i32 {
    // Text. Available settings: - Text - Complete
    text = 0,
    // Text with current/needed count and a progress bar. Available settings: - Text - Complete -
    // CheckOnCompletion - CurrentCount - NeededCount Formatted with Addon#1146 (lnum1 = CurrentCount,
    // lnum2 = NeededCount, lstr3 = Text).
    fraction_bar = 1,
    // Text with count. Available settings: - Text - Complete - CurrentCount Formatted with Addon#1147
    // (lnum1 = CurrentCount, lnum2 = 0, lstr3 = Text).
    number = 2,
    // Text and a progress bar. Available settings: - Text - Complete - CurrentPercentage
    bar = 3,
    // Text and timer. Available settings: - Text - Complete - EndTimestamp Formatted with Addon#33 (via
    // RaptureTextModule.FormatSecondsRemaining).
    time_remaining = 4,
    // Progress Bar. Available settings: - CurrentPercentage - NeededPercentage When current value <=
    // minimum value, then the progress bar is red, otherwise yellow.
    large_bar = 5,
    // Text with current/needed count. Available settings: - Text - Complete - CheckOnCompletion -
    // CurrentCount - NeededCount Formatted with Addon#1146 (lnum1 = CurrentCount, lnum2 = NeededCount,
    // lstr3 = Text).
    fraction = 6,
    // Colorable Progress Bar. Available settings: - CurrentPercentage - BarColor
    colorable_bar = 7,
    // Large gray text. Available settings: - Text
    large_gray_text = 8,
    // Large gray text with count. Available settings: - Text - CurrentCount Formatted with Addon#1147
    // (lnum1 = CurrentCount, lnum2 = 0, lstr3 = Text).
    large_gray_number = 9,
    // Large gray text with current/needed count. Available settings: - Text - CurrentCount - NeededCount
    // Formatted with Addon#1146 (lnum1 = CurrentCount, lnum2 = NeededCount, lstr3 = Text).
    large_gray_fraction = 10,
    // Text with long progress bar. Available settings: - Text - Complete - CurrentPercentage
    long_bar = 11,
    // Quest title. Available settings: - Text - IconId
    quest_title = 12,
    // Large timer. Available settings: - Text (not really. needs lots of spaces after if used) -
    // EndTimestamp - Duration
    large_time_remaining = 13,
    // Large blue text. Available settings: - Text
    large_blue_text = 14,
    // Join button. Available settings: - JoinButtonType
    join_button = 15,
}

