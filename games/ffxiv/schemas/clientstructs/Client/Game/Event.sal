    // set_invis_base is 0xF8400FFF, no_default_camera and fade_out and invis_e_npc and invis_e_obj and invis_bnpc and invis_other_pc and invis_party_pc and invis_gathering_point and invis_aetheryte and invis_treasure and condition_cutscene and hide_ui and disable_stealth and invis_aoe and invis_party_buddy and invis_alliance_pc and invis_alliance_buddy and invis_companion
}

