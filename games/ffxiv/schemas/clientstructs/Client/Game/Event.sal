    pre_handler = 54,
    // See Description sheet.
    description = 55,
    // Used for Ishgardian Restoration (Firmament / Heavensward Development?!)
    hwd_dev = 56,
    // Used for Desynthesis (0x390000), Materia Extraction (0x390001), Aetherial Reduction (0x390002).
    materialize = 57,
    // See InclusionShop sheet.
    inclusion_shop = 58,
    // See CollectablesShop sheet.
    collectables_shop = 59,
    // Used for Island Sanctuary Pasture.
    mji_pasture = 60,
    // Used for Argos in Mare Lamentorum. See EventPathMove sheet.
    event_path_move = 61,
