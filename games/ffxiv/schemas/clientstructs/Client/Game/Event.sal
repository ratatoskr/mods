[Size(0x230), VirtualTable("48 8D 05 ?? ?? ?? ?? ?? ?? ?? 48 8D 05 ?? ?? ?? ?? 48 89 83 ?? ?? ?? ?? 48 8D 05 ?? ?? ?? ?? 89 8B", FirstMatch, Offset(3), Rel32)]
struct FishingEventHandler : EventHandler {
    // Inherited parent class accessor for `AtkEventInterface`
    [0x1B8] Component.GUI.AtkModuleInterface.AtkEventInterface atk_event_interface;
    [0x1C0] u8 unk220;
    [0x1C8] FishingState state;
    // 4 Hz inverse sawtooth between one and zero. Latches upon cast. No clue what it is for.
    [0x1CC] f32 unk22_c;
    // Whether you are at a fishing hole. Only indicates that you are at a hole, not whether you can
    // actually fish there. Only updates when on FSH.
    [0x1D0] bool can_fish;
    // Returns to false when opportunity is gone (i.e., Spareful Hand is used).
    [0x1D1] bool can_mooch_previous_catch;
    // Returns to false when opportunity is gone (i.e., 15s elapsed). Ignores skill cooldown.
    [0x1D2] bool can_mooch2_previous_catch;
    [0x1D3] bool can_release_previous_catch;
    // True while in the process of sitting down or standing up.
    [0x1D4] bool changing_position;
    [0x1D5] bool can_identical_cast_previous_catch;
    [0x1D6] bool can_surface_slap_previous_catch;
    [0x1D7] bool unk237;
    [0x1D8] FishingBaitFlags current_cast_bait_flags;
    // The index into `SwimBaitItemIds` of the currently-selected swimbait. This is -1 when no swimbait has
    // been selected.
    [0x1DC] i8 current_selected_swim_bait;
    // The item IDs of currently-stored swimbait.
    [0x1E0] u32[3] swim_bait_item_ids;
    [0x1EC] u32 unk24_c;
    // Unix time (in milliseconds) for when the current Mooch/Spareful Hand opportunity will cease being
    // available (if ever).
    [0x1F0] i64 mooch_opportunity_expiration_time;
    // Unix time (in milliseconds) for when actions like Surface Slap will cease being available.
    [0x1F8] i64 catch_action_expiration_time;
    [Virtual(276)] bool playAnimation(Character.Character* chara, u16 action_timeline_id, u64 callback_param);
}

enum FishingHookStrength : i32 {
    weak = 292,
    strong = 293,
    legendary = 294,
}

enum FishingState : i32 {
    none = 0,
    casting_out = 1,
    // Used when fish slips, when there is no bite, briefly after reeling in a fish, and when using Rest.
    pulling_pole_in = 2,
    quitting = 3,
    // The standby "gathering" condition.
    pole_ready = 4,
    bite = 5,
    // Includes the subsequent reeling in.
    hooking = 6,
    releasing_catch = 7,
    confirming_collectable = 8,
    // Only during the action's animation.
    ambitious_lure = 9,
    // Only during the action's animation.
    modest_lure = 10,
    unk11 = 11,
    // Or air, sand, etc.; just when you are actually fishing.
    line_in_water = 12,
}

