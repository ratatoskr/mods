bitfield ZoneInitFlags : u16 {
    [Bit(0)] bool is_initial_login;
    [Bit(1)] bool unknown1;
    [Bit(2)] bool unknown2;
    [Bit(3)] bool is_cross_world;
    [Bit(4)] bool is_flying_enabled;
    [Bit(5)] bool unknown5;
    [Bit(6)] bool unknown6;
    [Bit(7)] bool is_instanced_area;
    [Bit(8)] bool unknown8;
    [Bit(9)] bool unknown9;
    // none is none of them
}

[Size(0x88)]
struct ZoneInitPacket {
    [0x0] u16 server_id;
    [0x2] u16 territory_type_id;
    [0x4] u16 instance;
    [0x6] u16 content_finder_condition_id;
    [0x8] u32 transition_territory_filter_key;
