// Made from FFXIVClientStructs by tools/ClientStructsSal. Change that and run `zig build client-structs`,
// since this is written again.

namespace Client.Game.Network;

[Size(0x222)]
struct AchievementsPacket {
    [0x0] u8[510] completed_achievements;
    [0x1FE] u16[5] history;
    [0x208] u8[16] unk208;
    [0x218] u64 unk218;
    [0x220] u16 unk220;
}

[Size(0x20)]
struct ActorCastPacket {
    [0x0] u16 spell_id;
    [0x2] u8 action_type;
    [0x3] u8 omen_delay;
    [0x4] u32 action_id;
    [0x8] f32 cast_time;
    [0xC] u32 target_entity_id;
    [0x10] u16 rotation_int;
    [0x12] bool interruptible;
    [0x14] u32 ballista_entity_id;
    [0x18] u16[3] position_int;
}

[Size(0x18)]
struct ActorSetPosPacket {
    [0x0] u16 rotation;
    [0x2] u8 warp_type;
    [0x3] u8 arg;
    [0x4] u32 transition_territory_filter_key;
    [0x8] Vec3 position;
}

