    [0x15] u8 unk_input_timer_flags;
    [0x20] u32 ranked_crystalline_conflict_hosting_data_center_id;
    [0x24] bool is_limited_time_bonus_active;
    [0x26] u16[8] game_festival_ids;
    [0x36] u16[8] game_festival_phases;
    [0x46] u16[8] ui_festival_ids;
    [0x56] u16[8] ui_festival_phases;
    [0x68] f32 position_x;
    [0x6C] f32 position_y;
    [0x70] f32 position_z;
    [0x74] u8[11] content_roulette_role_bonuses;
    [0x80] i32[2] penalty_timestamps;
}

namespace CommonSpawnData {
    [Size(0xC)]
    struct StatusEffect {
        [0x0] u16 status_id;
        [0x2] u16 param;
        [0x4] f32 remaining_time;
        [0x8] u32 source_object_id;
    }
}

namespace CrossRealmListingSegmentPacket {
    // This struct differs slightly from AgentLookingForGroup.Detailed!
    [Size(0x190)]
    struct CrossRealmListing {
        [0x0] u64 listing_id;
        [0x8] u64 account_id;
        [0x10] u64 content_id;
        [0x1C] u32 category;
        // ContentFinderCondition RowId or LFGExtensionContent RowId (or ...?) depending on DutyType
        [0x20] u16 duty;
        [0x22] u16 duty_type;
        [0x2E] u16 world_id;
        [0x38] u8 objective;
        [0x39] u8 beginners_welcome;
        [0x3A] u8 completion_status;
        [0x3B] u8 duty_finder_settings;
        [0x3C] u8 loot_rule;
        [0x40] i32 last_patch_hotfix_timestamp;
        [0x44] u16 time_left;
        [0x4C] u16 avg_item_lv;
        [0x4E] u16 home_world_id;
        [0x50] u16 current_world_id;
        [0x52] u8 client_language;
        [0x53] u8 total_slots;
        [0x54] u8 slots_filled;
        [0x56] u8 join_condition_flags;
        [0x57] bool is_alliance;
        [0x58] u8 number_of_parties;
        [0x60] u64[8] slot_flags;
        [0xA0] u8[8] jobs_present;
        [0xA8] utf8[32] name;
        [0xC8] utf8[192] description;
    }
}

namespace FateRewardPacket {
    [Size(0x8)]
    struct ItemReward {
        [0x0] u32 item_id;
        [0x4] u32 amount;
    }
}

namespace HousingPortalPacket {
    [Size(0x28)]
    struct HouseInfoEntry {
        [0x0] u32 house_price;
        [0x4] HouseInfoFlags info_flags;
        // HousingAppeal RowIds
        [0x5] u8[3] house_appeals;
        [0x8] utf8[32] owner_name;
    }

    bitfield HouseInfoFlags : u8 {
        [Bit(0)] bool plot_owned;
        [Bit(1)] bool visitors_allowed;
        [Bit(2)] bool has_search_comment;
        [Bit(3)] bool house_built;
        [Bit(4)] bool owned_by_fc;
    }
}

namespace QueueUpdatePacket {
    bitfield Language : u8 {
        [Bit(0)] bool japanese;
        [Bit(1)] bool english;
        [Bit(2)] bool german;
        [Bit(3)] bool french;
    }

    bitfield QueueFlags : u64 {
        [Bit(0)] bool unk0;
        [Bit(1)] bool request_join_party_in_progress;
        [Bit(2)] bool initiated_by_party_member;
        [Bit(3)] bool reqs_disabled;
        [Bit(4)] bool unk4;
        [Bit(5)] bool unk5;
        [Bit(6)] bool unk6;
        [Bit(7)] bool in_progress_party;
        [Bit(8)] bool unk8;
        [Bit(9)] bool unk9;
        [Bit(10)] bool unk10;
        [Bit(11)] bool greed_only;
        [Bit(12)] bool unk12;
        [Bit(13)] bool unrestricted;
        [Bit(14)] bool min_ilvl;
        [Bit(15)] bool unk15;
        [Bit(16)] bool lootmaster;
        [Bit(17)] bool unk17;
        [Bit(18)] bool unk18;
        [Bit(19)] bool unk19;
        [Bit(20)] bool unk20;
        [Bit(21)] bool is_synced;
        [Bit(22)] bool limited_leveling_roulette;
        [Bit(23)] bool unk23;
        [Bit(24)] bool unk24;
        [Bit(25)] bool unk25;
        [Bit(26)] bool unk26;
        [Bit(27)] bool unk27;
        [Bit(28)] bool silence_echo;
        [Bit(29)] bool unk29;
        [Bit(30)] bool unk30;
        [Bit(31)] bool unk31;
        [Bit(32)] bool is_explorer;
        // none is none of them
    }
}
