[Size(0x28)]
struct ContentsFinderNotificationPacket {
    [0x0] Enums.ContentsFinderQueueState queue_state;
    // The ID of the ContentFinderCondition EXD that has popped.
    [0x1C] u16 content_finder_condition_id;
}

// Packet for Party Finder listings. Received by `receiveListing`. Entries passed to
// `AgentLookingForGroup`.
[Size(0x650)]
struct CrossRealmListingSegmentPacket {
    [0x0] u32 unk10;
    // Starts at 1, counts up, ends with 0
    [0xC] u16 segment_index;
    [0x10] CrossRealmListingSegmentPacket.CrossRealmListing[4] entries;
}

bitfield FateRewardFlag : u8 {
    [Bit(0)] bool success;
    [Bit(3)] bool suppress_popup;
    [Bit(4)] bool bonus;
}

enum FateRewardMedal : u8 {
    gold = 0,
    silver = 1,
    bronze = 2,
    critical_engagement = 3,
}

[Size(0x48)]
struct FateRewardPacket {
    [0x0] u32 experience;
    [0x4] u32 bonus_experience;
    [0x8] u32 gil_amount;
    [0xC] u32 gc_seals_amount;
    [0x10] u32 item_id;
    [0x14] u32 fate_token_type_amount;
    [0x18] u16 fate_id;
    [0x1A] u16 item_amount;
    [0x1C] u8 fate_token_type_id;
    [0x1D] FateRewardFlag flags;
    [0x1E] FateRewardMedal medal;
    [0x20] FateRewardPacket.ItemReward[5] item_rewards;
}

[Size(0x46)]
struct GearsetDrawDataPacket {
    // Stores the weapon data. Includes both dyes in the data.
    [0x0] Character.WeaponModelId mainhand_weapon_data;
    [0x8] Character.WeaponModelId offhand_weapon_data;
    [0x10] u8 crest_bit_field;
    [0x11] u8 job_id;
    [0x12] u8 unk12;
    [0x13] u8 unk13;
    [0x14] Character.LegacyEquipmentModelId[10] equipment_model_ids;
    [0x3C] u8[10] equipment_secondary_dyes;
}

[Size(0x96C)]
struct HousingPortalPacket {
    [0x0] HouseId house_id;
    [0x8] HousingPortalPacket.HouseInfoEntry[60] house_info_entries;
}

[Size(0x118)]
struct HousingSignboardPacket {
    [0x0] HouseId house_id;
    [0x14] bool is_open;
    // Small = 0 Medium = 1 Large = 2 Apartment = 5?
    [0x15] u8 size;
    // See `EstateType`.
    [0x16] u8 estate_type;
    [0x17] utf8[21] name;
    [0x2E] utf8[193] greeting;
    [0xEF] utf8[31] owner_name;
    [0x10E] utf8[4] fc_tag;
    // HousingAppeal RowIds
    [0x115] u8[3] house_appeals;
}

// Packet for `handleInventoryItemCurrencyPacket`
[Size(0x14)]
struct InventoryItemCurrencyPacket {
    [0x0] u32 context_id;
    [0x4] u16 inventory_type;
    [0x6] u16 slot;
    [0x8] u32 quantity;
    [0x10] u32 item_id;
}

// Packet for `handleInventoryItemPacket` and `handleInventoryItemUpdatePacket`
[Size(0x3D)]
struct InventoryItemPacket {
    [0x0] u32 context_id;
    [0x8] u16 inventory_type;
    [0xA] u16 slot;
    [0xC] u32 quantity;
    [0x10] u32 item_id;
    [0x18] u64 crafter_content_id;
    [0x20] u8 item_flags;
    [0x22] u16 condition;
    [0x24] u16 spiritbond_or_collectability;
    [0x28] u32 glamour_id;
    [0x2C] u16[5] materia;
    [0x36] u8[5] materia_grades;
    [0x3B] u8[2] stains;
}

// Packet for `handleInventoryItemSymbolicPacket`
[Size(0x10)]
struct InventoryItemSymbolicPacket {
    [0x0] u32 context_id;
    [0x4] u16 inventory_type;
    [0x6] u16 slot;
    [0x8] u32 quantity;
    [0xC] u16 target_inventory_type;
    [0xE] u16 target_slot;
}

[Size(0x10)]
struct MapEffectPacket {
    [0x0] u32 event_id;
    [0x4] u16 state;
    [0x6] u16 timeline_index;
    // Which map effect this applies to.
    [0x8] u8 index;
}

[Size(0x10)]
struct PrepareZoningPacket {
    // If non-zero, inserts this message into the chat. Index into the LogMessage Excel sheet.
    [0x0] u32 log_message_id;
    // What territory is about to be loaded. Index into the TerritoryType Excel sheet.
    [0x4] u16 territory_type_id;
    // If non-zero, plays this VFX on the player character. Index into the VFX Excel sheet.
    [0x6] u16 vfx_id;
    // If non-zero, uses this VFX instead of the normal black background for the loading screen. Index into
    // the VFX Excel sheet.
    [0x8] u16 loading_screen_vfx_id;
    // See `WarpType`
    [0xA] u8 warp_type;
    // Functionally a boolean as far as I can tell, but there's a third mode of an unknown purpose. Unsure
    // if even used by retail.
    [0xB] u8 hide_character;
    // Unused by retail but what disassembly is left leads me to believe it controlled this at one point.
    // If set to 0xFF (255) then the fade out never occurs.
    [0xC] u8 fade_out_delay;
    // Miscellaneous flags like whether to hide the loading screen text.
    [0xD] u8 flags;
}

[Size(0x14)]
struct QueueInfoStatePacket {
    [0x0] Enums.ContentsFinderQueueState queue_state;
    [0x4] UI.QueueInfoState info_state;
}

[Size(0x28)]
struct QueueUpdatePacket {
    [0x0] Enums.ContentsFinderQueueState queue_state;
    [0x1] u8 class_job_id;
    [0x2] QueueUpdatePacket.Language language_flags;
    [0x8] QueueUpdatePacket.QueueFlags flags;
    [0x10] u8 roulette_id;
    [0x13] bool began_queue;
    [0x14] u32[5] content_finder_conditions;
}

struct ServerIpcSegment<T> {
    ServerIpcSegmentHeader header;
    T payload;
}

[Size(0x10)]
struct ServerIpcSegmentHeader {
    [0x0] u16 magic;
    [0x2] u16 op_code;
    [0x8] u16 server_id;
    [0xC] i32 timestamp;
}

[Size(0x290)]
struct SpawnNpcPacket {
    [0x0] u32 gimmick_id;
    // Instance ID of an Event NPC. Seen for Event NPCs that turn into Battle NPCs (during quests, for
    // example.)
    [0x4] u32 event_npc_instance_id;
    [0x8] u8 character_data_flags;
    [0x9] u8 character_data_icon;
    [0xA] u8 unk_a;
    // How many other BNpcs can be linked in this family.
    [0xB] u8 max_links;
    // If not zero, specifies which family this BNpc is linked to.
    [0xC] u8 link_family;
    // How far the link family can be apart.
    [0xD] u8 link_range;
    [0xE] u8 unk_e;
    [0xF] u8 unk_f;
    [0x10] CommonSpawnData common;
    [0x288] u8 unk288;
    [0x289] u8 unk289;
    [0x28A] u32 unk28_a;
}

[Size(0x40)]
struct SpawnObjectPacket {
    [0x0] u8 object_index;
    [0x1] u8 object_kind;
    [0x2] bool is_targetable;
    [0x3] bool is_hidden;
    // `HousingObjectId` when `housing_event_object`.
    [0x4] u32 base_id;
    [0x8] u32 entity_id;
    // Used for `event_obj` or `gathering_point`.
    [0xC] u32 layout_id;
    // Used for `event_obj`, or for `housing_event_object` as bool to decide whether it is a
    // `HousingCombinedObject` (true) or a `HousingEventObject` (false).
    [0x10] Event.EventId event_id;
    [0x14] u32 owner_id;
    // Used for `event_obj`.
    [0x18] u32 gimmick_id;
    [0x1C] f32 radius;
    [0x22] u16 rotation;
    // Used for `event_obj`.
    [0x24] u16 fate_id;
    // Used for `event_obj`.
    [0x26] u8 event_state;
    // Used by `gathering_point`, `event_obj`, `area_object`.
    [0x2C] u32 arg1;
    // Used by `gathering_point`, `event_obj`, `housing_event_object`.
    [0x30] u32 arg2;
    [0x34] f32 position_x;
    [0x38] f32 position_y;
    [0x3C] f32 position_z;
}

[Size(0x298)]
struct SpawnPlayerPacket {
    [0x0] u64 account_id;
