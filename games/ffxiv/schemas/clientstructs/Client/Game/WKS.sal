bitfield WKSMechaEventFlag : u32 {
    [Bit(2)] bool is_participating;
    [Bit(8)] bool pilot_registration_open;
    [Bit(9)] bool ground_support_teleport_open;
    [Bit(10)] bool is_event_active;
}

[Size(0xC8)]
struct WKSMechaEventMapMarker {
    [0x0] System.String.Utf8String name;
    [0x68] UI.MapMarkerData map_marker_data;
    [0xB8] u32 wks_mecha_event_data_row_id;
    [0xBC] u32 layout_id;
    [0xC0] u32 icon;
    // Type 1 = Icon 60493 Type 2 = Icon 63889 Type 3 + 4 = Icon 60492 Type 5 = Icon 63884
    [0xC4] u8 type;
    [0xC5] u8 flags;
    [0xC6] u8 map_marker_data_flags;
    [0xC7] u8 unk_c7;
}

