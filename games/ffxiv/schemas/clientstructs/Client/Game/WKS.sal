namespace Client.Game.WKS;

[Size(0x40)]
struct WKSContentInventoryContainer : ContentInventoryContainer {
    [0x28] STD.StdVector<WKSContentInventoryItem> wks_items;
    [Virtual(7)] void clearItems();
    [Virtual(8)] void setItem(InventoryType inventory_type, i16 slot, u32 item_id, u16 quantity);
    [Virtual(9)] void setItemEx(InventoryType inventory_type, i16 slot, u32 item_id, u16 quantity, InventoryItem.ItemFlags flags, u16 collectability);
}

[Size(0x60)]
struct WKSContentInventoryItem : ContentInventoryItem {
    [0x48] InventoryType wks_inventory_type;
    [0x4C] i16 wks_item_slot;
    [0x50] u32 wks_item_id;
    [0x54] i16 wks_item_quantity;
    [0x56] InventoryItem.ItemFlags wks_item_flags;
    [0x58] i16 wks_item_collectability;
}

[Size(0xA8)]
struct WKSContentInventoryProvider : ContentInventoryProvider {
    [0x28] WKSContentInventoryContainer cosmopouch1;
    [0x68] WKSContentInventoryContainer cosmopouch2;
}

bitfield WKSEventModuleFlag : u32 {
    [Bit(0)] bool has_current_event;
    [Bit(1)] bool pilot_application_submitted;
    [Bit(2)] bool pilot_application_accepted;
    [Bit(3)] bool pilot_cutscene_playing;
    [Bit(7)] bool is_joined;
}

