namespace WKSManager {
    enum MissionRank : i32 {
        none = 0,
        bronze = 1,
        silver = 2,
        gold = 3,
        failed = 5,
    }

    // Per-job state block. WKSState contains 11 of these (one per cosmic class job).
    [Size(0x148)]
    struct WKSJobState {
        [0x0] WKSMissionClassState[4] mission_classes;
        [0xB0] WKSMissionState extra_basic_mission;
        [0xC0] STD.StdVector<WKSMissionState> sequential_missions;
        [0xD8] STD.StdVector<WKSMissionState> provisional_missions;
        [0xF0] STD.StdVector<WKSMissionState> critical_missions;
        [0x108] i32 critical_mission_timestamp;
        [0x110] WKSMasterMissionState[3] master_missions;
        [0x140] u16 bonus_master_mission_unit_id;
    }

    [Size(0x10)]
    struct WKSMasterMissionState : WKSMissionState {
        [0xC] u32 unk_c;
    }

    [Size(0x2C)]
    struct WKSMissionClassState {
        [0x0] WKSMissionState[3] missions;
        [0x24] u8 unk24;
        [0x26] u32 unk26;
    }

    [Size(0xC)]
    struct WKSMissionState {
        [0x0] u16 mission_unit_id;
        // Used by AgentWKSMission to set silver/gold mission flags when this is 1 or 2.
        [0x4] u32 mission_flag;
        [0x8] u8 unk8;
        [0x9] u8 unk9;
        [0xA] u8 condition;
    }

    [Size(0x1088)]
    struct WKSState {
        [0x0] u8 unk00;
        [0x1] u8 unk01;
        [0x4] i32 project_state;
        [0x8] u16 unk08;
        // RowId of WKSDevGrade sheet.
        [0xA] u16 dev_grade;
        [0xC] i32 project_timestamp;
        // For Hub upgrades. RowId of WKSFateControl sheet.
        [0x10] u16 current_fate_control_row_id;
        // For Hub upgrades. Id of Fate in FateManager.
        [0x12] u16 current_fate_id;
        [0x14] u8 unk14;
        // 0-based WKSPioneeringTrail row index for the currently visited planet (sheet row = this + 1).
        [0x15] u8 current_planet_index;
        // 0-based WKSPioneeringTrail row index for the latest unlocked planet. (sheet row = this + 1)
        [0x16] u8 latest_planet_index;
        [0x18] WKSJobState[11] job_states;
        [0xE30] WKSMissionModule.MissionState current_mission;
        [0xE70] u8 consecutive_gold_count;
        [0xE74] u32 fishing_bait;
        [0xE81] u8[213] mission_completion_flags;
        [0xF56] u8[213] mission_gold_flags;
        [0x102C] i32[11] scores;
    }
}

namespace WKSMissionModule {
    enum MissionRank : i32 {
        none = 0,
        bronze = 1,
        silver = 2,
        gold = 3,
        failed = 5,
    }

    [Size(0x40)]
    struct MissionState {
        // RowId of WKSMissionUnit sheet.
        [0x0] u16 mission_unit_row_id;
        [0xC] u32 score_u_int;
        [0x10] MissionRank rank;
        [0x14] u8 unk14;
        [0x16] u16 collected_total;
        [0x18] u8 collected_individual;
    }
}
