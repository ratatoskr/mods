    [0x1140] WKSResearchModule* research_module;
    [0x1148] void* log_module;
    [0x1150] void* treasure_module;
    [0x1158] STD.StdVector<WKSModuleBase*> modules;
    [Sig("48 89 05 ?? ?? ?? ?? 48 8B F8", FirstMatch, Offset(3), Rel32)] static WKSManager* instance;
    [Sig("48 89 5C 24 ?? 48 89 6C 24 ?? 48 89 74 24 ?? 57 48 83 EC 20 0F B7 DA 48 8B F9 E8 ?? ?? ?? ?? 8B CB", FirstMatch)] void load(u16 territory_id);
    [Sig("E8 ?? ?? ?? ?? 0F B6 F8 49 8B 4E", FirstMatch, Offset(1), Rel32)] bool isFunctionUnlocked(u8 function_row_id);
}

