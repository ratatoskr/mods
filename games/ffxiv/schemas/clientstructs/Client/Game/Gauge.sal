// Made from FFXIVClientStructs by tools/ClientStructsSal. Change that and run `zig build client-structs`,
// since this is written again.

namespace Client.Game.Gauge;

bitfield AetherFlags : u8 {
    [Bit(0)] bool aetherflow1;
    [Bit(1)] bool aetherflow2;
    [Bit(2)] bool phoenix_primed;
    [Bit(3)] bool solar_bahamut_first_primed;
    [Bit(5)] bool ifrit_ready;
    [Bit(6)] bool titan_ready;
    [Bit(7)] bool garuda_ready;
    // none is none of them
    // aetherflow is 0x3, aetherflow1 and aetherflow2
    // solar_bahamut_second_primed is 0xC, phoenix_primed and solar_bahamut_first_primed
}

enum AstrologianCard : i32 {
    none = 0,
    balance = 1,
    bole = 2,
    arrow = 3,
    spear = 4,
    ewer = 5,
    spire = 6,
    lord = 7,
    lady = 8,
}

enum AstrologianDraw : u8 {
    astral = 0,
    umbral = 1,
}

[Size(0x30)]
struct AstrologianGauge : JobGauge {
    [0x8] i16 cards;
    [0xA] AstrologianDraw current_draw;
}

[Size(0x10)]
struct BardGauge : JobGauge {
    [0x8] u16 song_timer;
    [0xC] u8 repertoire;
    [0xD] u8 soul_voice;
    [0xE] u8 radiant_finale_coda;
    [0xF] SongFlags song_flags;
}

enum BeastChakraType : u8 {
    none = 0,
    opo_opo = 1,
    raptor = 2,
    coeurl = 3,
}

enum BeastmasterAffinity : u8 {
    none = 0,
    volant = 1,
    rampant = 2,
    durant = 3,
    eldritch = 4,
    sunstrider = 5,
    moonstalker = 6,
}

[Size(0x18)]
struct BeastmasterGauge : JobGauge {
    [0x8] u8 tp_gauge;
    [0x9] u8 pet_tp_gauge;
    [0xA] u8 pet_tp_at_last_use;
    [0xB] u8 active_battlehorn;
    [0xC] u8 instinctual_combo_state;
    [0xD] BeastmasterAffinity current_affinity;
    [0xE] u8 chain_count;
    // XBMPet.Classification is Addon row 17740 + Classification.
    [0xF] u8 kinship_state { [Bit(0)] u8 kinship_battlehorn : 4; [Bit(4)] u8 kinship_classification : 4; }
    [0x10] u8 instinct_state { [Bit(0)] u8 natural_instinct : 2; [Bit(2)] u8 mastered_instinct : 2; }
}

[Size(0x30)]
struct BlackMageGauge : JobGauge {
    [0x8] i16 enochian_timer;
    [0xA] i8 element_stance;
    [0xB] u8 umbral_hearts;
    [0xC] u8 polyglot_stacks;
    [0xD] u8 bit_field_d { [Bit(0)] bool enochian_active; [Bit(1)] bool paradox_active; [Bit(2)] u8 astral_soul_stacks : 3; }
}

bitfield CanvasFlags : u8 {
    [Bit(0)] bool pom;
    [Bit(1)] bool wing;
    [Bit(2)] bool claw;
    [Bit(3)] bool maw;
    [Bit(4)] bool weapon;
    [Bit(5)] bool landscape;
}

