        [0x468] u16 selected_index;
        [0x46C] u8 unk46_c;
        [0x46F] u8[8] num_available_note_book_divisions;
        [0x477] u8[8] num_available_secret_note_book_divisions;
    }

    [Size(0x400)]
    struct RecipeEntry {
        [0x0] RecipeIngredient[6] ingredients;
        [0x330] RecipeCrystal[2] crystals;
        [0x338] System.String.Utf8String item_name;
        [0x3A0] u32 icon_id;
        [0x3A4] u32 item_id;
        [0x3A8] u32 status_required;
        [0x3AC] u32 item_required;
        [0x3B0] bool requires_meister_soul_crystal;
        [0x3B2] u16 recipe_id;
        [0x3B4] u16 difficulty;
        [0x3B8] u32 quality;
        [0x3BC] u16 durability;
        [0x3BE] u8 material_quality_factor;
        [0x3C0] u16 required_craftsmanship;
        [0x3C2] u16 required_control;
        [0x3C4] u16 quick_synth_craftsmanship;
        [0x3C6] u16 quick_synth_control;
        [0x3C8] u16 secret_recipe_book;
        [0x3CC] u32 required_quality;
        [0x3D0] u16 suggested_craftsmanship;
        [0x3D2] u16 conditions_flag;
        [0x3D6] u8 amount_result;
        [0x3D7] u8 craft_type;
        [0x3D8] u8 class_job_level;
        [0x3DA] u8 stars;
        [0x3DE] u8 flags;
        [0x3DF] u8 flags2;
        [0x3E0] u32 number;
        [0x3E4] u16 recipe_level_table_id;
        [0x3E6] u16 patch_number;
        [0x3F0] u16 display_priority;
        [0x3F2] u16 max_adjustable_job_level;
        [0x3F4] u16 difficulty_factor;
        [0x3F6] u16 quality_factor;
        [0x3F8] u16 durability_factor;
    }

    [Size(0x88)]
    struct RecipeIngredient {
        [0x0] u16 unk0;
        [0x2] u16 unk2;
        [0x8] u8 nq_count;
        [0x9] u8 hq_count;
        [0x10] System.String.Utf8String name;
        [0x78] u32 item_id;
        [0x7C] u32 icon_id;
        [0x82] u8 amount;
        [0x83] u8 flags;
    }
}

namespace Telepo {
    [Size(0x28)]
    struct SelectUseTicketInvoker {
        [0x10] Telepo* telepo;
        [0x1C] u32 addon_id;
        [Sig("48 89 5C 24 ?? 48 89 74 24 ?? 57 48 83 EC ?? 80 79 ?? 00 41 0F B6 F8 8B F2", FirstMatch)] bool teleportWithTickets(u32 aetheryte_id, u8 sub_index);
