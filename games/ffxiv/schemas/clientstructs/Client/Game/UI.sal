// Made from FFXIVClientStructs by tools/ClientStructsSal. Change that and run `zig build client-structs`,
// since this is written again.

namespace Client.Game.UI;

[Size(0x848)]
struct Achievement : ServerRequestCallbackInterface {
    [0x8] Achievement.AchievementState state;
    // Main completion bitmap This is distinct from the two near-completion result bitmaps and the
    // ItemBarterWarning bitmap.
    [0xC] u8[510] completed_achievements;
    // Last Five Achievement Ids
    [0x20A] u16[5] history;
    [0x230] Achievement.AchievementState progress_request_state;
    [0x234] u32 progress_achievement_id;
    [0x238] u32 progress_current;
    [0x23C] u32 progress_max;
    // Enables the two independently requested near-completion result slots. These slots do not cache or
    // partition `CompletedAchievements`. Each is a separate server-provided achievement-Id membership
    // bitmap for a different UI lifecycle.
    [0x240] u8[2] near_completion_achievement_requests;
    // Set after a near-completion slot has been received, suppressing subsequent first-receipt
    // notifications.
    [0x242] bool[2] near_completion_achievement_received;
    // Load state for near-completion slots 0 and 1.
    [0x244] Achievement.AchievementState[2] near_completion_achievement_states;
    // Near-completion achievement bitmaps for the login notification and the Achievement addon's Near
    // Completion page. Index 0 is the login notification, index 1 is the Achievement addon's Near
    // Completion page. Controlled by AchievementAppealLoginDisp config.
    [0x24C] Achievement.AchievementBitmap[2] near_completion_achievements;
    // Used only by ItemBarterWarning rows. A dedicated server packet is ORed into this bitmap without
    // modifying `CompletedAchievements`. When checking an ItemBarterWarning row, the game treats its
    // referenced achievement as complete if either bitmap has the corresponding bit set.
    [0x648] u8[510] item_barter_warning_completed_achievements;
    [Sig("48 8D 0D ?? ?? ?? ?? E8 ?? ?? ?? ?? 04 30 FF C3", FirstMatch, Offset(3), Rel32)] static Achievement instance;
    // Requests Achievement Progress from the server The reply comes from `handleAchievementsPacket`
    [Sig("E8 ?? ?? ?? ?? 8B C3 48 8B 5C 24 ?? 48 8B 74 24 ?? 48 83 C4 20 5F C3 83 F8 02", FirstMatch, Offset(1), Rel32)] void requestCompletedAchievements();
    // Requests Achievement Progress from the server
    [Sig("E8 ?? ?? ?? ?? 41 C6 44 24 ?? ?? E9 ?? ?? ?? ?? 48 8D 4F ?? E8 ?? ?? ?? ?? 88 43", FirstMatch, Offset(1), Rel32)] void requestAchievementProgress(u32 id);
    // Requests data for a FATE progress tab
    [Sig("E8 ?? ?? ?? ?? 48 8D 54 24 ?? C6 86", FirstMatch, Offset(1), Rel32)] bool requestFateProgressTab(u8 tab_index);
    // Receives Achievement Progress requested with `requestAchievementProgress`.
    [Sig("C7 81 ?? ?? ?? ?? ?? ?? ?? ?? 89 91 ?? ?? ?? ?? 44 89 81", FirstMatch)] void receiveAchievementProgress(u32 id, u32 current, u32 max);
    // Checks whether an achievement is present in the main completion bitmap. This does not inspect
    // ItemBarterWarning data.
    [Sig("E8 ?? ?? ?? ?? 04 30 FF C3", FirstMatch, Offset(1), Rel32)] bool isComplete(i32 achievement_id);
    // Marks an achievement complete and adds it to the recent completion history Any near-completion
    // result slot containing this achievement is cleared and reset to Invalid
    [Sig("E8 ?? ?? ?? ?? 48 8B 0D ?? ?? ?? ?? E8 ?? ?? ?? ?? 48 8B C8 ?? ?? ?? FF 52 ?? 8B 54 24 ?? 48 8B C8", FirstMatch, Offset(1), Rel32)] void setAchievementCompleted(u32 achievement_id);
    [Sig("83 FA ?? 77 ?? 48 63 C2 0F B7 84 41 ?? ?? ?? ?? C3 33 C0 C3 CC CC CC CC CC CC CC CC CC CC CC CC C7 81", FirstMatch)] u16 getHistoryEntry(u32 index);
    // ORs a ItemBarterWarning packet into the bitmap
    [Sig("48 89 5C 24 ?? 48 89 7C 24 ?? 48 2B D1 48 8D 81", FirstMatch)] void mergeItemBarterWarningCompletedAchievements(u8* achievement_bitmap);
    // Checks the ItemBarterWarning completion bitmap for an achievement id
    [Sig("44 8B C2 4C 8B C9 81 FA ?? ?? ?? ?? 72", FirstMatch)] bool isItemBarterWarningAchievementComplete(u32 achievement_id);
    // Clears the login notification near-completion bitmap and resets only its state to `invalid`.
    [Sig("E8 ?? ?? ?? ?? C6 45 ?? ?? 45 33 F6", FirstMatch, Offset(1), Rel32)] void resetLoginNearCompletionAchievements();
    // Returns the load state for a near-completion result slot.
    [Sig("E8 ?? ?? ?? ?? FF C8 83 F8 ?? 76 ?? 41 8D 56", FirstMatch, Offset(1), Rel32)] Achievement.AchievementState getNearCompletionAchievementState(Achievement.NearCompletionAchievementSlot slot);
    // Checks whether an achievement belongs to a loaded near-completion result slot.
    [Sig("45 8B C8 83 FA ?? 73 ?? 44 8B C2", FirstMatch)] bool isNearCompletionAchievement(Achievement.NearCompletionAchievementSlot slot, u32 achievement_id);
    // Receives near-completion result for a UI slot.
    [Sig("83 FA ?? 0F 83 ?? ?? ?? ?? 48 89 5C 24 ?? 56 48 83 EC ?? 48 8B D9", FirstMatch)] void receiveNearCompletionAchievements(Achievement.NearCompletionAchievementSlot slot, Achievement.AchievementBitmap* achievement_bitmap);
    // Requests both near-completion result slots. This is not a forced refresh of a slot that is already
    // enabled and requested or loaded.
    [Sig("48 83 EC ?? 33 D2 38 91", FirstMatch)] void requestAllNearCompletionAchievements();
    // Requests one near-completion result slot.
    [Sig("48 8B C1 83 FA ?? 73 ?? 8B CA BA", FirstMatch)] void requestNearCompletionAchievementSlot(Achievement.NearCompletionAchievementSlot slot);
}

// Represents the AutoAttackState structure. Originally, this might have been embedded in WeaponState
// at offset 0x10, but current analysis shows auto-attack is managed globally.
[Size(0x1)]
struct AutoAttackState {
    [0x0] bool is_auto_attacking;
    // Gets the current auto-attack state.
    [Sig("E8 ?? ?? ?? ?? 84 C0 74 ?? 38 1D", FirstMatch, Offset(1), Rel32)] bool get();
    // Handles actor control updates related to AutoAttack state.
    [Sig("88 11 80 FA 01 75 ?? 48 8B 0D ?? ?? ?? ?? 48 85 C9 74 ?? 38 15 ?? ?? ?? ?? 74 ?? 48 81 C1 ?? ?? ?? ??", FirstMatch)] void onActorControl(bool new_state);
    // Sets the auto-attack state after performing configuration and validation checks. Wraps the SetImpl
    // call after ensuring conditions are met.
    [Sig("E8 ?? ?? ?? ?? B0 ?? EB ?? 48 8D 0D", FirstMatch, Offset(1), Rel32)] bool set(bool new_state);
    // Sets the auto-attack state.
    [Sig("E8 ?? ?? ?? ?? EB ?? F6 87 ?? ?? ?? ?? ?? 75", FirstMatch, Offset(1), Rel32)] bool setImpl(bool new_state, bool send_packet, bool is_instant);
}

