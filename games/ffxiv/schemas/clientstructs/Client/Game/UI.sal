namespace NpcYell {
    bitfield NpcYellFlags : u8 {
        // Controls the corresponding flag in the `NpcYellBalloon`.
        [Bit(0)] bool skip_close_checks;
        // Controls the corresponding flag in the `NpcYellBalloon`. Also checked when formatting NPC name.
        [Bit(1)] bool skip_range_check;
        [Bit(2)] bool unk4;
        // Causes speaker name to be an empty string.
        [Bit(3)] bool hide_speaker_name;
        // Indicates that this slot is currently ready to be assigned yell information. If this is set, all
        // other information in the structure should be considered stale.
        [Bit(4)] bool slot_available;
        [Bit(5)] bool unk20;
        [Bit(6)] bool unk40;
        // none is none of them
    }

    [Size(0x118)]
    struct NpcYellInfo {
        [0x0] u32 npc_yell_row_id;
        [0x8] Object.GameObjectId object_id;
        // In the case of the speaker being an event NPC (i.e., for Gold Saucer announcements), this will
        // instead contain the ENpcResident row ID.
        [0x10] u32 name_id;
        [0x18] System.String.Utf8String name;
        [0x80] System.String.Utf8String message;
        [0xE8] u32[4] message_params;
        // How much longer (in seconds) before the yell should be handled.
        [0xF8] f32 delay;
        // How long (in seconds) to display the message as a balloon. Only used if `output_type` includes
        // `show_balloon`.
        [0xFC] f32 balloon_time;
        // How long (in seconds) to display the message in the BattleTalk addon. Only used if `output_type`
        // includes `show_battle_talk`.
        [0x100] f32 battle_talk_time;
        // The method(s) used to show the dialogue to the player.
        [0x104] NpcYellOutputFlags output_type;
        // The background style used if `output_type` includes `show_battle_talk`. 6 is linkshell-style. 7 is
        // dark. 9 and 11 are robot-style (blue). Others are default white.
        [0x105] u8 battle_talk_style;
        // The icon ID to show as the BattleTalk portrait if `output_type` includes `show_battle_talk`.
        [0x108] u32 battle_talk_image;
        // The index of the character bone to which to attach the `NpcYellBalloon`. Only used if `output_type`
        // includes `show_balloon`.
        [0x10C] u8 parent_bone;
        [0x10E] u16 unk10_e;
        [0x110] NpcYellFlags flags;
    }

    bitfield NpcYellOutputFlags : u8 {
        [Bit(0)] bool print_to_log;
        [Bit(1)] bool show_balloon;
        [Bit(2)] bool show_battle_talk;
        // none is none of them
    }

    [Size(0x28)]
    struct NpcYellSlot {
        [0x0] Object.GameObjectId object_id;
        // Only valid before this slot is handled.
        [0x8] u32 npc_yell_row_id;
        // In the case of the speaker being an event NPC (i.e., for Gold Saucer announcements), this will
        // instead contain the ENpcResident row ID.
        [0xC] u32 name_id;
        [0x10] u32[4] message_params;
        // How much longer (in seconds) before the yell should be expanded into a `NpcYellInfo`.
        [0x20] f32 delay;
        [0x24] bool unk24;
    }
}

