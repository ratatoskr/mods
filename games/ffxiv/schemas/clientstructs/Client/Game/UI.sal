        [0x0] u8[510] bits;
    }

    // Represents the loaded state of Achievement
    enum AchievementState : i32 {
        // Achievement is initialized at this state. Debug output calls it "invalide".
        invalid = 0,
        // This state is set between the client request and receiving the data from the server. Debug output
        // calls it "waiting".
        requested = 1,
        // Set upon data being received. Debug output calls it "effective".
        loaded = 2,
    }

    // Identifies a near-completion result slot.
    enum NearCompletionAchievementSlot : u32 {
        // Data used by the login notification.
        login_notification = 0,
        // Data used by the Achievement addon's Near Completion page.
        achievement_addon = 1,
    }
}

