namespace Client.Sound;

[Size(0x30)]
struct ClipSoundManager {
    [0x0] SoundManager* sound_manager;
    [0x8] u8[40] critical_section;
}

[Size(0x28)]
struct ISoundData {
    [0x0] void* virtual_table;
    [0x18] ISoundData* next;
    [0x24] bool is_active;
    [Virtual(1)] void update(f32 delta_seconds);
    // Removes the references to sound resource handles and frees any extra allocated memory, so that this
    // can be reused for a new sound. Resetting can fail if the sound is still in use (e.g. is currently
    // fading out).
    [Virtual(2)] bool tryReset();
    [Virtual(3)] SoundDataSoundController* getSoundController();
    [Virtual(5)] void setIsLoadingSoundResource(bool is_loading);
    [Virtual(6)] bool getIsLoadingSoundResource();
    [Virtual(7)] u32 getFadeInDuration();
    [Virtual(8)] void setFadeInDuration(u32 fade_in_duration);
    [Virtual(9)] f32 getVolume();
    [Virtual(10)] void setVolume(f32 volume, u32 fade_duration);
    [Virtual(11)] bool getIsPositional();
    [Virtual(12)] void setPosition(bool is_positional, f32 x, f32 y, f32 z);
    [Virtual(13)] f32 getPositionX();
    [Virtual(14)] f32 getPositionY();
    [Virtual(15)] f32 getPositionZ();
    [Virtual(16)] f32 getSpeed();
    [Virtual(17)] void setSpeed(f32 speed, u32 a3);
    [Virtual(36)] void stop(u32 fade_out_duration);
    [Virtual(38)] bool isPlaying();
    [Virtual(40)] bool getIsFadingOut();
    [Virtual(41)] bool getFadeInEnabled();
    [Virtual(42)] bool getIsAutoReleaseEnabled();
    [Virtual(43)] void setFadeInEnabled(bool enable);
    [Virtual(49)] cstring getFileName();
    [Virtual(50)] u32 getSoundNumber();
    [Virtual(54)] System.Resource.Handle.SoundResourceHandle* getSoundResourceHandle();
    [Virtual(55)] void setSoundResourceHandle(System.Resource.Handle.SoundResourceHandle* handle);
    [Virtual(56)] void loadSoundResourceHandle(System.Resource.Handle.SoundResourceHandle* handle);
    [Virtual(57)] f32 getElapsedTime();
    [Virtual(61)] i32 getMidiNote();
}

// All busses use 44100 Hz sampling rate.
enum SoundBus : i32 {
    // 2 Tracks, 2D
    music = 1,
    // 20 Tracks, 3D
    se = 2,
    // 5 Tracks, 3D
    voice = 3,
    // 5 Tracks, 2D
    system = 4,
    // 12 Tracks, 3D
    bg = 5,
    // 15 Tracks, 3D
    foot = 6,
    // 5 Tracks, 3D
    placed_npc = 7,
    // 2 Tracks, 2D
    time_stretch_bgm = 8,
    // 2 Tracks, 2D
    zingle = 9,
    // 8 Tracks, 3D
    common_vfx = 10,
    // 4 Tracks, 3D
    bg_env = 11,
    // 2 Tracks, 3D
    walla = 12,
    // 2 Tracks, 2D
    movie = 13,
    // 28 Tracks, 3D
    unknown0 = 14,
    // 4 Tracks, 3D
    unknown1 = 15,
    // 2 Tracks, 3D
    orchestrion = 16,
    // 16 Tracks, 3D
    instruments = 17,
    // 4 Tracks, 2D
    vibration = 18,
    // 12 Tracks, 3D
    housing = 19,
    // 2 Tracks, 3D
    random_wind = 20,
}

[Size(0xD0)]
struct SoundData : ISoundData {
    [0x28] System.Resource.Handle.SoundResourceHandle* sound_resource_handle;
    [0x30] i32 fade_in_duration;
    [0x38] SoundDataSoundController sound_controller;
    [0x60] f32 volume;
    [0x64] f32 unk64;
    [0x68] f32 pos_x;
    [0x6C] f32 pos_y;
    [0x70] f32 pos_z;
    [0x74] f32 speed;
    [0x78] u32 unk78;
    [0x7C] u32 sound_number;
    [0x80] f32 unk80;
    [0x84] f32 unk84;
    [0x88] f32 fade_out_duration;
    [0x8C] i32 midi_note;
    [0x90] isize unk90;
    [0x98] i32 unk98;
    [0x9C] i32 driver_resource_index;
    [0xA0] SoundLayoutOptions* sound_layout_options;
    [0xB0] u32 unk_b0;
    [0xB4] SoundVolumeCategory volume_category;
    [0xB8] bool is_loading_sound_resource;
    [0xB9] bool is_positional;
    [0xBA] bool is_fade_in_enabled;
    [0xBB] bool is_auto_release_enabled;
    [0xBC] bool unk_bc;
    [0xBD] bool is_fade_out_enabled;
    [0xBE] bool unk_be;
    [0xBF] bool unk_bf;
    [0xC0] bool unk_c0;
    [0xC1] bool unk_c1;
    [0xC2] bool unk_c2;
    [0xC3] bool is_local_player;
    [0xC4] bool unk_c4;
    [0xC5] bool is_default_fade_out;
    [0xC8] isize unk_c8;
}

[Size(0x28)]
struct SoundDataSoundController : SQEX.CDev.Engine.Sd.Driver.SoundController {
    [0x20] u8 unk20;
}

[Size(0x3)]
struct SoundLayoutOptions {
    [0x0] u16 size;
    [0x2] SoundObjectType type;
}

// This class is the low level handler for sound related functions and abstracts from the operating
// system. The functions in this class are not intended by SE to be used directly and do not have
// proper checks for correct values.
[Size(0x1D10)]
struct SoundManager : System.Resource.ResourceEventListener {
    // Inherited parent class accessor for `Thread`
    [0x8] System.Threading.Thread thread;
    [0x31] bool disabled;
    [0x34] f32 master_volume;
    // 1.0f, set to 0.6675f by `initialize` unless `disabled`. Multiplied into the master volume.
    [0x38] f32 active_volume;
    // The volume of each bus, indexed by `SoundBus`. It is the user's volume slider divided by 100.
    // `getEffectiveVolume` multiplies this array with the four below, the mute flag of the bus and the
    // window inactive state.
    [0x3C] f32[21] volume;
    // 1.0f. A sound command of a cutscene changes the volume of a bus with a fade, the
    // `CutSceneController` restores the saved values when it ends.
    [0x90] f32[21] cutscene_volume;
    [0xE4] f32[21] unk_volume3;
    [0x138] f32[21] unk_volume4;
    // 1.0f. Set to 0 or 1 by `ContentsReplayManager` during the playback of a recording, for SE, Voice,
    // BG, Foot, PlacedNPC, TimeStretchBGM, Zingle, CommonVFX, BGEnv, Walla and Instruments.
    [0x18C] f32[21] replay_volume;
    [0x1E0] bool[21] bus_muted;
    [0x1F5] bool[21] bus_always_on;
    [0x220] SoundManager.SoundDataMemory* sound_data_pool;
    [0x228] SoundData* inactive_sound_data_list_head;
    [0x230] SoundData* active_sound_data_list_head;
    [0x24A] bool play_sounds_when_window_inactive;
    [0x24B] bool is_snd_master;
    [0x24C] bool window_inactive;
    [0x320] SoundData* weather_sound_data;
    [0x328] isize critical_section;
    [0x360] f32[256] fft_red1;
    [0x760] f32[256] fft_red2;
    [0xB60] f32[256] fft_green1;
    [0xF60] f32[256] fft_green2;
    [0x1360] f32[256] fft_blue1;
    [0x1760] f32[256] fft_blue2;
    [0x1BE8] f32 orchestrion_pos_x;
    [0x1BEC] f32 orchestrion_pos_y;
    [0x1BF0] f32 orchestrion_pos_z;
    [0x1BF4] utf8[260] orchestrion_path;
    [Sig("48 89 35 ?? ?? ?? ?? 48 83 C4 20", FirstMatch, Offset(3), Rel32)] static SoundManager* instance;
    // Called once by `Framework.Setup` after the constructor.
    [Sig("48 89 5C 24 10 55 56 57 41 56 41 57 48 8D AC 24 B0 FA FF FF", FirstMatch)] void initialize(bool initialize_driver, cstring driver_config);
    // Calculates effective volume: the five volume arrays multiplied for the bus. The result is 0 if the
    // mute flag of the bus is set, or if `window_inactive` is set and either
    // `play_sounds_when_window_inactive` or the entry of the bus in the array at 0x1F5 is set. The game
    // sets the result as the volume of the `Bus` of the category.
    [Sig("F3 0F 10 0D ?? ?? ?? ?? 48 63 C2", FirstMatch)] f32 getEffectiveVolume(SoundBus bus);
    // Sets bus volume
    [Sig("E8 ?? ?? ?? ?? FF C7 ?? ?? 75 ?? EB", FirstMatch, Offset(1), Rel32)] void setVolume(SoundBus bus, f32 volume, i32 p3);
    // Sets the entry of `CutsceneVolume` for the bus and applies the volume of the bus.
    [Sig("85 D2 0F 84 ?? ?? ?? ?? 4C 8B DC 49 89 5B 08 45 89 4B 20 F3 0F 11 54 24 18 57 48 81 EC 80 00 00 00 48 63 DA 48 8B F9 83 FB 15 0F 8D ?? ?? ?? ?? 0F 57 C0", FirstMatch)] void setCutsceneVolume(SoundBus bus, f32 volume, i32 fade_ticks);
    // Sets `ReplayVolume` for its buses and applies their volumes.
    [Sig("48 8B C4 48 89 58 08 48 89 78 18 55 48 8D 68 A1 48 81 EC A0 00 00 00", FirstMatch)] void setReplayVolume(f32 volume);
    [Sig("48 89 5C 24 ?? 57 48 83 EC 20 80 79 31 00 0F B6 FA 48 8B D9 75 2B", FirstMatch)] void setMasterEnabled(bool enabled);
    [Sig("E8 ?? ?? ?? ?? E9 ?? ?? ?? ?? 49 8B 89 ?? ?? ?? ?? 83 FE ?? 0F 94 C2 E8 ?? ?? ?? ?? E9 ?? ?? ?? ?? 49 8B 89 ?? ?? ?? ?? 83 FE ?? 0F 94 C2 E8 ?? ?? ?? ?? E9 ?? ?? ?? ?? 49 8B 89 ?? ?? ?? ?? 83 FE ?? 0F 94 C2 E8 ?? ?? ?? ?? E9 ?? ?? ?? ?? 49 8B 89 ?? ?? ?? ?? 83 FE ?? 0F 94 C2 E8 ?? ?? ?? ?? E9 ?? ?? ?? ?? 49 8B 89 ?? ?? ?? ?? 83 FE ?? 0F 94 C2 E8 ?? ?? ?? ?? E9 ?? ?? ?? ?? 49 8B 89 ?? ?? ?? ?? 8B D6", FirstMatch, Offset(1), Rel32)] void setBgmEnabled(bool enabled);
    [Sig("E8 ?? ?? ?? ?? E9 ?? ?? ?? ?? 49 8B 89 ?? ?? ?? ?? 83 FE ?? 0F 94 C2 E8 ?? ?? ?? ?? E9 ?? ?? ?? ?? 49 8B 89 ?? ?? ?? ?? 83 FE ?? 0F 94 C2 E8 ?? ?? ?? ?? E9 ?? ?? ?? ?? 49 8B 89 ?? ?? ?? ?? 83 FE ?? 0F 94 C2 E8 ?? ?? ?? ?? E9 ?? ?? ?? ?? 49 8B 89 ?? ?? ?? ?? 83 FE ?? 0F 94 C2 E8 ?? ?? ?? ?? E9 ?? ?? ?? ?? 49 8B 89 ?? ?? ?? ?? 8B D6", FirstMatch, Offset(1), Rel32)] void setSoundEffectsEnabled(bool enabled);
