enum SoundObjectType : u8 {
    null = 0,
    ambient_sound = 1,
    direction_sound = 2,
    point_sound = 3,
    point_dir_sound = 4,
    line_sound = 5,
    poly_line_sound = 6,
    surface_sound = 7,
    board_obstruction = 8,
    box_obstruction = 9,
    poly_line_obstruction = 10,
    polygon_sound = 11,
    box_ext_controller = 12,
    line_ext_controller = 13,
    polygon_obstruction = 14,
}

enum SoundVolumeCategory : i32 {
    // Modifies volume based on ConfigOption.SoundPlayer
    player = 0,
    // Modifies volume based on ConfigOption.SoundParty
    party = 1,
    // Modifies volume based on ConfigOption.SoundOther
    other = 2,
    unk3 = 3,
    unk4 = 4,
    // Won't load/play the sound at all.
    no_play = 5,
    // Does not modify volume, always plays. For example, sounds in Cutscenes.
    bypass_volume_rules = 6,
}

namespace SoundManager {
    [Size(0xD000)]
    struct SoundDataMemory {
        [0x0] SoundData[256] entries;
    }
}
