namespace Interop.DirectInput;

// DIDEVCAPS
[Size(0x2C)]
struct DIDeviceCapabilities {
    [0x0] u32 size;
    [0x4] u32 flags;
    [0x8] u32 dev_type;
    [0xC] u32 axes;
    [0x10] u32 buttons;
    [0x14] u32 po_vs;
    [0x18] u32 ff_sample_period;
    [0x1C] u32 ff_min_time_resolution;
    [0x20] u32 firmware_revision;
    [0x24] u32 hardware_revision;
    [0x28] u32 ff_driver_version;
}

// DIDEVICEINSTANCEA
[Size(0x244)]
struct DIDeviceInstance {
    [0x0] u32 size;
    // A Guid, which has no .sal type
    [0x4] u8[16] instance;
    // A Guid, which has no .sal type
    [0x14] u8[16] product;
    [0x24] u32 dev_type;
    [0x28] utf8[260] instance_name;
    [0x12C] utf8[260] product_name;
    // A Guid, which has no .sal type
    [0x230] u8[16] ff_driver;
    [0x240] u16 usage_page;
    [0x242] u16 usage;
}
