// Made from FFXIVClientStructs by tools/ClientStructsSal. Change that and run `zig build client-structs`,
// since this is written again.

namespace STD.Helper;

struct HashTable<T, TKey> {
    f32 max_load_factor;
    HashTable.Node<T, TKey>* head;
    u64 count;
    HashTable.Node<T, TKey>** vec;
    HashTable.Node<T, TKey>** vec_last;
    HashTable.Node<T, TKey>** vec_end;
    u64 mask;
    u64 max_index;
}

struct RedBlackTree<T, TKey> {
    RedBlackTree.Node<T, TKey>* head;
    i64 long_count;
}

// Colors for link to parent.
enum RedBlackTreeNodeColor : u8 {
    red = 0,
    black = 1,
}

namespace HashTable {
    struct Node<T, TKey> {
        Node<T, TKey>* next;
        Node<T, TKey>* prev;
        T myval;
    }
}

namespace RedBlackTree {
    struct FindResult<T, TKey> {
        TreeId<T, TKey> location;
        Node<T, TKey>* bound;
    }

    struct Node<T, TKey> {
        Node<T, TKey>* left;
        Node<T, TKey>* parent;
        Node<T, TKey>* right;
        RedBlackTreeNodeColor color;
        bool isnil;
        T myval;
    }

    enum TreeChild : i32 {
        right = 0,
        left = 1,
        unused = 2,
    }

    struct TreeId<T, TKey> {
        Node<T, TKey>* parent;
        TreeChild child;
    }
}
