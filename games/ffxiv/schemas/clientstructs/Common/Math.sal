// A bounding box oriented in 3D space, specified by a transformation with identity scale and its half
// extents.
[Size(0x50)]
struct OrientedBounds {
    // The transformation of the bounding box in 3D space. The scale along each axis should be 1.
    [0x0] Matrix4x4 transform;
    // The half size of the bounding box along its transformed axes.
    [0x40] Vector3 half_extents;
}

