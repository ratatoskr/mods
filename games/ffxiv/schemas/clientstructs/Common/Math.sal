// An axis-aligned bounding box specified as minimum and maximum corners.
[Size(0x20)]
struct AxisAlignedBounds {
    // The minimum corner of the bounding box.
    [0x0] Vector3 min;
    // The maximum corner of the bounding box.
    [0x10] Vector3 max;
}

