// Made from FFXIVClientStructs by tools/ClientStructsSal. Change that and run `zig build client-structs`,
// since this is written again.

namespace Common.Component.BGCollision;

// Entry point for collision related operations. Collision scene supports two ways to filter colliders
// - layers and material masks. Each collider, when constructed, is provided a layer mask. Collider is
// ignored during raycasts if raycast request layer mask AND collider layer mask == 0. Individual
// collider raycast operations are inconsistent in how they handle zero layer mask in raycast request:
// - primitive shape (non-mesh) colliders skip layer check in that case (so 0 is equivalent to 'all 1s'
// mask, meaning no colliders are rejected by layer check) - mesh colliders do a normal check, meaning
// that all mesh colliders are rejected by a layer check Some colliders provide functions to perform
// raycast without layer check. Each collider also has a material value (0x7000 by default on
// construction). When doing raycasts with material filtering, you supply a mask and a value. For
// primitive shape (non-mesh) colliders, the filtering is simple: - if material filter value is 0, the
// collider is considered if (collider-material AND filter-mask) != 0 - otherwise, the collider is
// considered if (collider-material AND filter-mask) == filter-value For mesh colliders, things are
// slightly more complicated. Collider still contains a material value + a material mask (this mask is
// ignored by all other collider types). Each individual triangle of the mesh also defines its own
// material value (primitive material). The effective material of a triangle is calculated as follows:
// - if object material mask is 0, it's just whatever is stored in primitive - otherwise, it is
// calculated as (primitive-material AND NOT object-material-mask) OR object-material-value (so masked
// bits are replaced by per-object value) This effective material is then used as collider-material
// value in the material filtering logic described above. There are three main options that are used to
// customize raycast algorithm - these are stored as 'raycast algorithm type' bitfield, meaning there
// are 8 total flavours of raycasts: Default (no bits set): usual ray/shape intersection without
// material filtering. Bit 0 set: use sphere sweep instead of a ray; when choosing between potential
// intersection points at comparable (within epsilon) distance, select one that has 'more orthogonal'
// normal (smaller ray-direction dot normal) Bit 1 set: ignore 'horizontal' collisions (ones where
// normal.Y is > threshold, i.e. angle to vertical axis is smaller than some threshold) Bit 2 set:
// perform material filtering
[Size(0xA0)]
struct BGCollisionModule {
    [0x1] bool shutting_down;
    [0x8] void* resource_manager;
    [0x10] SceneManager* scene_manager;
    [0x18] isize update_task_lock;
    [0x48] Client.System.Framework.Task wait_for_update_task;
    [0x80] isize update_finished_event;
    [0x88] i32 load_in_progress_counter;
    [0x8C] Vec4 forced_streaming_sphere;
    [Sig("E8 ?? ?? ?? ?? 84 C0 41 0F B6 D6", FirstMatch, Offset(1), Rel32)] bool raycastMaterialFilter(RaycastHit* hit_info, Vec3* origin, Vec3* direction, f32 max_distance, i32 layer_mask, i32* flags);
    [Sig("E8 ?? ?? ?? ?? 4C 8B 45 ?? 0F B6 55", FirstMatch, Offset(1), Rel32)] bool sweepSphereMaterialFilter(RaycastHit* hit_info, Vec3* origin, Vec3* direction, f32 max_distance, i32 layer_mask, i32* flags);
}

[Size(0xA8)]
struct Collider {
    [0x0] void* virtual_table;
    // Inherited parent class accessor for `QuadtreeNode`
    [0x20] QuadtreeNode quadtree_node;
    [0x44] u32 num_refs;
    [0x48] Scene* scene;
    [0x58] u64 layout_object_id;
    [0x68] u64 layer_mask;
    [0x70] u64 object_material_value;
    [0x78] u64 object_material_mask;
    [0x80] f32 last_translation_delta_y;
    [0x84] u8 visibility_flags;
    [0xA0] bool dirty;
    // Checked every update. Base implementation just checks NumRefs for zero, but derived classes that do
    // async loads also check that load is not in progress.
    [Virtual(1)] bool wantUnload();
    // No-op for all derived classes except Mesh.
    [Virtual(2)] void load(u8* path);
    // No-op for all derived classes except Mesh. Called by Scene's update when WantUnload returns true
    // before deleting the object.
    [Virtual(3)] void unload();
    [Virtual(4)] void getMaterial(u64* id, u64* mask);
    [Virtual(5)] u64 getMaterialId();
    [Virtual(6)] u64 getMaterialMask();
    [Virtual(7)] void setMaterial(u64 id, u64 mask);
    [Virtual(8)] void setTranslation(Vec3* translation);
    [Virtual(9)] void getTranslation(Vec3* translation);
    [Virtual(10)] void getWorldBb(Math.AABB* bounds);
    [Virtual(11)] void getBoundingBox(Math.AABB* bounds);
    [Virtual(12)] void setRotation(Vec3* euler_angles);
    [Virtual(13)] void getRotation(Vec3* euler_angles);
    [Virtual(14)] void setScale(Vec3* scale);
    [Virtual(15)] void getScale(Vec3* scale);
    [Virtual(16)] void getWorldTransform(Mat4* transform);
    [Virtual(17)] void getInvWorldTransform(Mat4* transform);
    [Virtual(18)] ColliderType getColliderType();
    // Called every frame if WantUnload returns false. If returns true, it is readded to the quadtree -
    // otherwise LastTranslationDeltaY is reset to 0.
    [Virtual(19)] bool update();
    [Virtual(20)] bool loadInProgress();
    [Virtual(21)] bool raycast(RaycastHit* result, u64 layer_mask, RaycastParams* args);
    [Virtual(22)] bool isInsideCheckLayer(u64 layer_mask, Vec3* pos);
    [Virtual(23)] bool isInside(Vec3* pos);
}

// Box collider - local center is at origin, half-width is 1 in each dimension - so local bounds are
// (-1,-1,-1) to (1,1,1).
[Size(0x148)]
struct ColliderBox : Collider {
    [0xA8] Vec3 translation;
    [0xB4] Vec3 translation_prev;
    [0xC0] Vec3 rotation;
    [0xCC] Vec3 rotation_prev;
    [0xD8] Vec3 scale;
    [0xE4] Math.Matrix4x3 world;
    [0x114] Math.Matrix4x3 inv_world;
}

// Cylinder collider - local center is at origin, local axis is (0,1,0), half-height and radius are 1 -
// so local bounds are (-1,-1,-1) to (1,1,1).
[Size(0x148)]
struct ColliderCylinder : Collider {
    [0xA8] Vec3 translation;
    [0xB4] Vec3 translation_prev;
    [0xC0] Vec3 rotation;
    [0xCC] Vec3 rotation_prev;
    [0xD8] Vec3 scale;
    [0xE4] f32 radius;
    [0xE8] Math.Matrix4x3 world;
    [0x118] Math.Matrix4x3 inv_world;
}

// Generic mesh collider.
[Size(0x1A0)]
struct ColliderMesh : Collider {
    [0xB0] Resource* resource;
    [0xB8] u8* memory_data;
    [0xC0] i32 total_primitives;
    [0xC4] bool mesh_is_simple;
    [0xC5] bool loaded;
    [0xC8] f32 inv_scale_x;
    [0xD0] Mesh* mesh;
    [0xD8] i32 total_children;
    [0xDC] Vec3 translation;
    [0xE8] Vec3 rotation;
    [0xF4] Vec3 scale;
    [0x100] Vec3 translation_prev;
    [0x10C] Vec3 rotation_prev;
    [0x118] Math.Matrix4x3 world;
    [0x148] Math.Matrix4x3 inv_world;
    [0x178] Vec4 bounding_sphere;
    [0x188] Math.AABB world_bounding_box;
}

// Plane collider - local center is at origin, local normal is (0,0,1), half-side is 1 - so local
// bounds are (-1,-1,0) to (1,1,0). There are two flavours of planes - one-sided and two-sided (latter
// is implemented as a derived class without any new fields).
[Size(0x148)]
struct ColliderPlane : Collider {
    [0xA8] Vec3 translation;
    [0xB4] Vec3 translation_prev;
    [0xC0] Vec3 rotation;
    [0xCC] Vec3 rotation_prev;
    [0xD8] Vec3 scale;
    [0xE4] Math.Matrix4x3 world;
    [0x114] Math.Matrix4x3 inv_world;
    [0x144] bool two_sided;
}

// Sphere collider - local center is at origin, radius is 1 - so local bounds are (-1,-1,-1) to
// (1,1,1). At least some parts of the code assume that scale is always uniform.
[Size(0x150)]
struct ColliderSphere : Collider {
    [0xA8] Vec3 translation;
    [0xB4] Vec3 translation_prev;
    [0xC0] Vec3 rotation;
    [0xCC] Vec3 rotation_prev;
    [0xD8] Vec3 scale;
    [0xE4] Vec3 scale_prev;
    [0xF0] Math.Matrix4x3 world;
    [0x120] Math.Matrix4x3 inv_world;
}

// Streamed collider does not contribute to the collision scene by itself, however it adds and removes
// other mesh colliders that are inside streaming sphere. In the file system, the whole streamable
// scene is located in a single directory; the root file is typically called list.pcb. Individual
// streamable meshes are called /trXXXX.pcb, where XXXX is MeshId field (with zero padding - formatted
// as %04d).
[Size(0x1E8)]
struct ColliderStreamed : Collider {
    [0xB0] utf8[256] path_base;
    [0x1B0] Resource* resource;
    [0x1B8] i32 num_meshes_loading;
    [0x1BC] bool loaded;
    [0x1C0] f32 streamed_min_x;
    [0x1C4] f32 streamed_min_z;
    [0x1C8] f32 streamed_max_x;
    [0x1CC] f32 streamed_max_z;
    [0x1D0] ColliderStreamed.FileHeader* header;
    [0x1D8] ColliderStreamed.FileEntry* entries;
    [0x1E0] ColliderStreamed.Element* elements;
}

enum ColliderType : i32 {
    streamed = 1,
    mesh = 2,
    box = 3,
    cylinder = 4,
    sphere = 5,
    plane = 6,
    plane_two_sided = 7,
}

[Size(0x8)]
struct IMesh {
}

[Size(0x10)]
struct MemoryPool {
    [0x0] MemoryPoolPageHeader* first_allocated_page;
    [0x8] MemoryPoolPageHeader* first_active_page;
}

[Size(0x10)]
struct MemoryPoolEntryHeader {
    [0x0] MemoryPoolPageHeader* page;
    [0x8] u32 index;
}

[Size(0x30)]
struct MemoryPoolPageHeader {
    [0x0] MemoryPoolPageHeader* next_allocated_page;
    [0x8] MemoryPoolPageHeader* prev_allocated_page;
    [0x10] MemoryPoolPageHeader* next_active_page;
    [0x18] MemoryPoolPageHeader* prev_active_page;
    [0x20] u32 free_entries_mask;
    [0x24] u16 entry_size;
    [0x26] u8 num_entries_used;
    [0x27] u8 num_entries_total;
    [0x28] bool is_active;
}

[Size(0x18)]
struct Mesh : Object {
    // Inherited parent class accessor for `IMesh`
    [0x8] IMesh i_mesh;
    [0x10] ColliderMesh* owner_collider;
    [Virtual(2)] Vec3* getBoundsMin();
    [Virtual(3)] Vec3* getBoundsMax();
    // Perform raycast on the mesh. Note that paramsLocal contain ray/sphere origin/radius/direction in
    // local space! World transform is used for 'non-horizontal' check, if requested.
    [Virtual(4)] bool intersect(Mat4* world_transform, RaycastHit* result, RaycastParams* params_local);
    [Virtual(5)] u16 getNumPrimitives();
    [Virtual(6)] u32 getNumVertices();
    // Get world-space positions for all vertices (raw and compressed) in correct order (as referenced by
    // indices). In game, outVerticesWorld typically would be allocated on stack to fit 256 vertices.
    [Virtual(7)] void gatherVertices(Mat4* world_transform, Vec3* out_vertices_world);
    [Virtual(8)] Mesh.Primitive* getPrimitives();
    [Virtual(9)] void getAabb(Math.AABB* result);
}

[Size(0x20)]
struct MeshPCB : Mesh {
    [0x18] MeshPCB.FileNode* root_node;
}

[Size(0x20)]
struct Node : Object {
    // Inherited parent class accessor for `NodeLink`
    [0x8] NodeLink node_link;
}

[Size(0x18)]
struct NodeLink {
    [0x8] Node* prev;
    [0x10] Node* next;
}

[Size(0x8)]
struct Object {
    [0x0] void* virtual_table;
    [Virtual(0)] Object* dtor(u8 free_flags);
}

// Each collider is added to the appropriate quad-tree node, which is then used to speed up raycasts.
// Nodes are laid in a contiguous array, level by level, in Morton order swizzle per level.
[Size(0x40)]
struct Quadtree : Object {
    [0x8] f32 min_x;
    [0xC] f32 max_x;
    [0x10] f32 leaf_size_x;
    [0x14] f32 min_z;
    [0x18] f32 max_z;
    [0x1C] f32 leaf_size_z;
    [0x20] i32 num_levels;
    [0x28] QuadtreeNode* nodes;
    [0x30] i32 num_nodes;
    [0x38] SceneManager* owner;
}

[Size(0x20)]
struct QuadtreeNode : Node {
}

[Size(0x58)]
struct RaycastHit {
    [0x0] Vec3 point;
    [0xC] Vec3 v1;
    [0x18] Vec3 v2;
    [0x24] Vec3 v3;
    [0x30] Vec3 normal;
    [0x40] u64 material;
    [0x48] f32 distance;
    [0x50] Collider* object;
}

[Size(0x10)]
struct RaycastMaterialFilter {
    [0x0] u64 mask;
    [0x8] u64 value;
}

[Size(0x40)]
struct RaycastParams {
    [0x0] i32 algorithm;
    [0x8] Vec4* origin;
    [0x10] Vec3* direction;
    [0x18] f32* max_distance;
    [0x20] f32 max_plane_normal_y;
    [0x28] RaycastMaterialFilter* material_filter;
    [0x30] u64 object_material_value;
    [0x38] u64 object_material_mask;
}

[Size(0x88)]
struct Resource {
    [0x0] void* virtual_table;
    [0x10] Resource* prev_resource;
    [0x18] Resource* next_resource;
    [0x20] Client.System.Resource.Handle.ResourceHandle* handle;
    [0x28] utf8[80] path;
    [0x78] void* listener;
    [Virtual(0)] Resource* dtor(u8 free_flags);
    [Virtual(1)] cstring getPath();
    [Virtual(2)] bool loadSucceeded();
    [Virtual(3)] bool loadFailed();
    [Virtual(4)] u8* getData();
    [Virtual(5)] u32 getSize();
}

[Size(0xC0)]
struct Scene : Object {
    [0x8] SceneManager* manager;
    [0x10] Collider* first_collider;
    [0x18] i32 num_colliders;
    [0x20] Vec4 streaming_sphere;
    [0x30] i32 num_loading;
    [0x38] Quadtree* quadtree;
    [0x40] MemoryPool pool_collider_streamed;
    [0x50] MemoryPool pool_collider_mesh;
    [0x60] MemoryPool pool_collider_box;
    [0x70] MemoryPool pool_collider_cylinder;
    [0x80] MemoryPool pool_collider_sphere;
    [0x90] MemoryPool pool_collider_plane;
    [0xA0] MemoryPool pool_collider_plane_two_sided;
    [0xB0] MemoryPool pool_mesh_pcb;
}

[Size(0x38)]
struct SceneManager {
    [0x0] void* virtual_table;
    [0x8] void* resource_manager;
    [0x18] SceneWrapper* first_scene;
    [0x20] i32 num_scenes;
    [0x28] Vec4 streaming_sphere;
    [Virtual(0)] SceneManager* dtor(u8 free_flags);
}

[Size(0x30)]
struct SceneWrapper : Node {
    [0x20] SceneManager* manager;
    [0x28] Scene* scene;
    [Virtual(1)] void clear();
    [Virtual(2)] void setStreamingSphere(f32 x, f32 y, f32 z, f32 radius);
    [Virtual(3)] bool hasLoadingColliders();
    [Virtual(4)] ColliderStreamed* addColliderStreamed(u64 layer_mask, u8* path_base, bool a3);
    [Virtual(5)] ColliderMesh* addColliderMesh(u64 layer_mask, u8* path, bool a3, Vec3* translation, Vec3* rotation, Vec3* scale);
    // Create a mesh collider that uses a copy of hardcoded tesselated cylinder geometry.
    [Virtual(6)] ColliderMesh* addColliderMeshCylinder(u64 layer_mask, Vec3* translation, Vec3* rotation, Vec3* scale);
    [Virtual(7)] ColliderBox* addColliderBox(u64 layer_mask, Vec3* translation, Vec3* rotation, Vec3* scale);
    [Virtual(8)] ColliderCylinder* addColliderCylinder(u64 layer_mask, Vec3* translation, Vec3* rotation, Vec3* scale);
    [Virtual(9)] ColliderSphere* addColliderSphere(u64 layer_mask, Vec3* translation, Vec3* rotation, Vec3* scale);
    [Virtual(10)] ColliderPlane* addColliderPlane(u64 layer_mask, Vec3* translation, Vec3* rotation, Vec3* scale);
    [Virtual(11)] ColliderPlane* addColliderPlaneTwoSided(u64 layer_mask, Vec3* translation, Vec3* rotation, Vec3* scale);
    [Virtual(12)] void removeCollider(Collider* collider);
    [Virtual(13)] void updateColliders();
    [Virtual(14)] bool raycast(RaycastHit* hit_info, u64 layer_mask, RaycastParams* args);
    [Virtual(15)] bool executeForEachIntersecting(void* visitor, u64 layer_mask, RaycastMaterialFilter* material_filter, Vec3* ray_origin, Vec3* ray_direction, f32 max_distance);
    [Virtual(16)] bool findContainingCollidersCheckLayer(SceneWrapper.ColliderList* result, u64 layer_mask, Vec3* pos);
    [Virtual(17)] bool findContainingColliders(SceneWrapper.ColliderList* result, Vec3* pos);
}

namespace ColliderStreamed {
    [Size(0x20)]
    struct Element {
        [0x0] i32 mesh_id;
        [0x8] ColliderMesh* mesh;
        [0x10] f32 min_x;
        [0x14] f32 min_z;
        [0x18] f32 max_x;
        [0x1C] f32 max_z;
    }

    [Size(0x20)]
    struct FileEntry {
        [0x0] i32 mesh_id;
        // y bounds are ignored when reading the file
        [0x4] Math.AABB bounds;
    }

    [Size(0x20)]
    struct FileHeader {
        [0x0] i32 num_meshes;
        [0x4] Math.AABB bounds;
    }
}

namespace Mesh {
    [Size(0xC)]
    struct Primitive {
        [0x0] u8 v1;
        [0x1] u8 v2;
        [0x2] u8 v3;
        [0x4] u64 material;
    }
}

namespace MeshPCB {
    [Size(0x10)]
    struct FileHeader {
        [0x4] i32 version;
        [0x8] i32 total_child_nodes;
        [0xC] i32 total_primitives;
    }

    [Size(0x30)]
    struct FileNode {
        [0x0] u64 header;
        [0x8] i32 child1_offset;
        [0xC] i32 child2_offset;
        [0x10] Math.AABB local_bounds;
        [0x28] u16 num_verts_compressed;
        [0x2A] u16 num_prims;
        [0x2C] u16 num_verts_raw;
    }
}

namespace SceneWrapper {
    [Size(0x84)]
    struct ColliderList {
        [0x0] Collider*[16] colliders;
        [0x80] i32 count;
    }
}
