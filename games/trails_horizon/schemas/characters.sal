// ed9::chara::Actor, any character on the field, party and NPCs and monsters alike.
struct Chara {
    [0x1A8]
    u32 chrid;

    [0x1E0]
    utf8[32] name;

    [0x2B8]
    ModelInstance* model;

    // Runs once the model's skeleton is animated, right before its model's modifiers.
    [Sig("48 83 EC 38 83 B9 ?? ?? ?? ?? 04 0F 29 74 24 ?? 0F 28 F1")]
    void onModelUpdate(f32 dt);
}

// fdk::ModelInstance
struct ModelInstance {
    [0x48]
    DagNode* root;

    // IK and the other bone controllers, then dynamic bones like ears, tails and hair. The models
    // attached to it, like accessories, are placed after this.
    [Sig("40 53 55 56 57 41 57 48 81 EC ?? ?? ?? ?? 48 8B 99 ?? ?? ?? ?? 49 8B E9")]
    void updateModifiers(f32 dt, usize context, ?f32* step);
}

// fdk::DAGNode, one per bone. A tree of first children and next siblings. The root's siblings are
// other things in the scene.
[Size(0x180)]
struct DagNode {
    [0x08]
    DagNode* parent;

    [0x10]
    DagNode* child;

    [0x18]
    DagNode* sibling;

    // In the world, row-vector style
    [0x68]
    Mat4 world;

    [0x138]
    utf8[64] name;

    // crc32 of the name
    [0x17C]
    u32 name_hash;
}

// A character's level, HP, EP and CP, in battle or in the save's roster.
[Size(0x4E4)]
struct Status {
    [0x0]
    u32 id;

    [0x4]
    u32 level;

    [0x8]
    u32 exp;

    [0xC]
    i32 hp;

    [0x10]
    i32 max_hp;

    [0x18]
    i32 ep;

    [0x1C]
    i32 max_ep;

    [0x20]
    i32 cp;

    [0x24]
    i32 max_cp;

    // 1 for the party
    [0x358]
    u32 side;

    // Changes a value by `kind`. 8 adds `value` to HP, kept within its limits.
    [Sig("E8 ?? ?? ?? ?? 44 8B C7 BA ?? ?? ?? ?? 48 8B CD", Rip)]
    void change(u32 kind, i32 value);
}

// An enemy on the field, which goes after the party once it notices them.
struct FieldSymbol {
    [0x4708]
    SymbolSense[4] senses;

    // Which of `senses` is in use
    [0x473C]
    i32 sense;

    // Each frame. Notices the party at the end, if they're close enough.
    [Sig("40 53 48 83 EC ?? 48 8B D9 48 8B 49 ?? E8 ?? ?? ?? ?? 84 C0 0F 84")]
    void update();
}

struct SymbolSense {
    u32 kind;
    // 2 once it's noticed the party
    u32 state;
    u32 extra;
}
